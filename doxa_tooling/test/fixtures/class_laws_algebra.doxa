// Consumer of the stdlib algebra module, checked through the CLI. The
// module itself holds the classes, the instances, and their law fields;
// this file exercises the imported instances and the generic folds.
import "../../../doxa_stdlib/lib/stdlib/algebra.doxa"

val two : Nat = sum Nat (cons (succ zero) (cons (succ zero) nil))
val two_eq : Eq Nat two (succ (succ zero)) = refl two
val viaComm : Nat = sumViaComm Nat (cons (succ zero) (cons (succ zero) nil))
val viaComm_eq : Eq Nat viaComm (succ (succ zero)) = refl viaComm
