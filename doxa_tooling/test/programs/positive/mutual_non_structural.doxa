// Accepted: in a mutual block, `isEven` calls `isOdd n` passing the
// original `n` (unguarded), but `isOdd` calls `isEven m` passing the
// sub-term `m` (guarded). The cycle has a guarded edge, so the block
// is structurally sound under SPEC §8.6 cycle-aware analysis.
data Nat : Type {
  zero : Nat;
  succ : Nat -> Nat;
}

data Bool : Type {
  t_ : Bool;
  f_ : Bool;
}

fun isEven(n: Nat) : Bool = match n {
  case zero => t_
  case succ m => isOdd n
}and isOdd(n: Nat) : Bool = match n {
  case zero => f_
  case succ m => isEven m
}
