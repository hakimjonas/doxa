// Substitution with a motive `P : Nat -> Type` whose body references the
// quantified variable: subst's large-elim machinery must substitute
// correctly through a bound variable.
data Nat: Type {
  zero: Nat;
  succ: Nat -> Nat;
}

data Vec[A: Type]: Nat -> Type {
  vnil: Vec A zero;
  vcons: (n: Nat) -> A -> Vec A n -> Vec A (succ n);
}

val subst: (A: Type) -> (P: A -> Type) -> (x: A) -> (y: A) -> Eq A x y -> P x -> P y = (A: Type) => (P: A -> Type) => (x: A) => (y: A) => (p: Eq A x y) => (px: P x) => Eq.rect A ((a: A) => (b: A) => (_: Eq A a b) => P a -> P b) x y ((z: A) => (pz: P z) => pz) p px
// The motive is a dependently-typed function: Vec indexed by its length.

val P: Nat -> Type = (n: Nat) => Vec Nat n
// Transport a Vec[Nat] zero across Eq[Nat] zero zero. Result remains
// Vec[Nat] zero (the motive has the same shape at zero and zero).

val v_zero: Vec Nat zero = vnil

val transported: Vec Nat zero = subst Nat P zero zero (refl zero) v_zero
