// Regression: a theorem about an indexed family (Vec) whose Vec.ind motive
// binds the index and scrutinee and applies an implicit-argument function
// (`length`) to the scrutinee, exercising the two-binder motive path where
// the motive applied to a constructor is a delayed redex re-applied to the
// scrutinee.
data Nat: Type {
  zero: Nat;
  succ: Nat -> Nat;
}

data Vec[A: Type]: Nat -> Type {
  vnil: Vec A zero;
  vcons: (n: Nat) -> A -> Vec A n -> Vec A (succ n);
}

fun cong{A: Type, B: Type, x: A, y: A}(f: A -> B, p: Eq A x y): Eq B (f x) (f y) = match p {
  case refl a => refl (f a)
}

fun length{A: Type, n: Nat}(v: Vec A n): Nat = match v {
  case vnil => zero
  case vcons k x rest => succ (length rest)
}// `length v` equals the Vec's length index `n`, proven by induction.

val vlen: (A: Type) -> (n: Nat) -> (v: Vec A n) -> Eq Nat (length v) n = (A: Type) => (n: Nat) => (v: Vec A n) => Vec.ind A ((m: Nat) => (w: Vec A m) => Eq Nat (length w) m) n (refl zero) ((k: Nat) => (x: A) => (rest: Vec A k) => (ih: Eq Nat (length rest) k) => cong ((j: Nat) => succ j) ih) v
