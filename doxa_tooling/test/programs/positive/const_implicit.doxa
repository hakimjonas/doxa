// `const{A, B}(x, y) = x` with two implicit type parameters, both solved by
// pattern unification against the explicit argument types at the call site.

data Nat : Type {
  zero : Nat;
  succ : Nat -> Nat;
}

data Bool : Type {
  t_ : Bool;
  f_ : Bool;
}

fun const_{A: Type, B: Type}(x: A, y: B): A = x

val n : Nat = const_ zero t_
