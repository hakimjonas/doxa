// Induction-style proof that addition on Nat commutes, composing the derived
// equality lemmas (sym, trans, cong) and the helper lemmas plusZero and
// plusSucc via Nat.ind.
data Nat: Type {
  zero: Nat;
  succ: Nat -> Nat;
}

fun plus(m: Nat, n: Nat): Nat = match m {
  case zero => n
  case succ m_ => succ (m_ + n)
}

val sym: (A: Type) -> (x: A) -> (y: A) -> Eq A x y -> Eq A y x =
  (A: Type) => (x: A) => (y: A) => (p: Eq A x y) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq A b a)
    x
    y
    ((z: A) => refl z)
    p

val trans: (A: Type) -> (x: A) -> (y: A) -> (z: A) -> Eq A x y -> Eq A y z -> Eq A x z =
  (A: Type) => (x: A) => (y: A) => (z: A) => (p: Eq A x y) => (q: Eq A y z) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq A b z -> Eq A a z)
    x
    y
    ((w: A) => (r: Eq A w z) => r)
    p
    q

val cong: (A: Type) -> (B: Type) -> (f: A -> B) -> (x: A) -> (y: A) -> Eq A x y -> Eq B (f x) (f y) =
  (A: Type) => (B: Type) => (f: A -> B) => (x: A) => (y: A) => (p: Eq A x y) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq B (f a) (f b))
    x
    y
    ((z: A) => refl (f z))
    p
// Base lemmas for plusComm.

val plusZero: (n: Nat) -> Eq Nat (n + zero) n =
  Nat.ind
    ((k: Nat) => Eq Nat (k + zero) k)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (m + zero) m) => cong Nat Nat ((k: Nat) => succ k) (m + zero) m ih)

val plusSucc: (m: Nat) -> (n: Nat) -> Eq Nat (m + succ n) (succ (m + n)) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k + succ n) (succ (k + n)))
    ((n: Nat) => refl (succ n))
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k + succ n) (succ (k + n))) => (n: Nat) => cong
      Nat
      Nat
      ((x: Nat) => succ x)
      (k + succ n)
      (succ (k + n))
      (ih n))
    m
// The capstone.

val plusComm: (m: Nat) -> (n: Nat) -> Eq Nat (m + n) (n + m) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k + n) (n + k))
    ((n: Nat) => sym Nat (n + zero) n (plusZero n))
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k + n) (n + k)) => (n: Nat) => trans
      Nat
      (succ (k + n))
      (succ (n + k))
      (n + succ k)
      (cong Nat Nat ((x: Nat) => succ x) (k + n) (n + k) (ih n))
      (sym Nat (n + succ k) (succ (n + k)) (plusSucc n k)))
    m
// Smoke check: instantiate plusComm at concrete Nats.

val two: Nat = succ (succ zero)

val three: Nat = succ two

val witness: Eq Nat (two + three) (three + two) = plusComm two three
