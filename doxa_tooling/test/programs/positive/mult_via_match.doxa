// `multiply` on Nat defined structurally via `match` + self-recursion on m
// (the match-based counterpart to nat_mult.doxa's Nat.rec version).
data Nat: Type {
  zero: Nat;
  succ: Nat -> Nat;
}

fun plus(m: Nat, n: Nat): Nat = match m {
  case zero => n
  case succ m_ => succ (m_ + n)
}

fun multiply(m: Nat, n: Nat): Nat = match m {
  case zero => zero
  case succ m_ => n + m_ * n
}

val two: Nat = succ (succ zero)

val six: Nat = two * succ two
