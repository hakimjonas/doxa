// `mult` on Nat defined structurally via `match` + self-recursion on m
// (the match-based counterpart to nat_mult.doxa's Nat.rec version).

data Nat : Type {
  zero : Nat;
  succ : Nat -> Nat;
}

fun plus(m: Nat, n: Nat): Nat = match m {
  case zero => n
  case succ m_ => succ (plus m_ n)
}

fun mult(m: Nat, n: Nat): Nat = match m {
  case zero => zero
  case succ m_ => plus n (mult m_ n)
}

val two : Nat = succ (succ zero)
val six : Nat = mult two (succ two)
