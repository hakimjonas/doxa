// Indexed inductive whose constructor result index is a computed
// expression headed by a top-level binding. Matching on it must
// resolve `plus` through the top-level registry while refining the
// arm's expected type; recursing on it must synthesize a usable type.
data Nat: Type {
  zero: Nat;
  succ: Nat -> Nat;
}

fun plus(m: Nat, n: Nat): Nat = match m {
  case zero => n
  case succ m_ => succ (plus m_ n)
}

data Vec[A: Type]: Nat -> Type {
  vnil: Vec A zero;
  vcons: (n: Nat) -> A -> Vec A n -> Vec A (succ n);
}

fun vecOf(n: Nat): Vec Nat n = match n {
  case zero => vnil
  case succ k => vcons k zero (vecOf k)
}

fun vappend{A: Type, n: Nat, m: Nat}(xs: Vec A n, ys: Vec A m): Vec A (plus n m) = match xs {
  case vnil => ys
  case vcons k x rest => vcons (plus k m) x (vappend rest ys)
}

data D: Nat -> Type {
  pack: (n: Nat) -> (m: Nat) -> D (plus n m);
}
// The pack arm's expected type must refine `n` to `plus a b`, or the
// body's `Vec Nat (plus a b)` cannot check against `Vec Nat n`.

fun dToVec(n: Nat, d: D n): Vec Nat n = match d {
  case pack a b => vappend (vecOf a) (vecOf b)
}
// Explicit recursor application: the synthesized type must be usable,
// and ι must reduce through the computed index.

val d1: D (plus zero (succ zero)) = pack zero (succ zero)

val first: Nat =
  D.rec ((k: Nat) => (d: D k) => Nat) (plus zero (succ zero)) ((a: Nat) => (b: Nat) => a) d1

val firstIsZero: Eq Nat first zero = refl
