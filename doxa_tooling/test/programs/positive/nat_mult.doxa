// `multiply` on native Nat through nested Nat.rec calls: multiply recurses on m,
// the zero case returns zero and the succ case returns `plus n (multiply m_ n)`.
data Nat: Type {
  zero: Nat;
  succ: Nat -> Nat;
}

val plus: Nat -> Nat -> Nat =
  (m: Nat) => (n: Nat) => Nat.rec ((_: Nat) => Nat) n ((_: Nat) => (rec: Nat) => succ rec) m

val multiply: Nat -> Nat -> Nat =
  (m: Nat) => (n: Nat) => Nat.rec ((_: Nat) => Nat) zero ((_: Nat) => (rec: Nat) => n + rec) m

val two: Nat = succ (succ zero)

val four: Nat = two * two

val six: Nat = two * succ two
