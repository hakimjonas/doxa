// Regression: a `match` inside a lambda passed as a method to Nat.rec. Under
// rec reduction the match must reduce normally when its IH is a canonical
// VConstr.
data Nat: Type {
  zero: Nat;
  succ: Nat -> Nat;
}

data Bool: Type {
  t_: Bool;
  f_: Bool;
}
// `toggle n = if n is zero then t_ else flip(toggle n.pred)`, expressed
// via Nat.rec whose step method pattern-matches on the IH.

val toggle: (n: Nat) -> Bool = Nat.rec ((_: Nat) => Bool) t_ ((n: Nat) => (ih: Bool) => match ih {
  case t_ => f_
  case f_ => t_
})

val two: Nat = succ (succ zero)

val three: Nat = succ two

val a: Bool = toggle zero // t_

val b: Bool = toggle two // t_

val c: Bool = toggle three // f_
