// A small proof that imports the packaged standard library by package URI.
// Fetch the package configuration once with `dart pub get` in doxa_stdlib/,
// then check it from the repository root with:
//   dart run doxa_tooling/bin/doxa.dart check doxa_stdlib/example/proofs.doxa
import "package:doxa_stdlib/stdlib/nat.doxa"

import "package:doxa_stdlib/stdlib/proofs.doxa"

val two: Nat = succ (succ zero)
// `plus_zero` states `plus n zero = n`, so its instantiation at `two` is the
// whole proof.

val two_plus_zero: Eq Nat (plus two zero) two = plus_zero two
