// Canonical proofs exercising the kernel end-to-end. This file holds
// the full proof roster and type-checks completely, including the four
// list-domain lemmas `append_nil`, `append_assoc`, `length_append`, and
// `map_compose` (the last closed by guarded delta-reduction), and the
// refutation lemmas `succ_ne_zero` and `true_ne_false` that derive
// `False` from impossible equalities.
//
// Styles in this file:
//
//  - Implicit style (`fun sym/trans/cong`): call sites omit type
//    parameters; pattern unification solves them against the
//    explicit proof argument's inferred type.
//
// Shared modules are imported instead of redeclared.
import "bool.doxa"

import "eq.doxa"

import "list.doxa"

import "nat.doxa"

import "vec.doxa"
// --- Derived Eq lemmas (explicit style) ------------------------------------
//
// Explicit-style sym/trans/cong for proofs whose composition
// crosses a call-site where pattern unification over the
// implicit-style variant currently fails to converge. These are
// definitionally equal to the implicit versions, they just pass
// types positionally.

val sym_e: (A: Type) -> (x: A) -> (y: A) -> Eq A x y -> Eq A y x =
  (A: Type) => (x: A) => (y: A) => (p: Eq A x y) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq A b a)
    x
    y
    ((z: A) => refl z)
    p

val trans_e: (A: Type) -> (x: A) -> (y: A) -> (z: A) -> Eq A x y -> Eq A y z -> Eq A x z =
  (A: Type) => (x: A) => (y: A) => (z: A) => (p: Eq A x y) => (q: Eq A y z) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq A b z -> Eq A a z)
    x
    y
    ((w: A) => (r: Eq A w z) => r)
    p
    q

val cong_e: (A: Type)
-> (B: Type) -> (f: A -> B) -> (x: A) -> (y: A) -> Eq A x y -> Eq B (f x) (f y) =
  (A: Type) => (B: Type) => (f: A -> B) => (x: A) => (y: A) => (p: Eq A x y) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq B (f a) (f b))
    x
    y
    ((z: A) => refl (f z))
    p
// --- Nat-domain proofs (implicit style) -----------------------------------
//
// These proofs compose `cong`/`trans`/`sym` in implicit style.
// The composition pattern here is `cong succ ih`, wrapping a
// hypothesis about `plus m zero ≡ m` into one about `succ (plus m
// zero) ≡ succ m`. This relies on the conversion check normalizing
// the two sides of a VMatch under env-relative coordinates: both
// carry the same source match, one captured under a β-reduced env
// and one not, and they must still be recognised as equal.

val plus_zero: (n: Nat) -> Eq Nat (n + zero) n =
  Nat.ind
    ((k: Nat) => Eq Nat (k + zero) k)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (m + zero) m) => cong ((k: Nat) => succ k) ih)

val plus_succ: (m: Nat) -> (n: Nat) -> Eq Nat (m + succ n) (succ (m + n)) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k + succ n) (succ (k + n)))
    ((n: Nat) => refl (succ n))
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k + succ n) (succ (k + n))) => (n: Nat) => cong
      ((x: Nat) => succ x)
      (ih n))
    m

val plus_comm: (m: Nat) -> (n: Nat) -> Eq Nat (m + n) (n + m) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k + n) (n + k))
    ((n: Nat) => sym_e Nat (n + zero) n (plus_zero n))
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k + n) (n + k)) => (n: Nat) => trans_e
      Nat
      (succ (k + n))
      (succ (n + k))
      (n + succ k)
      (cong_e Nat Nat ((x: Nat) => succ x) (k + n) (n + k) (ih n))
      (sym_e Nat (n + succ k) (succ (n + k)) (plus_succ n k)))
    m

val mult_zero: (n: Nat) -> Eq Nat (n * zero) zero =
  Nat.ind
    ((k: Nat) => Eq Nat (k * zero) zero)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (m * zero) zero) => ih)

val mult_one: (n: Nat) -> Eq Nat (n * succ zero) n =
  Nat.ind
    ((k: Nat) => Eq Nat (k * succ zero) k)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (m * succ zero) m) => cong ((k: Nat) => succ k) ih)

val plus_assoc: (m: Nat) -> (n: Nat) -> (p: Nat) -> Eq Nat (m + n + p) (m + (n + p)) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> (p: Nat) -> Eq Nat (k + n + p) (k + (n + p)))
    ((n: Nat) => (p: Nat) => refl (n + p))
    ((k: Nat) => (ih: (n: Nat) -> (p: Nat) -> Eq Nat (k + n + p) (k + (n + p))) => (n: Nat) => (p: Nat) => cong
      ((x: Nat) => succ x)
      (ih n p))
    m

val mult_succ_right: (m: Nat) -> (n: Nat) -> Eq Nat (m * succ n) (m + m * n) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k * succ n) (k + k * n))
    ((n: Nat) => refl zero)
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k * succ n) (k + k * n)) => (n: Nat) => trans_e
      Nat
      (succ k * succ n)
      (succ n + (k + k * n))
      (succ k + (n + k * n))
      (trans_e
        Nat
        (succ k * succ n)
        (succ n + k * succ n)
        (succ n + (k + k * n))
        (refl (succ n + k * succ n))
        (cong ((w: Nat) => succ n + w) (ih n)))
      (trans_e
        Nat
        (succ n + (k + k * n))
        (succ (n + k) + k * n)
        (succ k + (n + k * n))
        (trans_e
          Nat
          (succ n + (k + k * n))
          (succ n + k + k * n)
          (succ (n + k) + k * n)
          (sym_e Nat (succ n + k + k * n) (succ n + (k + k * n)) (plus_assoc (succ n) k (k * n)))
          (refl (succ (n + k) + k * n)))
        (trans_e
          Nat
          (succ (n + k) + k * n)
          (succ (k + n) + k * n)
          (succ k + (n + k * n))
          (cong_e
            Nat
            Nat
            ((z: Nat) => z + k * n)
            (succ (n + k))
            (succ (k + n))
            (cong ((x: Nat) => succ x) (plus_comm n k)))
          (trans_e
            Nat
            (succ (k + n) + k * n)
            (succ k + n + k * n)
            (succ k + (n + k * n))
            (refl (succ k + n + k * n))
            (plus_assoc (succ k) n (k * n))))))
    m

val mult_comm: (m: Nat) -> (n: Nat) -> Eq Nat (m * n) (n * m) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k * n) (n * k))
    ((n: Nat) => sym_e Nat (n * zero) zero (mult_zero n))
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k * n) (n * k)) => (n: Nat) => trans_e
      Nat
      (succ k * n)
      (n + k * n)
      (n * succ k)
      (refl (n + k * n))
      (trans_e
        Nat
        (n + k * n)
        (n + n * k)
        (n * succ k)
        (cong_e Nat Nat ((z: Nat) => n + z) (k * n) (n * k) (ih n))
        (sym_e Nat (n * succ k) (n + n * k) (mult_succ_right n k))))
    m

val mult_2: (n: Nat) -> Eq Nat (succ (succ zero) * n) (n + n) =
  (n: Nat) => trans_e
    Nat
    (succ (succ zero) * n)
    (n + succ zero * n)
    (n + n)
    (refl (n + succ zero * n))
    (cong
      ((z: Nat) => n + z)
      (trans_e Nat (succ zero * n) (n * succ zero) n (mult_comm (succ zero) n) (mult_one n)))

val mult_plus: (a: Nat) -> (b: Nat) -> (c: Nat) -> Eq Nat ((a + b) * c) (a * c + b * c) =
  (a: Nat) => Nat.ind
    ((k: Nat) => (b: Nat) -> (c: Nat) -> Eq Nat ((k + b) * c) (k * c + b * c))
    ((b: Nat) => (c: Nat) => refl (b * c))
    ((k: Nat) => (ih: (b: Nat) -> (c: Nat) -> Eq Nat ((k + b) * c) (k * c + b * c)) => (b: Nat) => (c: Nat) => trans_e
      Nat
      ((succ k + b) * c)
      (c + (k + b) * c)
      (succ k * c + b * c)
      (refl (c + (k + b) * c))
      (trans_e
        Nat
        (c + (k + b) * c)
        (c + (k * c + b * c))
        (succ k * c + b * c)
        (cong_e Nat Nat ((x: Nat) => c + x) ((k + b) * c) (k * c + b * c) (ih b c))
        (trans_e
          Nat
          (c + (k * c + b * c))
          (c + k * c + b * c)
          (succ k * c + b * c)
          (sym_e Nat (c + k * c + b * c) (c + (k * c + b * c)) (plus_assoc c (k * c) (b * c)))
          (refl (c + k * c + b * c)))))
    a

val mult_assoc: (m: Nat) -> (n: Nat) -> (p: Nat) -> Eq Nat (m * n * p) (m * (n * p)) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> (p: Nat) -> Eq Nat (k * n * p) (k * (n * p)))
    ((n: Nat) => (p: Nat) => refl zero)
    ((k: Nat) => (ih: (n: Nat) -> (p: Nat) -> Eq Nat (k * n * p) (k * (n * p))) => (n: Nat) => (p: Nat) => trans_e
      Nat
      (succ k * n * p)
      (n * p + k * n * p)
      (succ k * (n * p))
      (trans_e
        Nat
        (succ k * n * p)
        ((n + k * n) * p)
        (n * p + k * n * p)
        (refl ((n + k * n) * p))
        (mult_plus n (k * n) p))
      (trans_e
        Nat
        (n * p + k * n * p)
        (n * p + k * (n * p))
        (succ k * (n * p))
        (cong_e Nat Nat ((x: Nat) => n * p + x) (k * n * p) (k * (n * p)) (ih n p))
        (refl (n * p + k * (n * p)))))
    m
// --- Nat subtraction and zero-divisor lemmas ------------------------------
//
// The division and modulo functions are specified in `docs/arithmetic.md`.
// `div m zero` and `mod m zero` are the two zero-divisor conventions; both
// `mod_lt` and `div_add_mod` are proved below.

val sub_zero: (m: Nat) -> Eq Nat (sub m zero) m =
  Nat.ind
    ((k: Nat) => Eq Nat (sub k zero) k)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (sub m zero) m) => refl (succ m))

val mod_acc_zero: (k: Nat) -> (m: Nat) -> Eq Nat (mod_acc k m zero) m =
  Nat.ind
    ((k: Nat) => (m: Nat) -> Eq Nat (mod_acc k m zero) m)
    ((m: Nat) => refl m)
    ((k: Nat) => (ih: (m: Nat) -> Eq Nat (mod_acc k m zero) m) => (m: Nat) => trans_e
      Nat
      (mod_acc k (sub m zero) zero)
      (sub m zero)
      m
      (ih (sub m zero))
      (sub_zero m))

val mod_zero: (m: Nat) -> Eq Nat (mod m zero) m = (m: Nat) => mod_acc_zero m m

val div_zero: (m: Nat) -> Eq Nat (div m zero) zero = (m: Nat) => refl zero
// --- List-domain proofs ---------------------------------------------------
//
// Parametric-type variants of the Nat-domain proofs above, in natural
// implicit style. `append_nil`, `append_assoc`, and `length_append`
// type-check via scope-aware TMeta-spine handling; `map_compose` (below)
// additionally needs guarded delta-reduction.

val append_nil: (A: Type) -> (xs: List A) -> Eq (List A) (append xs nil) xs =
  (A: Type) => List.ind
    A
    ((ys: List A) => Eq (List A) (append ys nil) ys)
    (refl nil)
    ((h: A) => (t: List A) => (ih: Eq (List A) (append t nil) t) => cong_e
      (List A)
      (List A)
      ((ts: List A) => cons h ts)
      (append t nil)
      t
      ih)

val append_assoc: (A: Type)
-> (xs: List A)
  -> (ys: List A)
    -> (zs: List A) -> Eq (List A) (append (append xs ys) zs) (append xs (append ys zs)) =
  (A: Type) => List.ind
    A
    ((xs: List A) => (ys: List A)
    -> (zs: List A) -> Eq (List A) (append (append xs ys) zs) (append xs (append ys zs)))
    ((ys: List A) => (zs: List A) => refl (append ys zs))
    ((h: A) => (t: List A) => (ih: (ys: List A)
    -> (zs: List A) -> Eq (List A) (append (append t ys) zs) (append t (append ys zs))) => (ys: List
      A) => (zs: List A) => cong_e
      (List A)
      (List A)
      ((ts: List A) => cons h ts)
      (append (append t ys) zs)
      (append t (append ys zs))
      (ih ys zs))
// The double-`map` nesting in the statement exercises guarded
// delta-reduction (SPEC §8.6 fix-reduction): a recursive `fun` stays
// folded while its decreasing argument is a neutral, so `map t f`
// remains a depth-portable `TTop(map)` application rather than a
// stuck value frozen at one depth and re-evaluated at another.

val map_compose: (A: Type)
-> (B: Type)
  -> (C: Type)
    -> (f: A -> B)
      -> (g: B -> C) -> (xs: List A) -> Eq (List C) (map (map xs f) g) (map xs ((a: A) => g (f a))) =
  (A: Type) => (B: Type) => (C: Type) => (f: A -> B) => (g: B -> C) => List.ind
    A
    ((xs: List A) => Eq (List C) (map (map xs f) g) (map xs ((a: A) => g (f a))))
    (refl nil)
    ((h: A) => (t: List A) => (ih: Eq (List C) (map (map t f) g) (map t ((a: A) => g (f a)))) => cong_e
      (List C)
      (List C)
      ((ts: List C) => cons (g (f h)) ts)
      (map (map t f) g)
      (map t ((a: A) => g (f a)))
      ih)

val length_append: (A: Type)
-> (xs: List A) -> (ys: List A) -> Eq Nat (length (append xs ys)) (length xs + length ys) =
  (A: Type) => List.ind
    A
    ((xs: List A) => (ys: List A) -> Eq Nat (length (append xs ys)) (length xs + length ys))
    ((ys: List A) => refl (length ys))
    ((h: A) => (t: List A) => (ih: (ys: List A)
    -> Eq Nat (length (append t ys)) (length t + length ys)) => (ys: List A) => cong_e
      Nat
      Nat
      ((k: Nat) => succ k)
      (length (append t ys))
      (length t + length ys)
      (ih ys))
// --- Refutation: distinct constructors are not equal --------------------
//
// These prove negations, not equations: from an impossible equality we
// derive `False` (the empty type), so the logic can refute, not only
// rewrite. The technique is the standard "discriminator predicate": a
// Prop-valued function that is provable at one constructor and `False`
// at the other. Transporting the provable case across the bogus equality
// (via Eq.rec) lands in `False`.

data False: Prop {

}

fun isZero(n: Nat): Prop = match n {
  case zero => Eq Nat zero zero
  case succ k => False
}

fun isTrue(b: Bool): Prop = match b {
  case true_ => Eq Bool true_ true_
  case false_ => False
}

val succ_ne_zero: (n: Nat) -> Eq Nat (succ n) zero -> False =
  (n: Nat) => (p: Eq Nat (succ n) zero) => Eq.rec
    Nat
    ((a: Nat) => (b: Nat) => (_: Eq Nat a b) => isZero b -> isZero a)
    (succ n)
    zero
    ((z: Nat) => (h: isZero z) => h)
    p
    (refl zero)

val true_ne_false: Eq Bool true_ false_ -> False =
  (p: Eq Bool true_ false_) => Eq.rec
    Bool
    ((a: Bool) => (b: Bool) => (_: Eq Bool a b) => isTrue a -> isTrue b)
    true_
    false_
    ((z: Bool) => (h: isTrue z) => h)
    p
    (refl true_)
// --- Nat order and subtraction lemmas -------------------------------------

val leq_refl: (n: Nat) -> Eq Bool (n <= n) true_ =
  (n: Nat) => Nat.ind
    ((k: Nat) => Eq Bool (k <= k) true_)
    refl
    ((k: Nat) => (ih: Eq Bool (k <= k) true_) => ih)
    n

val lt_zero_succ: (n: Nat) -> Lt zero (succ n) =
  (n: Nat) => Nat.ind
    ((k: Nat) => Lt zero (succ k))
    (lt_succ zero)
    ((k: Nat) => (ih: Lt zero (succ k)) => lt_trans
      zero
      (succ k)
      (succ (succ k))
      ih
      (lt_succ (succ k)))
    n

fun lt_succ_mono(a: Nat, b: Nat, h: Lt a b): Lt (succ a) (succ b) {struct h} = match h {
  case lt_succ n => lt_succ (succ n)
  case lt_trans n m k h1 h2 => lt_trans
    (succ n)
    (succ m)
    (succ k)
    (lt_succ_mono n m h1)
    (lt_succ_mono m k h2)
}

val leq_succ_right: (a: Nat) -> (b: Nat) -> Eq Bool (a <= b) true_ -> Eq Bool (a <= succ b) true_ =
  (a: Nat) => (b: Nat) => (h: Eq Bool (a <= b) true_) => Nat.ind
    ((k: Nat) => (j: Nat) -> Eq Bool (j <= k) true_ -> Eq Bool (j <= succ k) true_)
    ((j: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= zero) true_ -> Eq Bool (i <= succ zero) true_)
      ((h0: Eq Bool (zero <= zero) true_) => refl)
      ((i: Nat) => (ih: Eq Bool (i <= zero) true_ -> Eq Bool (i <= succ zero) true_) => (h1: Eq
        Bool
        (succ i <= zero)
        true_) => False.rec
        ((_: False) => Eq Bool (succ i <= succ zero) true_)
        (true_ne_false (sym_e Bool false_ true_ h1)))
      j)
    ((k: Nat) => (ih: (j: Nat) -> Eq Bool (j <= k) true_ -> Eq Bool (j <= succ k) true_) => (j: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= succ k) true_ -> Eq Bool (i <= succ (succ k)) true_)
      ((h0: Eq Bool (zero <= succ k) true_) => refl)
      ((i: Nat) => (ihi: Eq Bool (i <= succ k) true_ -> Eq Bool (i <= succ (succ k)) true_) => (h1: Eq
        Bool
        (succ i <= succ k)
        true_) => ih i h1)
      j)
    b
    a
    h

val leq_trans: (a: Nat)
-> (b: Nat)
  -> (c: Nat) -> Eq Bool (a <= b) true_ -> Eq Bool (b <= c) true_ -> Eq Bool (a <= c) true_ =
  (a: Nat) => (b: Nat) => (c: Nat) => (h1: Eq Bool (a <= b) true_) => (h2: Eq Bool (b <= c) true_) => Nat.ind
    ((k: Nat) => (p: Nat)
    -> (q: Nat) -> Eq Bool (k <= p) true_ -> Eq Bool (p <= q) true_ -> Eq Bool (k <= q) true_)
    ((p: Nat) => (q: Nat) => (g1: Eq Bool (zero <= p) true_) => (g2: Eq Bool (p <= q) true_) => refl)
    ((k: Nat) => (ih: (p: Nat)
    -> (q: Nat) -> Eq Bool (k <= p) true_ -> Eq Bool (p <= q) true_ -> Eq Bool (k <= q) true_) => (p: Nat) => (q: Nat) => (g1: Eq
      Bool
      (succ k <= p)
      true_) => (g2: Eq Bool (p <= q) true_) => Nat.ind
      ((r: Nat) => Eq Bool (succ k <= r) true_
      -> Eq Bool (r <= q) true_ -> Eq Bool (succ k <= q) true_)
      ((i0: Eq Bool (succ k <= zero) true_) => (j0: Eq Bool (zero <= q) true_) => False.rec
        ((_: False) => Eq Bool (succ k <= q) true_)
        (true_ne_false (sym_e Bool false_ true_ i0)))
      ((r: Nat) => (ihr: Eq Bool (succ k <= r) true_
      -> Eq Bool (r <= q) true_ -> Eq Bool (succ k <= q) true_) => (i1: Eq
        Bool
        (succ k <= succ r)
        true_) => (j1: Eq Bool (succ r <= q) true_) => Nat.ind
        ((s: Nat) => Eq Bool (succ r <= s) true_ -> Eq Bool (succ k <= s) true_)
        ((i2: Eq Bool (succ r <= zero) true_) => False.rec
          ((_: False) => Eq Bool (succ k <= zero) true_)
          (true_ne_false (sym_e Bool false_ true_ i2)))
        ((s: Nat) => (ihs: Eq Bool (succ r <= s) true_ -> Eq Bool (succ k <= s) true_) => (i2: Eq
          Bool
          (succ r <= succ s)
          true_) => ih r s i1 i2)
        q
        j1)
      p
      g1
      g2)
    a
    b
    c
    h1
    h2

val leq_sub: (m: Nat) -> (n: Nat) -> Eq Bool (sub m n <= m) true_ =
  (m: Nat) => Nat.ind
    ((j: Nat) => (n: Nat) -> Eq Bool (sub j n <= j) true_)
    ((n: Nat) => refl)
    ((j: Nat) => (ih: (n: Nat) -> Eq Bool (sub j n <= j) true_) => (n: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (sub (succ j) i <= succ j) true_)
      (leq_refl (succ j))
      ((i: Nat) => (ihi: Eq Bool (sub (succ j) i <= succ j) true_) => leq_succ_right
        (sub j i)
        j
        (ih i))
      n)
    m

val lt_of_leq: (m: Nat) -> (n: Nat) -> Eq Bool (m <= n) true_ -> Lt m (succ n) =
  (m: Nat) => (n: Nat) => (h: Eq Bool (m <= n) true_) => Nat.ind
    ((k: Nat) => (j: Nat) -> Eq Bool (j <= k) true_ -> Lt j (succ k))
    ((j: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= zero) true_ -> Lt i (succ zero))
      ((h0: Eq Bool (zero <= zero) true_) => lt_succ zero)
      ((i: Nat) => (ih: Eq Bool (i <= zero) true_ -> Lt i (succ zero)) => (h1: Eq
        Bool
        (succ i <= zero)
        true_) => False.rec
        ((_: False) => Lt (succ i) (succ zero))
        (true_ne_false (sym_e Bool false_ true_ h1)))
      j)
    ((k: Nat) => (ih: (j: Nat) -> Eq Bool (j <= k) true_ -> Lt j (succ k)) => (j: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= succ k) true_ -> Lt i (succ (succ k)))
      ((h0: Eq Bool (zero <= succ k) true_) => lt_zero_succ (succ k))
      ((i: Nat) => (ihi: Eq Bool (i <= succ k) true_ -> Lt i (succ (succ k))) => (h1: Eq
        Bool
        (succ i <= succ k)
        true_) => lt_succ_mono i (succ k) (ih i h1))
      j)
    n
    m
    h

val lt_true_Lt: (m: Nat) -> (n: Nat) -> Eq Bool (lt m n) true_ -> Lt m n =
  (m: Nat) => (n: Nat) => (h: Eq Bool (lt m n) true_) => Nat.ind
    ((k: Nat) => Eq Bool (lt m k) true_ -> Lt m k)
    ((h0: Eq Bool (lt m zero) true_) => False.rec
      ((_: False) => Lt m zero)
      (true_ne_false (sym_e Bool false_ true_ h0)))
    ((k: Nat) => (ih: Eq Bool (lt m k) true_ -> Lt m k) => (h0: Eq Bool (lt m (succ k)) true_) => lt_of_leq
      m
      k
      h0)
    n
    h

val leq_succ_true: (m: Nat) -> (k: Nat) -> Eq Bool (m <= k) false_ -> Eq Bool (succ k <= m) true_ =
  (m: Nat) => Nat.ind
    ((j: Nat) => (k: Nat) -> Eq Bool (j <= k) false_ -> Eq Bool (succ k <= j) true_)
    ((k: Nat) => (h: Eq Bool (zero <= k) false_) => False.rec
      ((_: False) => Eq Bool (succ k <= zero) true_)
      (true_ne_false h))
    ((j: Nat) => (ih: (k: Nat) -> Eq Bool (j <= k) false_ -> Eq Bool (succ k <= j) true_) => (k: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (succ j <= i) false_ -> Eq Bool (succ i <= succ j) true_)
      ((h: Eq Bool (succ j <= zero) false_) => refl)
      ((i: Nat) => (ihi: Eq Bool (succ j <= i) false_ -> Eq Bool (succ i <= succ j) true_) => (h: Eq
        Bool
        (succ j <= succ i)
        false_) => ih i h)
      k)
    m

val lt_false_leq: (m: Nat) -> (n: Nat) -> Eq Bool (lt m n) false_ -> Eq Bool (n <= m) true_ =
  (m: Nat) => (n: Nat) => (h: Eq Bool (lt m n) false_) => Nat.ind
    ((k: Nat) => Eq Bool (lt m k) false_ -> Eq Bool (k <= m) true_)
    ((h0: Eq Bool (lt m zero) false_) => refl)
    ((k: Nat) => (ih: Eq Bool (lt m k) false_ -> Eq Bool (k <= m) true_) => (h0: Eq
      Bool
      (m <= k)
      false_) => leq_succ_true m k h0)
    n
    h

val sub_add: (m: Nat) -> (n: Nat) -> Eq Bool (n <= m) true_ -> Eq Nat (sub m n + n) m =
  (m: Nat) => Nat.ind
    ((j: Nat) => (n: Nat) -> Eq Bool (n <= j) true_ -> Eq Nat (sub j n + n) j)
    ((n: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= zero) true_ -> Eq Nat (sub zero i + i) zero)
      ((h: Eq Bool (zero <= zero) true_) => refl)
      ((i: Nat) => (ihi: Eq Bool (i <= zero) true_ -> Eq Nat (sub zero i + i) zero) => (h: Eq
        Bool
        (succ i <= zero)
        true_) => False.rec
        ((_: False) => Eq Nat (sub zero (succ i) + succ i) zero)
        (true_ne_false (sym_e Bool false_ true_ h)))
      n)
    ((j: Nat) => (ih: (n: Nat) -> Eq Bool (n <= j) true_ -> Eq Nat (sub j n + n) j) => (n: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= succ j) true_ -> Eq Nat (sub (succ j) i + i) (succ j))
      ((h: Eq Bool (zero <= succ j) true_) => cong_e
        Nat
        Nat
        ((q: Nat) => succ q)
        (j + zero)
        j
        (plus_zero j))
      ((i: Nat) => (ihi: Eq Bool (i <= succ j) true_ -> Eq Nat (sub (succ j) i + i) (succ j)) => (h: Eq
        Bool
        (succ i <= succ j)
        true_) => trans_e
        Nat
        (sub (succ j) (succ i) + succ i)
        (succ (sub j i + i))
        (succ j)
        (plus_succ (sub j i) i)
        (cong_e Nat Nat ((q: Nat) => succ q) (sub j i + i) j (ih i h)))
      n)
    m

val leq_self_plus: (v: Nat) -> (X: Nat) -> Eq Bool (v <= X + v) true_ =
  (v: Nat) => (X: Nat) => Nat.ind
    ((k: Nat) => Eq Bool (v <= k + v) true_)
    (leq_refl v)
    ((k: Nat) => (ih: Eq Bool (v <= k + v) true_) => leq_succ_right v (k + v) ih)
    X

fun lt_leq(m: Nat, n: Nat, h: Lt m n): Eq Bool (m <= n) true_ {struct h} = match h {
  case lt_succ k => leq_succ_right k k (leq_refl k)
  case lt_trans a b c h1 h2 => leq_trans a b c (lt_leq a b h1) (lt_leq b c h2)
}

val sub_plus_self: (X: Nat) -> (w: Nat) -> Eq Nat (sub (X + w) w) X =
  (X: Nat) => (w: Nat) => Nat.ind
    ((k: Nat) => Eq Nat (sub (X + k) k) X)
    (trans_e
      Nat
      (sub (X + zero) zero)
      (sub X zero)
      X
      (cong_e Nat Nat ((t: Nat) => sub t zero) (X + zero) X (plus_zero X))
      (sub_zero X))
    ((k: Nat) => (ih: Eq Nat (sub (X + k) k) X) => trans_e
      Nat
      (sub (X + succ k) (succ k))
      (sub (succ (X + k)) (succ k))
      X
      (cong_e Nat Nat ((t: Nat) => sub t (succ k)) (X + succ k) (succ (X + k)) (plus_succ X k))
      ih)
    w

val plus_sub_swap: (A: Nat)
-> (B: Nat)
  -> (v: Nat)
    -> Eq Bool (v <= A) true_ -> Eq Bool (v <= B) true_ -> Eq Nat (B + sub A v) (A + sub B v) =
  (A: Nat) => (B: Nat) => (v: Nat) => (hA: Eq Bool (v <= A) true_) => (hB: Eq Bool (v <= B) true_) => trans_e
    Nat
    (B + sub A v)
    (sub B v + v + sub A v)
    (A + sub B v)
    (sym_e
      Nat
      (sub B v + v + sub A v)
      (B + sub A v)
      (cong_e Nat Nat ((t: Nat) => t + sub A v) (sub B v + v) B (sub_add B v hB)))
    (trans_e
      Nat
      (sub B v + v + sub A v)
      (sub B v + (v + sub A v))
      (A + sub B v)
      (plus_assoc (sub B v) v (sub A v))
      (trans_e
        Nat
        (sub B v + (v + sub A v))
        (sub B v + (sub A v + v))
        (A + sub B v)
        (cong_e
          Nat
          Nat
          ((t: Nat) => sub B v + t)
          (v + sub A v)
          (sub A v + v)
          (plus_comm v (sub A v)))
        (trans_e
          Nat
          (sub B v + (sub A v + v))
          (sub B v + A)
          (A + sub B v)
          (cong_e Nat Nat ((t: Nat) => sub B v + t) (sub A v + v) A (sub_add A v hA))
          (plus_comm (sub B v) A))))

val lt_zero_absurd: (h: Lt zero zero) -> False =
  (h: Lt zero zero) => Lt.rec
    ((a: Nat) => (b: Nat) => (_: Lt a b) => Eq Nat b zero -> False)
    zero
    zero
    ((n_: Nat) => (eq: Eq Nat (succ n_) zero) => succ_ne_zero n_ eq)
    ((n_: Nat) => (m: Nat) => (k: Nat) => (_: Lt n_ m) => (_: Lt m k) => (_: Eq Nat m zero -> False) => (ih2: Eq
      Nat
      k
      zero
    -> False) => (eq: Eq Nat k zero) => ih2 eq)
    h
    (refl zero)

val leq_succ_succ: (a: Nat)
-> (b: Nat) -> Eq Bool (a <= b) true_ -> Eq Bool (succ a <= succ b) true_ =
  (a: Nat) => (b: Nat) => (h: Eq Bool (a <= b) true_) => h

fun lt_succ_leq(m: Nat, n: Nat, h: Lt m n): Eq Bool (succ m <= n) true_ {struct h} = match h {
  case lt_succ k => leq_refl (succ k)
  case lt_trans a b c h1 h2 => leq_trans
    (succ a)
    (succ b)
    c
    (leq_succ_succ a b (lt_leq a b h1))
    (lt_succ_leq b c h2)
}

val sub_lt_succ: (m: Nat)
-> (w: Nat) -> Lt zero w -> Eq Bool (succ (sub (succ m) w) <= succ m) true_ =
  (m: Nat) => (w: Nat) => Nat.ind
    ((i: Nat) => Lt zero i -> Eq Bool (succ (sub (succ m) i) <= succ m) true_)
    ((h: Lt zero zero) => False.rec
      ((_: False) => Eq Bool (succ (sub (succ m) zero) <= succ m) true_)
      (lt_zero_absurd h))
    ((i: Nat) => (ih: Lt zero i -> Eq Bool (succ (sub (succ m) i) <= succ m) true_) => (h: Lt
      zero
      (succ i)) => leq_sub m i)
    w

val sub_succ_leq: (m: Nat)
-> (d: Nat) -> (k: Nat) -> Eq Bool (m <= succ k) true_ -> Eq Bool (sub m (succ d) <= k) true_ =
  (m: Nat) => Nat.ind
    ((j: Nat) => (d: Nat)
    -> (k: Nat) -> Eq Bool (j <= succ k) true_ -> Eq Bool (sub j (succ d) <= k) true_)
    ((d: Nat) => (k: Nat) => (h: Eq Bool (zero <= succ k) true_) => refl)
    ((j: Nat) => (ih: (d: Nat)
    -> (k: Nat) -> Eq Bool (j <= succ k) true_ -> Eq Bool (sub j (succ d) <= k) true_) => (d: Nat) => (k: Nat) => (h: Eq
      Bool
      (succ j <= succ k)
      true_) => leq_trans (sub j d) j k (leq_sub j d) h)
    m

fun mod_step(d: Nat, j: Nat, m: Nat, b: Bool): Nat = match b {
  case true_ => m
  case false_ => mod_acc j (sub m (succ d)) (succ d)
}

val mod_step_lt: (d: Nat)
-> (j: Nat)
  -> (m: Nat)
    -> (b: Bool)
      -> Eq Bool (lt m (succ d)) b
        -> Eq Bool (m <= succ j) true_
          -> ((m2: Nat) -> Eq Bool (m2 <= j) true_ -> Lt (mod_acc j m2 (succ d)) (succ d))
            -> Lt (mod_step d j m b) (succ d) =
  (d: Nat) => (j: Nat) => (m: Nat) => (b: Bool) => (eq: Eq Bool (lt m (succ d)) b) => (h: Eq
    Bool
    (m <= succ j)
    true_) => (ih: (m2: Nat) -> Eq Bool (m2 <= j) true_ -> Lt (mod_acc j m2 (succ d)) (succ d)) => Bool.ind
    ((x: Bool) => Eq Bool (lt m (succ d)) x
    -> Eq Bool (m <= succ j) true_
      -> ((m2: Nat) -> Eq Bool (m2 <= j) true_ -> Lt (mod_acc j m2 (succ d)) (succ d))
        -> Lt (mod_step d j m x) (succ d))
    ((e: Eq Bool (lt m (succ d)) true_) => (g: Eq Bool (m <= succ j) true_) => (k: (m2: Nat)
    -> Eq Bool (m2 <= j) true_ -> Lt (mod_acc j m2 (succ d)) (succ d)) => lt_true_Lt m (succ d) e)
    ((e: Eq Bool (lt m (succ d)) false_) => (g: Eq Bool (m <= succ j) true_) => (k: (m2: Nat)
    -> Eq Bool (m2 <= j) true_ -> Lt (mod_acc j m2 (succ d)) (succ d)) => k
      (sub m (succ d))
      (sub_succ_leq m d j g))
    b
    eq
    h
    ih

val mod_acc_lt_succ: (d: Nat)
-> (k: Nat) -> (m: Nat) -> Eq Bool (m <= k) true_ -> Lt (mod_acc k m (succ d)) (succ d) =
  (d: Nat) => (k: Nat) => (m: Nat) => (h: Eq Bool (m <= k) true_) => Nat.ind
    ((j: Nat) => (m: Nat) -> Eq Bool (m <= j) true_ -> Lt (mod_acc j m (succ d)) (succ d))
    ((m: Nat) => (h: Eq Bool (m <= zero) true_) => Nat.ind
      ((i: Nat) => Eq Bool (i <= zero) true_ -> Lt i (succ d))
      ((h0: Eq Bool (zero <= zero) true_) => lt_zero_succ d)
      ((i: Nat) => (ih: Eq Bool (i <= zero) true_ -> Lt i (succ d)) => (h1: Eq
        Bool
        (succ i <= zero)
        true_) => False.rec
        ((_: False) => Lt (succ i) (succ d))
        (true_ne_false (sym_e Bool false_ true_ h1)))
      m
      h)
    ((j: Nat) => (ih: (m: Nat) -> Eq Bool (m <= j) true_ -> Lt (mod_acc j m (succ d)) (succ d)) => (m: Nat) => (h: Eq
      Bool
      (m <= succ j)
      true_) => mod_step_lt d j m (lt m (succ d)) (refl (lt m (succ d))) h ih)
    k
    m
    h

val mod_lt: (m: Nat) -> (n: Nat) -> Lt zero n -> Lt (mod m n) n =
  (m: Nat) => (n: Nat) => Nat.ind
    ((k: Nat) => Lt zero k -> Lt (mod m k) k)
    ((h: Lt zero zero) => False.rec ((_: False) => Lt (mod m zero) zero) (lt_zero_absurd h))
    ((k: Nat) => (ih: Lt zero k -> Lt (mod m k) k) => (h: Lt zero (succ k)) => mod_acc_lt_succ
      k
      m
      m
      (leq_refl m))
    n

fun div_step(d: Nat, j: Nat, m: Nat, b: Bool): Nat = match b {
  case true_ => zero
  case false_ => succ (div_acc j (sub m (succ d)) (succ d))
}

val div_add_mod_step: (d: Nat)
-> (j: Nat)
  -> (m: Nat)
    -> (b: Bool)
      -> Eq Bool (lt m (succ d)) b
        -> Eq
            Nat
            (div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc j (sub m (succ d)) (succ d))
            (sub m (succ d))
          -> Eq Nat (div_step d j m b * succ d + mod_step d j m b) m =
  (d: Nat) => (j: Nat) => (m: Nat) => (b: Bool) => (eq: Eq Bool (lt m (succ d)) b) => (ih: Eq
    Nat
    (div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc j (sub m (succ d)) (succ d))
    (sub m (succ d))) => Bool.ind
    ((x: Bool) => Eq Bool (lt m (succ d)) x
    -> Eq
        Nat
        (div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc j (sub m (succ d)) (succ d))
        (sub m (succ d))
      -> Eq Nat (div_step d j m x * succ d + mod_step d j m x) m)
    ((e: Eq Bool (lt m (succ d)) true_) => (g: Eq
      Nat
      (div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc j (sub m (succ d)) (succ d))
      (sub m (succ d))) => refl)
    ((e: Eq Bool (lt m (succ d)) false_) => (g: Eq
      Nat
      (div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc j (sub m (succ d)) (succ d))
      (sub m (succ d))) => trans_e
      Nat
      (succ d + div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc j (sub m (succ d)) (succ d))
      (succ d + (div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc j (sub m (succ d)) (succ d)))
      m
      (plus_assoc
        (succ d)
        (div_acc j (sub m (succ d)) (succ d) * succ d)
        (mod_acc j (sub m (succ d)) (succ d)))
      (trans_e
        Nat
        (succ d + (div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc
          j
          (sub m (succ d))
          (succ d)))
        (succ d + sub m (succ d))
        m
        (cong_e
          Nat
          Nat
          ((t: Nat) => succ d + t)
          (div_acc j (sub m (succ d)) (succ d) * succ d + mod_acc j (sub m (succ d)) (succ d))
          (sub m (succ d))
          g)
        (trans_e
          Nat
          (succ d + sub m (succ d))
          (sub m (succ d) + succ d)
          m
          (sym_e
            Nat
            (sub m (succ d) + succ d)
            (succ d + sub m (succ d))
            (plus_comm (sub m (succ d)) (succ d)))
          (sub_add m (succ d) (lt_false_leq m (succ d) e)))))
    b
    eq
    ih

val div_add_mod_acc: (d: Nat)
-> (k: Nat) -> (m: Nat) -> Eq Nat (div_acc k m (succ d) * succ d + mod_acc k m (succ d)) m =
  (d: Nat) => (k: Nat) => (m: Nat) => Nat.ind
    ((j: Nat) => (m2: Nat) -> Eq Nat (div_acc j m2 (succ d) * succ d + mod_acc j m2 (succ d)) m2)
    ((m2: Nat) => refl)
    ((j: Nat) => (ih: (m2: Nat)
    -> Eq Nat (div_acc j m2 (succ d) * succ d + mod_acc j m2 (succ d)) m2) => (m2: Nat) => div_add_mod_step
      d
      j
      m2
      (lt m2 (succ d))
      (refl (lt m2 (succ d)))
      (ih (sub m2 (succ d))))
    k
    m

val div_add_mod: (m: Nat) -> (n: Nat) -> Lt zero n -> Eq Nat (div m n * n + mod m n) m =
  (m: Nat) => (n: Nat) => Nat.ind
    ((k: Nat) => Lt zero k -> Eq Nat (div m k * k + mod m k) m)
    ((h: Lt zero zero) => False.rec
      ((_: False) => Eq Nat (div m zero * zero + mod m zero) m)
      (lt_zero_absurd h))
    ((k: Nat) => (ih: Lt zero k -> Eq Nat (div m k * k + mod m k) m) => (h: Lt zero (succ k)) => div_add_mod_acc
      k
      m
      m)
    n
// --- Well-founded accessibility for Nat -----------------------------------
//
// `Acc` takes the relation as a parameter, so accessibility is stated as
// `Acc Nat lt_rel n`. The constructor supplies only the value and the
// accessibility function.

fun lt_rel(a: Nat, b: Nat): Prop = Lt a b

fun nat_wf(n: Nat): Acc Nat lt_rel n = match n {
  case zero => acc_intro
    zero
    ((y: Nat) => (h: Lt y zero) => False.rec
      ((_: False) => Acc Nat lt_rel y)
      (Lt.rec
        ((a: Nat) => (b: Nat) => (_: Lt a b) => Eq Nat b zero -> False)
        y
        zero
        ((n_: Nat) => (eq: Eq Nat (succ n_) zero) => succ_ne_zero n_ eq)
        ((n_: Nat) => (m: Nat) => (k: Nat) => (_: Lt n_ m) => (_: Lt m k) => (_: Eq Nat m zero
        -> False) => (ih2: Eq Nat k zero -> False) => (eq: Eq Nat k zero) => ih2 eq)
        h
        (refl zero)))
  case succ k => acc_intro (succ k) ((y: Nat) => (h: Lt y (succ k)) => nat_wf_help k y h)
} and nat_wf_help(k: Nat, y: Nat, h: Lt y (succ k)): Acc Nat lt_rel y {struct h} = match h {
  case lt_succ y_ => nat_wf y_
  case lt_trans y_ m _ p1 p2 => match nat_wf_help k m p2 {
    case acc_intro _ f => f y_ p1
  }
}
// --- Theorems about an indexed family -----------------------------------
//
// `Vec[A] n` is length-indexed: the length lives in the type. These prove
// theorems whose *statement* depends on that index, via the dependent
// eliminator `Vec.ind` whose motive binds both the index and the vector.
// This is the part that requires elaboration, indexed-family recursion,
// and dependent motives to cohere, beyond merely computing with the type.

val vlength_index: (A: Type) -> (n: Nat) -> (v: Vec A n) -> Eq Nat (vlength v) n =
  (A: Type) => (n: Nat) => (v: Vec A n) => Vec.ind
    A
    ((m: Nat) => (w: Vec A m) => Eq Nat (vlength w) m)
    n
    (refl zero)
    ((k: Nat) => (x: A) => (rest: Vec A k) => (ih: Eq Nat (vlength rest) k) => cong
      ((j: Nat) => succ j)
      ih)
    v
// succ_inj: succ is injective

val succ_inj: (a: Nat) -> (b: Nat) -> Eq Nat (succ a) (succ b) -> Eq Nat a b =
  (a: Nat) => (b: Nat) => (p: Eq Nat (succ a) (succ b)) => cong_e
    Nat
    Nat
    ((n: Nat) => match n {
      case zero => zero
      case succ n_ => n_
    })
    (succ a)
    (succ b)
    p
// --- Well-founded induction for Nat -----------------------------------------
// strong_ind_impl: well-founded induction on n, via Acc.rec over nat_wf.

fun strong_ind_impl(n: Nat, P: Nat -> Prop, step: (n: Nat) -> ((k: Nat) -> Lt k n -> P k) -> P n): P
  n =
  Acc.rec
    Nat
    lt_rel
    ((m: Nat) => (v: Acc Nat lt_rel m) => P m)
    n
    ((x: Nat) => (f: (y: Nat) -> lt_rel y x -> Acc Nat lt_rel y) => (ih: (y: Nat)
    -> (h: lt_rel y x) -> P y) => step x ih)
    (nat_wf n)

val strong_ind: (P: Nat -> Prop)
-> ((n: Nat) -> ((k: Nat) -> Lt k n -> P k) -> P n) -> (n: Nat) -> P n =
  (P: Nat -> Prop) => (step: (n: Nat) -> ((k: Nat) -> Lt k n -> P k) -> P n) => (n: Nat) => strong_ind_impl
    n
    P
    step
