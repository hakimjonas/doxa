// Canonical proofs exercising the kernel end-to-end. This file holds
// the full proof roster and type-checks completely, including the four
// list-domain lemmas `appendNil`, `appendAssoc`, `lengthAppend`, and
// `mapCompose` (the last closed by guarded delta-reduction), and the
// refutation lemmas `succNeZero` and `trueNeFalse` that derive
// `False` from impossible equalities.
//
// Styles in this file:
//
//  - Implicit style (`fun sym/trans/cong`): call sites omit type
//    parameters; pattern unification solves them against the
//    explicit proof argument's inferred type.
//
// Shared modules are imported instead of redeclared.
import "bool.doxa"

import "eq.doxa"

import "list.doxa"

import "nat.doxa"

import "vec.doxa"
// --- Derived Eq lemmas (explicit style) ------------------------------------
//
// Explicit-style sym/trans/cong for proofs whose composition
// crosses a call-site where pattern unification over the
// implicit-style variant currently fails to converge. These are
// definitionally equal to the implicit versions, they just pass
// types positionally.

val symE: (A: Type) -> (x: A) -> (y: A) -> Eq A x y -> Eq A y x =
  (A: Type) => (x: A) => (y: A) => (p: Eq A x y) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq A b a)
    x
    y
    ((z: A) => refl z)
    p

val transE: (A: Type) -> (x: A) -> (y: A) -> (z: A) -> Eq A x y -> Eq A y z -> Eq A x z =
  (A: Type) => (x: A) => (y: A) => (z: A) => (p: Eq A x y) => (q: Eq A y z) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq A b z -> Eq A a z)
    x
    y
    ((w: A) => (r: Eq A w z) => r)
    p
    q

val congE: (A: Type) -> (B: Type) -> (f: A -> B) -> (x: A) -> (y: A) -> Eq A x y -> Eq B (f x) (f y) =
  (A: Type) => (B: Type) => (f: A -> B) => (x: A) => (y: A) => (p: Eq A x y) => Eq.rec
    A
    ((a: A) => (b: A) => (_: Eq A a b) => Eq B (f a) (f b))
    x
    y
    ((z: A) => refl (f z))
    p
// --- Nat-domain proofs (implicit style) -----------------------------------
//
// These proofs compose `cong`/`trans`/`sym` in implicit style.
// The composition pattern here is `cong succ ih`, wrapping a
// hypothesis about `plus m zero ≡ m` into one about `succ (plus m
// zero) ≡ succ m`. This relies on the conversion check normalizing
// the two sides of a VMatch under env-relative coordinates: both
// carry the same source match, one captured under a β-reduced env
// and one not, and they must still be recognised as equal.

val plusZero: (n: Nat) -> Eq Nat (n + zero) n =
  Nat.ind
    ((k: Nat) => Eq Nat (k + zero) k)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (m + zero) m) => cong ((k: Nat) => succ k) ih)

val plusSucc: (m: Nat) -> (n: Nat) -> Eq Nat (m + succ n) (succ (m + n)) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k + succ n) (succ (k + n)))
    ((n: Nat) => refl (succ n))
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k + succ n) (succ (k + n))) => (n: Nat) => cong
      ((x: Nat) => succ x)
      (ih n))
    m

val plusComm: (m: Nat) -> (n: Nat) -> Eq Nat (m + n) (n + m) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k + n) (n + k))
    ((n: Nat) => symE Nat (n + zero) n (plusZero n))
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k + n) (n + k)) => (n: Nat) => transE
      Nat
      (succ (k + n))
      (succ (n + k))
      (n + succ k)
      (congE Nat Nat ((x: Nat) => succ x) (k + n) (n + k) (ih n))
      (symE Nat (n + succ k) (succ (n + k)) (plusSucc n k)))
    m

val multiplyZero: (n: Nat) -> Eq Nat (n * zero) zero =
  Nat.ind
    ((k: Nat) => Eq Nat (k * zero) zero)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (m * zero) zero) => ih)

val multiplyOne: (n: Nat) -> Eq Nat (n * succ zero) n =
  Nat.ind
    ((k: Nat) => Eq Nat (k * succ zero) k)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (m * succ zero) m) => cong ((k: Nat) => succ k) ih)

val plusAssoc: (m: Nat) -> (n: Nat) -> (p: Nat) -> Eq Nat (m + n + p) (m + (n + p)) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> (p: Nat) -> Eq Nat (k + n + p) (k + (n + p)))
    ((n: Nat) => (p: Nat) => refl (n + p))
    ((k: Nat) => (ih: (n: Nat) -> (p: Nat) -> Eq Nat (k + n + p) (k + (n + p))) => (n: Nat) => (p: Nat) => cong
      ((x: Nat) => succ x)
      (ih n p))
    m

val multiplySuccRight: (m: Nat) -> (n: Nat) -> Eq Nat (m * succ n) (m + m * n) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k * succ n) (k + k * n))
    ((n: Nat) => refl zero)
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k * succ n) (k + k * n)) => (n: Nat) => transE
      Nat
      (succ k * succ n)
      (succ n + (k + k * n))
      (succ k + (n + k * n))
      (transE
        Nat
        (succ k * succ n)
        (succ n + k * succ n)
        (succ n + (k + k * n))
        (refl (succ n + k * succ n))
        (cong ((w: Nat) => succ n + w) (ih n)))
      (transE
        Nat
        (succ n + (k + k * n))
        (succ (n + k) + k * n)
        (succ k + (n + k * n))
        (transE
          Nat
          (succ n + (k + k * n))
          (succ n + k + k * n)
          (succ (n + k) + k * n)
          (symE Nat (succ n + k + k * n) (succ n + (k + k * n)) (plusAssoc (succ n) k (k * n)))
          (refl (succ (n + k) + k * n)))
        (transE
          Nat
          (succ (n + k) + k * n)
          (succ (k + n) + k * n)
          (succ k + (n + k * n))
          (congE
            Nat
            Nat
            ((z: Nat) => z + k * n)
            (succ (n + k))
            (succ (k + n))
            (cong ((x: Nat) => succ x) (plusComm n k)))
          (transE
            Nat
            (succ (k + n) + k * n)
            (succ k + n + k * n)
            (succ k + (n + k * n))
            (refl (succ k + n + k * n))
            (plusAssoc (succ k) n (k * n))))))
    m

val multiplyComm: (m: Nat) -> (n: Nat) -> Eq Nat (m * n) (n * m) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> Eq Nat (k * n) (n * k))
    ((n: Nat) => symE Nat (n * zero) zero (multiplyZero n))
    ((k: Nat) => (ih: (n: Nat) -> Eq Nat (k * n) (n * k)) => (n: Nat) => transE
      Nat
      (succ k * n)
      (n + k * n)
      (n * succ k)
      (refl (n + k * n))
      (transE
        Nat
        (n + k * n)
        (n + n * k)
        (n * succ k)
        (congE Nat Nat ((z: Nat) => n + z) (k * n) (n * k) (ih n))
        (symE Nat (n * succ k) (n + n * k) (multiplySuccRight n k))))
    m

val multiply2: (n: Nat) -> Eq Nat (succ (succ zero) * n) (n + n) =
  (n: Nat) => transE
    Nat
    (succ (succ zero) * n)
    (n + succ zero * n)
    (n + n)
    (refl (n + succ zero * n))
    (cong
      ((z: Nat) => n + z)
      (transE Nat (succ zero * n) (n * succ zero) n (multiplyComm (succ zero) n) (multiplyOne n)))

val multiplyPlus: (a: Nat) -> (b: Nat) -> (c: Nat) -> Eq Nat ((a + b) * c) (a * c + b * c) =
  (a: Nat) => Nat.ind
    ((k: Nat) => (b: Nat) -> (c: Nat) -> Eq Nat ((k + b) * c) (k * c + b * c))
    ((b: Nat) => (c: Nat) => refl (b * c))
    ((k: Nat) => (ih: (b: Nat) -> (c: Nat) -> Eq Nat ((k + b) * c) (k * c + b * c)) => (b: Nat) => (c: Nat) => transE
      Nat
      ((succ k + b) * c)
      (c + (k + b) * c)
      (succ k * c + b * c)
      (refl (c + (k + b) * c))
      (transE
        Nat
        (c + (k + b) * c)
        (c + (k * c + b * c))
        (succ k * c + b * c)
        (congE Nat Nat ((x: Nat) => c + x) ((k + b) * c) (k * c + b * c) (ih b c))
        (transE
          Nat
          (c + (k * c + b * c))
          (c + k * c + b * c)
          (succ k * c + b * c)
          (symE Nat (c + k * c + b * c) (c + (k * c + b * c)) (plusAssoc c (k * c) (b * c)))
          (refl (c + k * c + b * c)))))
    a

val multiplyAssoc: (m: Nat) -> (n: Nat) -> (p: Nat) -> Eq Nat (m * n * p) (m * (n * p)) =
  (m: Nat) => Nat.ind
    ((k: Nat) => (n: Nat) -> (p: Nat) -> Eq Nat (k * n * p) (k * (n * p)))
    ((n: Nat) => (p: Nat) => refl zero)
    ((k: Nat) => (ih: (n: Nat) -> (p: Nat) -> Eq Nat (k * n * p) (k * (n * p))) => (n: Nat) => (p: Nat) => transE
      Nat
      (succ k * n * p)
      (n * p + k * n * p)
      (succ k * (n * p))
      (transE
        Nat
        (succ k * n * p)
        ((n + k * n) * p)
        (n * p + k * n * p)
        (refl ((n + k * n) * p))
        (multiplyPlus n (k * n) p))
      (transE
        Nat
        (n * p + k * n * p)
        (n * p + k * (n * p))
        (succ k * (n * p))
        (congE Nat Nat ((x: Nat) => n * p + x) (k * n * p) (k * (n * p)) (ih n p))
        (refl (n * p + k * (n * p)))))
    m
// --- Nat subtraction and zero-divisor lemmas ------------------------------
//
// The division and modulo functions are specified in `docs/arithmetic.md`.
// `div m zero` and `mod m zero` are the two zero-divisor conventions; both
// `modLt` and `divAddMod` are proved below.

val subZero: (m: Nat) -> Eq Nat (sub m zero) m =
  Nat.ind
    ((k: Nat) => Eq Nat (sub k zero) k)
    (refl zero)
    ((m: Nat) => (ih: Eq Nat (sub m zero) m) => refl (succ m))

val modAccZero: (k: Nat) -> (m: Nat) -> Eq Nat (modAcc k m zero) m =
  Nat.ind
    ((k: Nat) => (m: Nat) -> Eq Nat (modAcc k m zero) m)
    ((m: Nat) => refl m)
    ((k: Nat) => (ih: (m: Nat) -> Eq Nat (modAcc k m zero) m) => (m: Nat) => transE
      Nat
      (modAcc k (sub m zero) zero)
      (sub m zero)
      m
      (ih (sub m zero))
      (subZero m))

val modZero: (m: Nat) -> Eq Nat (mod m zero) m = (m: Nat) => modAccZero m m

val divZero: (m: Nat) -> Eq Nat (div m zero) zero = (m: Nat) => refl zero
// --- List-domain proofs ---------------------------------------------------
//
// Parametric-type variants of the Nat-domain proofs above, in natural
// implicit style. `appendNil`, `appendAssoc`, and `lengthAppend`
// type-check via scope-aware TMeta-spine handling; `mapCompose` (below)
// additionally needs guarded delta-reduction.

val appendNil: (A: Type) -> (xs: List A) -> Eq (List A) (append xs nil) xs =
  (A: Type) => List.ind
    A
    ((ys: List A) => Eq (List A) (append ys nil) ys)
    (refl nil)
    ((h: A) => (t: List A) => (ih: Eq (List A) (append t nil) t) => congE
      (List A)
      (List A)
      ((ts: List A) => cons h ts)
      (append t nil)
      t
      ih)

val appendAssoc: (A: Type)
-> (xs: List A)
  -> (ys: List A)
    -> (zs: List A) -> Eq (List A) (append (append xs ys) zs) (append xs (append ys zs)) =
  (A: Type) => List.ind
    A
    ((xs: List A) => (ys: List A)
    -> (zs: List A) -> Eq (List A) (append (append xs ys) zs) (append xs (append ys zs)))
    ((ys: List A) => (zs: List A) => refl (append ys zs))
    ((h: A) => (t: List A) => (ih: (ys: List A)
    -> (zs: List A) -> Eq (List A) (append (append t ys) zs) (append t (append ys zs))) => (ys: List
      A) => (zs: List A) => congE
      (List A)
      (List A)
      ((ts: List A) => cons h ts)
      (append (append t ys) zs)
      (append t (append ys zs))
      (ih ys zs))
// The double-`map` nesting in the statement exercises guarded
// delta-reduction (SPEC §8.6 fix-reduction): a recursive `fun` stays
// folded while its decreasing argument is a neutral, so `map t f`
// remains a depth-portable `TTop(map)` application rather than a
// stuck value frozen at one depth and re-evaluated at another.

val mapCompose: (A: Type)
-> (B: Type)
  -> (C: Type)
    -> (f: A -> B)
      -> (g: B -> C) -> (xs: List A) -> Eq (List C) (map (map xs f) g) (map xs ((a: A) => g (f a))) =
  (A: Type) => (B: Type) => (C: Type) => (f: A -> B) => (g: B -> C) => List.ind
    A
    ((xs: List A) => Eq (List C) (map (map xs f) g) (map xs ((a: A) => g (f a))))
    (refl nil)
    ((h: A) => (t: List A) => (ih: Eq (List C) (map (map t f) g) (map t ((a: A) => g (f a)))) => congE
      (List C)
      (List C)
      ((ts: List C) => cons (g (f h)) ts)
      (map (map t f) g)
      (map t ((a: A) => g (f a)))
      ih)

val lengthAppend: (A: Type)
-> (xs: List A) -> (ys: List A) -> Eq Nat (length (append xs ys)) (length xs + length ys) =
  (A: Type) => List.ind
    A
    ((xs: List A) => (ys: List A) -> Eq Nat (length (append xs ys)) (length xs + length ys))
    ((ys: List A) => refl (length ys))
    ((h: A) => (t: List A) => (ih: (ys: List A)
    -> Eq Nat (length (append t ys)) (length t + length ys)) => (ys: List A) => congE
      Nat
      Nat
      ((k: Nat) => succ k)
      (length (append t ys))
      (length t + length ys)
      (ih ys))
// --- Refutation: distinct constructors are not equal --------------------
//
// These prove negations, not equations: from an impossible equality we
// derive `False` (the empty type), so the logic can refute, not only
// rewrite. The technique is the standard "discriminator predicate": a
// Prop-valued function that is provable at one constructor and `False`
// at the other. Transporting the provable case across the bogus equality
// (via Eq.rec) lands in `False`.

data False: Prop {

}

fun isZero(n: Nat): Prop = match n {
  case zero => Eq Nat zero zero
  case succ k => False
}

fun isTrue(b: Bool): Prop = match b {
  case true_ => Eq Bool true_ true_
  case false_ => False
}

val succNeZero: (n: Nat) -> Eq Nat (succ n) zero -> False =
  (n: Nat) => (p: Eq Nat (succ n) zero) => Eq.rec
    Nat
    ((a: Nat) => (b: Nat) => (_: Eq Nat a b) => isZero b -> isZero a)
    (succ n)
    zero
    ((z: Nat) => (h: isZero z) => h)
    p
    (refl zero)

val trueNeFalse: Eq Bool true_ false_ -> False =
  (p: Eq Bool true_ false_) => Eq.rec
    Bool
    ((a: Bool) => (b: Bool) => (_: Eq Bool a b) => isTrue a -> isTrue b)
    true_
    false_
    ((z: Bool) => (h: isTrue z) => h)
    p
    (refl true_)
// --- Nat order and subtraction lemmas -------------------------------------

val leqRefl: (n: Nat) -> Eq Bool (n <= n) true_ =
  (n: Nat) => Nat.ind
    ((k: Nat) => Eq Bool (k <= k) true_)
    refl
    ((k: Nat) => (ih: Eq Bool (k <= k) true_) => ih)
    n

val ltZeroSucc: (n: Nat) -> Lt zero (succ n) =
  (n: Nat) => Nat.ind
    ((k: Nat) => Lt zero (succ k))
    (ltSucc zero)
    ((k: Nat) => (ih: Lt zero (succ k)) => ltTrans
      zero
      (succ k)
      (succ (succ k))
      ih
      (ltSucc (succ k)))
    n

fun ltSuccMono(a: Nat, b: Nat, h: Lt a b): Lt (succ a) (succ b) {struct h} = match h {
  case ltSucc n => ltSucc (succ n)
  case ltTrans n m k h1 h2 => ltTrans
    (succ n)
    (succ m)
    (succ k)
    (ltSuccMono n m h1)
    (ltSuccMono m k h2)
}

val leqSuccRight: (a: Nat) -> (b: Nat) -> Eq Bool (a <= b) true_ -> Eq Bool (a <= succ b) true_ =
  (a: Nat) => (b: Nat) => (h: Eq Bool (a <= b) true_) => Nat.ind
    ((k: Nat) => (j: Nat) -> Eq Bool (j <= k) true_ -> Eq Bool (j <= succ k) true_)
    ((j: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= zero) true_ -> Eq Bool (i <= succ zero) true_)
      ((h0: Eq Bool (zero <= zero) true_) => refl)
      ((i: Nat) => (ih: Eq Bool (i <= zero) true_ -> Eq Bool (i <= succ zero) true_) => (h1: Eq
        Bool
        (succ i <= zero)
        true_) => False.rec
        ((_: False) => Eq Bool (succ i <= succ zero) true_)
        (trueNeFalse (symE Bool false_ true_ h1)))
      j)
    ((k: Nat) => (ih: (j: Nat) -> Eq Bool (j <= k) true_ -> Eq Bool (j <= succ k) true_) => (j: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= succ k) true_ -> Eq Bool (i <= succ (succ k)) true_)
      ((h0: Eq Bool (zero <= succ k) true_) => refl)
      ((i: Nat) => (ihi: Eq Bool (i <= succ k) true_ -> Eq Bool (i <= succ (succ k)) true_) => (h1: Eq
        Bool
        (succ i <= succ k)
        true_) => ih i h1)
      j)
    b
    a
    h

val leqTrans: (a: Nat)
-> (b: Nat)
  -> (c: Nat) -> Eq Bool (a <= b) true_ -> Eq Bool (b <= c) true_ -> Eq Bool (a <= c) true_ =
  (a: Nat) => (b: Nat) => (c: Nat) => (h1: Eq Bool (a <= b) true_) => (h2: Eq Bool (b <= c) true_) => Nat.ind
    ((k: Nat) => (p: Nat)
    -> (q: Nat) -> Eq Bool (k <= p) true_ -> Eq Bool (p <= q) true_ -> Eq Bool (k <= q) true_)
    ((p: Nat) => (q: Nat) => (g1: Eq Bool (zero <= p) true_) => (g2: Eq Bool (p <= q) true_) => refl)
    ((k: Nat) => (ih: (p: Nat)
    -> (q: Nat) -> Eq Bool (k <= p) true_ -> Eq Bool (p <= q) true_ -> Eq Bool (k <= q) true_) => (p: Nat) => (q: Nat) => (g1: Eq
      Bool
      (succ k <= p)
      true_) => (g2: Eq Bool (p <= q) true_) => Nat.ind
      ((r: Nat) => Eq Bool (succ k <= r) true_
      -> Eq Bool (r <= q) true_ -> Eq Bool (succ k <= q) true_)
      ((i0: Eq Bool (succ k <= zero) true_) => (j0: Eq Bool (zero <= q) true_) => False.rec
        ((_: False) => Eq Bool (succ k <= q) true_)
        (trueNeFalse (symE Bool false_ true_ i0)))
      ((r: Nat) => (ihr: Eq Bool (succ k <= r) true_
      -> Eq Bool (r <= q) true_ -> Eq Bool (succ k <= q) true_) => (i1: Eq
        Bool
        (succ k <= succ r)
        true_) => (j1: Eq Bool (succ r <= q) true_) => Nat.ind
        ((s: Nat) => Eq Bool (succ r <= s) true_ -> Eq Bool (succ k <= s) true_)
        ((i2: Eq Bool (succ r <= zero) true_) => False.rec
          ((_: False) => Eq Bool (succ k <= zero) true_)
          (trueNeFalse (symE Bool false_ true_ i2)))
        ((s: Nat) => (ihs: Eq Bool (succ r <= s) true_ -> Eq Bool (succ k <= s) true_) => (i2: Eq
          Bool
          (succ r <= succ s)
          true_) => ih r s i1 i2)
        q
        j1)
      p
      g1
      g2)
    a
    b
    c
    h1
    h2

val leqSub: (m: Nat) -> (n: Nat) -> Eq Bool (sub m n <= m) true_ =
  (m: Nat) => Nat.ind
    ((j: Nat) => (n: Nat) -> Eq Bool (sub j n <= j) true_)
    ((n: Nat) => refl)
    ((j: Nat) => (ih: (n: Nat) -> Eq Bool (sub j n <= j) true_) => (n: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (sub (succ j) i <= succ j) true_)
      (leqRefl (succ j))
      ((i: Nat) => (ihi: Eq Bool (sub (succ j) i <= succ j) true_) => leqSuccRight
        (sub j i)
        j
        (ih i))
      n)
    m

val ltOfLeq: (m: Nat) -> (n: Nat) -> Eq Bool (m <= n) true_ -> Lt m (succ n) =
  (m: Nat) => (n: Nat) => (h: Eq Bool (m <= n) true_) => Nat.ind
    ((k: Nat) => (j: Nat) -> Eq Bool (j <= k) true_ -> Lt j (succ k))
    ((j: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= zero) true_ -> Lt i (succ zero))
      ((h0: Eq Bool (zero <= zero) true_) => ltSucc zero)
      ((i: Nat) => (ih: Eq Bool (i <= zero) true_ -> Lt i (succ zero)) => (h1: Eq
        Bool
        (succ i <= zero)
        true_) => False.rec
        ((_: False) => Lt (succ i) (succ zero))
        (trueNeFalse (symE Bool false_ true_ h1)))
      j)
    ((k: Nat) => (ih: (j: Nat) -> Eq Bool (j <= k) true_ -> Lt j (succ k)) => (j: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= succ k) true_ -> Lt i (succ (succ k)))
      ((h0: Eq Bool (zero <= succ k) true_) => ltZeroSucc (succ k))
      ((i: Nat) => (ihi: Eq Bool (i <= succ k) true_ -> Lt i (succ (succ k))) => (h1: Eq
        Bool
        (succ i <= succ k)
        true_) => ltSuccMono i (succ k) (ih i h1))
      j)
    n
    m
    h

val ltTrueLt: (m: Nat) -> (n: Nat) -> Eq Bool (lt m n) true_ -> Lt m n =
  (m: Nat) => (n: Nat) => (h: Eq Bool (lt m n) true_) => Nat.ind
    ((k: Nat) => Eq Bool (lt m k) true_ -> Lt m k)
    ((h0: Eq Bool (lt m zero) true_) => False.rec
      ((_: False) => Lt m zero)
      (trueNeFalse (symE Bool false_ true_ h0)))
    ((k: Nat) => (ih: Eq Bool (lt m k) true_ -> Lt m k) => (h0: Eq Bool (lt m (succ k)) true_) => ltOfLeq
      m
      k
      h0)
    n
    h

val leqSuccTrue: (m: Nat) -> (k: Nat) -> Eq Bool (m <= k) false_ -> Eq Bool (succ k <= m) true_ =
  (m: Nat) => Nat.ind
    ((j: Nat) => (k: Nat) -> Eq Bool (j <= k) false_ -> Eq Bool (succ k <= j) true_)
    ((k: Nat) => (h: Eq Bool (zero <= k) false_) => False.rec
      ((_: False) => Eq Bool (succ k <= zero) true_)
      (trueNeFalse h))
    ((j: Nat) => (ih: (k: Nat) -> Eq Bool (j <= k) false_ -> Eq Bool (succ k <= j) true_) => (k: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (succ j <= i) false_ -> Eq Bool (succ i <= succ j) true_)
      ((h: Eq Bool (succ j <= zero) false_) => refl)
      ((i: Nat) => (ihi: Eq Bool (succ j <= i) false_ -> Eq Bool (succ i <= succ j) true_) => (h: Eq
        Bool
        (succ j <= succ i)
        false_) => ih i h)
      k)
    m

val ltFalseLeq: (m: Nat) -> (n: Nat) -> Eq Bool (lt m n) false_ -> Eq Bool (n <= m) true_ =
  (m: Nat) => (n: Nat) => (h: Eq Bool (lt m n) false_) => Nat.ind
    ((k: Nat) => Eq Bool (lt m k) false_ -> Eq Bool (k <= m) true_)
    ((h0: Eq Bool (lt m zero) false_) => refl)
    ((k: Nat) => (ih: Eq Bool (lt m k) false_ -> Eq Bool (k <= m) true_) => (h0: Eq
      Bool
      (m <= k)
      false_) => leqSuccTrue m k h0)
    n
    h

val subAdd: (m: Nat) -> (n: Nat) -> Eq Bool (n <= m) true_ -> Eq Nat (sub m n + n) m =
  (m: Nat) => Nat.ind
    ((j: Nat) => (n: Nat) -> Eq Bool (n <= j) true_ -> Eq Nat (sub j n + n) j)
    ((n: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= zero) true_ -> Eq Nat (sub zero i + i) zero)
      ((h: Eq Bool (zero <= zero) true_) => refl)
      ((i: Nat) => (ihi: Eq Bool (i <= zero) true_ -> Eq Nat (sub zero i + i) zero) => (h: Eq
        Bool
        (succ i <= zero)
        true_) => False.rec
        ((_: False) => Eq Nat (sub zero (succ i) + succ i) zero)
        (trueNeFalse (symE Bool false_ true_ h)))
      n)
    ((j: Nat) => (ih: (n: Nat) -> Eq Bool (n <= j) true_ -> Eq Nat (sub j n + n) j) => (n: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= succ j) true_ -> Eq Nat (sub (succ j) i + i) (succ j))
      ((h: Eq Bool (zero <= succ j) true_) => congE
        Nat
        Nat
        ((q: Nat) => succ q)
        (j + zero)
        j
        (plusZero j))
      ((i: Nat) => (ihi: Eq Bool (i <= succ j) true_ -> Eq Nat (sub (succ j) i + i) (succ j)) => (h: Eq
        Bool
        (succ i <= succ j)
        true_) => transE
        Nat
        (sub (succ j) (succ i) + succ i)
        (succ (sub j i + i))
        (succ j)
        (plusSucc (sub j i) i)
        (congE Nat Nat ((q: Nat) => succ q) (sub j i + i) j (ih i h)))
      n)
    m

val leqSelfPlus: (v: Nat) -> (X: Nat) -> Eq Bool (v <= X + v) true_ =
  (v: Nat) => (X: Nat) => Nat.ind
    ((k: Nat) => Eq Bool (v <= k + v) true_)
    (leqRefl v)
    ((k: Nat) => (ih: Eq Bool (v <= k + v) true_) => leqSuccRight v (k + v) ih)
    X

fun ltLeq(m: Nat, n: Nat, h: Lt m n): Eq Bool (m <= n) true_ {struct h} = match h {
  case ltSucc k => leqSuccRight k k (leqRefl k)
  case ltTrans a b c h1 h2 => leqTrans a b c (ltLeq a b h1) (ltLeq b c h2)
}

val subPlusSelf: (X: Nat) -> (w: Nat) -> Eq Nat (sub (X + w) w) X =
  (X: Nat) => (w: Nat) => Nat.ind
    ((k: Nat) => Eq Nat (sub (X + k) k) X)
    (transE
      Nat
      (sub (X + zero) zero)
      (sub X zero)
      X
      (congE Nat Nat ((t: Nat) => sub t zero) (X + zero) X (plusZero X))
      (subZero X))
    ((k: Nat) => (ih: Eq Nat (sub (X + k) k) X) => transE
      Nat
      (sub (X + succ k) (succ k))
      (sub (succ (X + k)) (succ k))
      X
      (congE Nat Nat ((t: Nat) => sub t (succ k)) (X + succ k) (succ (X + k)) (plusSucc X k))
      ih)
    w

val plusSubSwap: (A: Nat)
-> (B: Nat)
  -> (v: Nat)
    -> Eq Bool (v <= A) true_ -> Eq Bool (v <= B) true_ -> Eq Nat (B + sub A v) (A + sub B v) =
  (A: Nat) => (B: Nat) => (v: Nat) => (hA: Eq Bool (v <= A) true_) => (hB: Eq Bool (v <= B) true_) => transE
    Nat
    (B + sub A v)
    (sub B v + v + sub A v)
    (A + sub B v)
    (symE
      Nat
      (sub B v + v + sub A v)
      (B + sub A v)
      (congE Nat Nat ((t: Nat) => t + sub A v) (sub B v + v) B (subAdd B v hB)))
    (transE
      Nat
      (sub B v + v + sub A v)
      (sub B v + (v + sub A v))
      (A + sub B v)
      (plusAssoc (sub B v) v (sub A v))
      (transE
        Nat
        (sub B v + (v + sub A v))
        (sub B v + (sub A v + v))
        (A + sub B v)
        (congE Nat Nat ((t: Nat) => sub B v + t) (v + sub A v) (sub A v + v) (plusComm v (sub A v)))
        (transE
          Nat
          (sub B v + (sub A v + v))
          (sub B v + A)
          (A + sub B v)
          (congE Nat Nat ((t: Nat) => sub B v + t) (sub A v + v) A (subAdd A v hA))
          (plusComm (sub B v) A))))

val ltZeroAbsurd: (h: Lt zero zero) -> False =
  (h: Lt zero zero) => Lt.rec
    ((a: Nat) => (b: Nat) => (_: Lt a b) => Eq Nat b zero -> False)
    zero
    zero
    ((n_: Nat) => (eq: Eq Nat (succ n_) zero) => succNeZero n_ eq)
    ((n_: Nat) => (m: Nat) => (k: Nat) => (_: Lt n_ m) => (_: Lt m k) => (_: Eq Nat m zero -> False) => (ih2: Eq
      Nat
      k
      zero
    -> False) => (eq: Eq Nat k zero) => ih2 eq)
    h
    (refl zero)

val leqSuccSucc: (a: Nat) -> (b: Nat) -> Eq Bool (a <= b) true_ -> Eq Bool (succ a <= succ b) true_ =
  (a: Nat) => (b: Nat) => (h: Eq Bool (a <= b) true_) => h

fun ltSuccLeq(m: Nat, n: Nat, h: Lt m n): Eq Bool (succ m <= n) true_ {struct h} = match h {
  case ltSucc k => leqRefl (succ k)
  case ltTrans a b c h1 h2 => leqTrans
    (succ a)
    (succ b)
    c
    (leqSuccSucc a b (ltLeq a b h1))
    (ltSuccLeq b c h2)
}

val subLtSucc: (m: Nat) -> (w: Nat) -> Lt zero w -> Eq Bool (succ (sub (succ m) w) <= succ m) true_ =
  (m: Nat) => (w: Nat) => Nat.ind
    ((i: Nat) => Lt zero i -> Eq Bool (succ (sub (succ m) i) <= succ m) true_)
    ((h: Lt zero zero) => False.rec
      ((_: False) => Eq Bool (succ (sub (succ m) zero) <= succ m) true_)
      (ltZeroAbsurd h))
    ((i: Nat) => (ih: Lt zero i -> Eq Bool (succ (sub (succ m) i) <= succ m) true_) => (h: Lt
      zero
      (succ i)) => leqSub m i)
    w

val subSuccLeq: (m: Nat)
-> (d: Nat) -> (k: Nat) -> Eq Bool (m <= succ k) true_ -> Eq Bool (sub m (succ d) <= k) true_ =
  (m: Nat) => Nat.ind
    ((j: Nat) => (d: Nat)
    -> (k: Nat) -> Eq Bool (j <= succ k) true_ -> Eq Bool (sub j (succ d) <= k) true_)
    ((d: Nat) => (k: Nat) => (h: Eq Bool (zero <= succ k) true_) => refl)
    ((j: Nat) => (ih: (d: Nat)
    -> (k: Nat) -> Eq Bool (j <= succ k) true_ -> Eq Bool (sub j (succ d) <= k) true_) => (d: Nat) => (k: Nat) => (h: Eq
      Bool
      (succ j <= succ k)
      true_) => leqTrans (sub j d) j k (leqSub j d) h)
    m

fun modStep(d: Nat, j: Nat, m: Nat, b: Bool): Nat = match b {
  case true_ => m
  case false_ => modAcc j (sub m (succ d)) (succ d)
}

val modStepLt: (d: Nat)
-> (j: Nat)
  -> (m: Nat)
    -> (b: Bool)
      -> Eq Bool (lt m (succ d)) b
        -> Eq Bool (m <= succ j) true_
          -> ((m2: Nat) -> Eq Bool (m2 <= j) true_ -> Lt (modAcc j m2 (succ d)) (succ d))
            -> Lt (modStep d j m b) (succ d) =
  (d: Nat) => (j: Nat) => (m: Nat) => (b: Bool) => (eq: Eq Bool (lt m (succ d)) b) => (h: Eq
    Bool
    (m <= succ j)
    true_) => (ih: (m2: Nat) -> Eq Bool (m2 <= j) true_ -> Lt (modAcc j m2 (succ d)) (succ d)) => Bool.ind
    ((x: Bool) => Eq Bool (lt m (succ d)) x
    -> Eq Bool (m <= succ j) true_
      -> ((m2: Nat) -> Eq Bool (m2 <= j) true_ -> Lt (modAcc j m2 (succ d)) (succ d))
        -> Lt (modStep d j m x) (succ d))
    ((e: Eq Bool (lt m (succ d)) true_) => (g: Eq Bool (m <= succ j) true_) => (k: (m2: Nat)
    -> Eq Bool (m2 <= j) true_ -> Lt (modAcc j m2 (succ d)) (succ d)) => ltTrueLt m (succ d) e)
    ((e: Eq Bool (lt m (succ d)) false_) => (g: Eq Bool (m <= succ j) true_) => (k: (m2: Nat)
    -> Eq Bool (m2 <= j) true_ -> Lt (modAcc j m2 (succ d)) (succ d)) => k
      (sub m (succ d))
      (subSuccLeq m d j g))
    b
    eq
    h
    ih

val modAccLtSucc: (d: Nat)
-> (k: Nat) -> (m: Nat) -> Eq Bool (m <= k) true_ -> Lt (modAcc k m (succ d)) (succ d) =
  (d: Nat) => (k: Nat) => (m: Nat) => (h: Eq Bool (m <= k) true_) => Nat.ind
    ((j: Nat) => (m: Nat) -> Eq Bool (m <= j) true_ -> Lt (modAcc j m (succ d)) (succ d))
    ((m: Nat) => (h: Eq Bool (m <= zero) true_) => Nat.ind
      ((i: Nat) => Eq Bool (i <= zero) true_ -> Lt i (succ d))
      ((h0: Eq Bool (zero <= zero) true_) => ltZeroSucc d)
      ((i: Nat) => (ih: Eq Bool (i <= zero) true_ -> Lt i (succ d)) => (h1: Eq
        Bool
        (succ i <= zero)
        true_) => False.rec
        ((_: False) => Lt (succ i) (succ d))
        (trueNeFalse (symE Bool false_ true_ h1)))
      m
      h)
    ((j: Nat) => (ih: (m: Nat) -> Eq Bool (m <= j) true_ -> Lt (modAcc j m (succ d)) (succ d)) => (m: Nat) => (h: Eq
      Bool
      (m <= succ j)
      true_) => modStepLt d j m (lt m (succ d)) (refl (lt m (succ d))) h ih)
    k
    m
    h

val modLt: (m: Nat) -> (n: Nat) -> Lt zero n -> Lt (mod m n) n =
  (m: Nat) => (n: Nat) => Nat.ind
    ((k: Nat) => Lt zero k -> Lt (mod m k) k)
    ((h: Lt zero zero) => False.rec ((_: False) => Lt (mod m zero) zero) (ltZeroAbsurd h))
    ((k: Nat) => (ih: Lt zero k -> Lt (mod m k) k) => (h: Lt zero (succ k)) => modAccLtSucc
      k
      m
      m
      (leqRefl m))
    n

fun divStep(d: Nat, j: Nat, m: Nat, b: Bool): Nat = match b {
  case true_ => zero
  case false_ => succ (divAcc j (sub m (succ d)) (succ d))
}

val divAddModStep: (d: Nat)
-> (j: Nat)
  -> (m: Nat)
    -> (b: Bool)
      -> Eq Bool (lt m (succ d)) b
        -> Eq
            Nat
            (divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d))
            (sub m (succ d))
          -> Eq Nat (divStep d j m b * succ d + modStep d j m b) m =
  (d: Nat) => (j: Nat) => (m: Nat) => (b: Bool) => (eq: Eq Bool (lt m (succ d)) b) => (ih: Eq
    Nat
    (divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d))
    (sub m (succ d))) => Bool.ind
    ((x: Bool) => Eq Bool (lt m (succ d)) x
    -> Eq
        Nat
        (divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d))
        (sub m (succ d))
      -> Eq Nat (divStep d j m x * succ d + modStep d j m x) m)
    ((e: Eq Bool (lt m (succ d)) true_) => (g: Eq
      Nat
      (divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d))
      (sub m (succ d))) => refl)
    ((e: Eq Bool (lt m (succ d)) false_) => (g: Eq
      Nat
      (divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d))
      (sub m (succ d))) => transE
      Nat
      (succ d + divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d))
      (succ d + (divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d)))
      m
      (plusAssoc
        (succ d)
        (divAcc j (sub m (succ d)) (succ d) * succ d)
        (modAcc j (sub m (succ d)) (succ d)))
      (transE
        Nat
        (succ d + (divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d)))
        (succ d + sub m (succ d))
        m
        (congE
          Nat
          Nat
          ((t: Nat) => succ d + t)
          (divAcc j (sub m (succ d)) (succ d) * succ d + modAcc j (sub m (succ d)) (succ d))
          (sub m (succ d))
          g)
        (transE
          Nat
          (succ d + sub m (succ d))
          (sub m (succ d) + succ d)
          m
          (symE
            Nat
            (sub m (succ d) + succ d)
            (succ d + sub m (succ d))
            (plusComm (sub m (succ d)) (succ d)))
          (subAdd m (succ d) (ltFalseLeq m (succ d) e)))))
    b
    eq
    ih

val divAddModAcc: (d: Nat)
-> (k: Nat) -> (m: Nat) -> Eq Nat (divAcc k m (succ d) * succ d + modAcc k m (succ d)) m =
  (d: Nat) => (k: Nat) => (m: Nat) => Nat.ind
    ((j: Nat) => (m2: Nat) -> Eq Nat (divAcc j m2 (succ d) * succ d + modAcc j m2 (succ d)) m2)
    ((m2: Nat) => refl)
    ((j: Nat) => (ih: (m2: Nat) -> Eq Nat (divAcc j m2 (succ d) * succ d + modAcc j m2 (succ d)) m2) => (m2: Nat) => divAddModStep
      d
      j
      m2
      (lt m2 (succ d))
      (refl (lt m2 (succ d)))
      (ih (sub m2 (succ d))))
    k
    m

val divAddMod: (m: Nat) -> (n: Nat) -> Lt zero n -> Eq Nat (div m n * n + mod m n) m =
  (m: Nat) => (n: Nat) => Nat.ind
    ((k: Nat) => Lt zero k -> Eq Nat (div m k * k + mod m k) m)
    ((h: Lt zero zero) => False.rec
      ((_: False) => Eq Nat (div m zero * zero + mod m zero) m)
      (ltZeroAbsurd h))
    ((k: Nat) => (ih: Lt zero k -> Eq Nat (div m k * k + mod m k) m) => (h: Lt zero (succ k)) => divAddModAcc
      k
      m
      m)
    n
// --- Nat division, subtraction, and divisibility facts -------------------

val subSelf: (n: Nat) -> Eq Nat (sub n n) zero =
  (n: Nat) => Nat.ind
    ((k: Nat) => Eq Nat (sub k k) zero)
    (refl zero)
    ((k: Nat) => (ih: Eq Nat (sub k k) zero) => ih)
    n

val ltSelfFalse: (n: Nat) -> Eq Bool (lt n n) false_ =
  (n: Nat) => Nat.ind
    ((k: Nat) => Eq Bool (lt k k) false_)
    (refl false_)
    ((k: Nat) => (ih: Eq Bool (lt k k) false_) => ih)
    n

val leqZeroEq: (m: Nat) -> Eq Bool (m <= zero) true_ -> Eq Nat m zero =
  (m: Nat) => Nat.ind
    ((k: Nat) => Eq Bool (k <= zero) true_ -> Eq Nat k zero)
    ((h: Eq Bool (zero <= zero) true_) => refl zero)
    ((k: Nat) => (ih: Eq Bool (k <= zero) true_ -> Eq Nat k zero) => (h: Eq
      Bool
      (succ k <= zero)
      true_) => False.rec
      ((_: False) => Eq Nat (succ k) zero)
      (trueNeFalse (symE Bool false_ true_ h)))
    m

val modAccZeroSucc: (k: Nat) -> (d: Nat) -> Eq Nat (modAcc k zero (succ d)) zero =
  (k: Nat) => Nat.ind
    ((j: Nat) => (d: Nat) -> Eq Nat (modAcc j zero (succ d)) zero)
    ((d: Nat) => refl zero)
    ((j: Nat) => (_: (d: Nat) -> Eq Nat (modAcc j zero (succ d)) zero) => (d: Nat) => refl zero)
    k

val divAccZeroSucc: (k: Nat) -> (d: Nat) -> Eq Nat (divAcc k zero (succ d)) zero =
  (k: Nat) => Nat.ind
    ((j: Nat) => (d: Nat) -> Eq Nat (divAcc j zero (succ d)) zero)
    ((d: Nat) => refl zero)
    ((j: Nat) => (_: (d: Nat) -> Eq Nat (divAcc j zero (succ d)) zero) => (d: Nat) => refl zero)
    k

val modSelf: (n: Nat) -> Lt zero n -> Eq Nat (mod n n) zero =
  (n: Nat) => Nat.ind
    ((k: Nat) => Lt zero k -> Eq Nat (mod k k) zero)
    ((h: Lt zero zero) => False.rec ((_: False) => Eq Nat (mod zero zero) zero) (ltZeroAbsurd h))
    ((d: Nat) => (ih: Lt zero d -> Eq Nat (mod d d) zero) => (h: Lt zero (succ d)) => transE
      Nat
      (modStep d d (succ d) (lt (succ d) (succ d)))
      (modStep d d (succ d) false_)
      zero
      (congE Bool Nat (modStep d d (succ d)) (lt (succ d) (succ d)) false_ (ltSelfFalse (succ d)))
      (transE
        Nat
        (modAcc d (sub d d) (succ d))
        (modAcc d zero (succ d))
        zero
        (congE Nat Nat ((q: Nat) => modAcc d q (succ d)) (sub d d) zero (subSelf d))
        (modAccZeroSucc d d)))
    n

val divSelf: (n: Nat) -> Lt zero n -> Eq Nat (div n n) (succ zero) =
  (n: Nat) => Nat.ind
    ((k: Nat) => Lt zero k -> Eq Nat (div k k) (succ zero))
    ((h: Lt zero zero) => False.rec
      ((_: False) => Eq Nat (div zero zero) (succ zero))
      (ltZeroAbsurd h))
    ((d: Nat) => (ih: Lt zero d -> Eq Nat (div d d) (succ zero)) => (h: Lt zero (succ d)) => transE
      Nat
      (divStep d d (succ d) (lt (succ d) (succ d)))
      (divStep d d (succ d) false_)
      (succ zero)
      (congE Bool Nat (divStep d d (succ d)) (lt (succ d) (succ d)) false_ (ltSelfFalse (succ d)))
      (congE
        Nat
        Nat
        ((q: Nat) => succ q)
        (divAcc d (sub d d) (succ d))
        zero
        (transE
          Nat
          (divAcc d (sub d d) (succ d))
          (divAcc d zero (succ d))
          zero
          (congE Nat Nat ((q: Nat) => divAcc d q (succ d)) (sub d d) zero (subSelf d))
          (divAccZeroSucc d d))))
    n

val dividesToMod: (d: Nat)
-> (n: Nat) -> Eq Bool (divides (succ d) n) true_ -> Eq Nat (mod n (succ d)) zero =
  (d: Nat) => (n: Nat) => (h: Eq Bool (divides (succ d) n) true_) => leqZeroEq (mod n (succ d)) h

val modToDivides: (d: Nat)
-> (n: Nat) -> Eq Nat (mod n (succ d)) zero -> Eq Bool (divides (succ d) n) true_ =
  (d: Nat) => (n: Nat) => (h: Eq Nat (mod n (succ d)) zero) => congE
    Nat
    Bool
    ((q: Nat) => q <= zero)
    (mod n (succ d))
    zero
    h

val modOfLe: (n: Nat) -> (d: Nat) -> Eq Bool (n <= d) true_ -> Eq Nat (mod n (succ d)) n =
  (n: Nat) => Nat.ind
    ((k: Nat) => (d: Nat) -> Eq Bool (k <= d) true_ -> Eq Nat (mod k (succ d)) k)
    ((d: Nat) => (_: Eq Bool (zero <= d) true_) => refl zero)
    ((k: Nat) => (_: (d: Nat) -> Eq Bool (k <= d) true_ -> Eq Nat (mod k (succ d)) k) => (d: Nat) => (h: Eq
      Bool
      (succ k <= d)
      true_) => transE
      Nat
      (modStep d k (succ k) (lt (succ k) (succ d)))
      (modStep d k (succ k) true_)
      (succ k)
      (congE Bool Nat (modStep d k (succ k)) (lt (succ k) (succ d)) true_ h)
      (refl (succ k)))
    n

val dividesLe: (d: Nat)
-> (n: Nat) -> Lt zero n -> Eq Bool (divides (succ d) n) true_ -> Eq Bool (succ d <= n) true_ =
  (d: Nat) => (n: Nat) => (hpos: Lt zero n) => (h: Eq Bool (divides (succ d) n) true_) => Nat.ind
    ((m: Nat) => Lt zero m -> Eq Bool (divides (succ d) m) true_ -> Eq Bool (succ d <= m) true_)
    ((h0: Lt zero zero) => (_: Eq Bool (divides (succ d) zero) true_) => False.rec
      ((_: False) => Eq Bool (succ d <= zero) true_)
      (ltZeroAbsurd h0))
    ((m: Nat) => (_: Lt zero m -> Eq Bool (divides (succ d) m) true_ -> Eq Bool (succ d <= m) true_) => (_: Lt
      zero
      (succ m)) => (hbad: Eq Bool (divides (succ d) (succ m)) true_) => Bool.ind
      ((b: Bool) => Eq Bool (d <= m) b -> Eq Bool (succ d <= succ m) true_)
      ((htrue: Eq Bool (d <= m) true_) => leqSuccSucc d m htrue)
      ((hfalse: Eq Bool (d <= m) false_) => False.rec
        ((_: False) => Eq Bool (succ d <= succ m) true_)
        (succNeZero
          m
          (transE
            Nat
            (succ m)
            (mod (succ m) (succ d))
            zero
            (symE Nat (mod (succ m) (succ d)) (succ m) (modOfLe (succ m) d (leqSuccTrue d m hfalse)))
            (dividesToMod d (succ m) hbad))))
      (d <= m)
      (refl (d <= m)))
    n
    hpos
    h
// --- Nat sum order and the first division unfolded step ------------------

val subAddRight: (d: Nat) -> (x: Nat) -> Eq Nat (sub (d + x) d) x =
  (d: Nat) => Nat.ind
    ((k: Nat) => (x: Nat) -> Eq Nat (sub (k + x) k) x)
    ((x: Nat) => subZero x)
    ((k: Nat) => (ih: (x: Nat) -> Eq Nat (sub (k + x) k) x) => (x: Nat) => ih x)
    d

val leqSuccAddFalse: (b: Nat) -> (a: Nat) -> Eq Bool (succ (b + a) <= b) false_ =
  (b: Nat) => Nat.ind
    ((k: Nat) => (a: Nat) -> Eq Bool (succ (k + a) <= k) false_)
    ((a: Nat) => refl false_)
    ((k: Nat) => (ih: (a: Nat) -> Eq Bool (succ (k + a) <= k) false_) => (a: Nat) => ih a)
    b

val ltAddFalse: (b: Nat) -> (a: Nat) -> Eq Bool (lt (b + a) b) false_ =
  (b: Nat) => Nat.ind
    ((k: Nat) => (a: Nat) -> Eq Bool (lt (k + a) k) false_)
    ((a: Nat) => refl false_)
    ((k: Nat) => (_: (a: Nat) -> Eq Bool (lt (k + a) k) false_) => (a: Nat) => leqSuccAddFalse k a)
    b
// --- Nat fuel boundary and successor-order helpers -----------------------

val modAccZeroValue: (k: Nat) -> (n: Nat) -> Eq Nat (modAcc k zero n) zero =
  (k: Nat) => (n: Nat) => Nat.ind
    ((i: Nat) => Eq Nat (modAcc k zero i) zero)
    (modAccZero k zero)
    ((d: Nat) => (_: Eq Nat (modAcc k zero d) zero) => modAccZeroSucc k d)
    n

val leqSuccCases: (N: Nat)
-> (m: Nat) -> Eq Bool (m <= N) true_ -> Eq Bool (succ m <= N) false_ -> Eq Nat m N =
  (N: Nat) => Nat.ind
    ((k: Nat) => (m: Nat) -> Eq Bool (m <= k) true_ -> Eq Bool (succ m <= k) false_ -> Eq Nat m k)
    ((m: Nat) => (h: Eq Bool (m <= zero) true_) => (_: Eq Bool (succ m <= zero) false_) => leqZeroEq
      m
      h)
    ((k: Nat) => (ih: (m: Nat)
    -> Eq Bool (m <= k) true_ -> Eq Bool (succ m <= k) false_ -> Eq Nat m k) => (m: Nat) => Nat.ind
      ((i: Nat) => Eq Bool (i <= succ k) true_
      -> Eq Bool (succ i <= succ k) false_ -> Eq Nat i (succ k))
      ((_: Eq Bool (zero <= succ k) true_) => (hnot: Eq Bool (succ zero <= succ k) false_) => False.rec
        ((_: False) => Eq Nat zero (succ k))
        (trueNeFalse hnot))
      ((i: Nat) => (_: Eq Bool (i <= succ k) true_
      -> Eq Bool (succ i <= succ k) false_ -> Eq Nat i (succ k)) => (h: Eq
        Bool
        (succ i <= succ k)
        true_) => (hnot: Eq Bool (succ (succ i) <= succ k) false_) => congE
        Nat
        Nat
        ((q: Nat) => succ q)
        i
        k
        (ih i h hnot))
      m)
    N

val eqSuccOfLeq: (N: Nat)
-> (m: Nat) -> Eq Bool (m <= succ N) true_ -> Eq Bool (m <= N) false_ -> Eq Nat m (succ N) =
  (N: Nat) => (m: Nat) => Nat.ind
    ((i: Nat) => Eq Bool (i <= succ N) true_ -> Eq Bool (i <= N) false_ -> Eq Nat i (succ N))
    ((_: Eq Bool (zero <= succ N) true_) => (hN: Eq Bool (zero <= N) false_) => False.rec
      ((_: False) => Eq Nat zero (succ N))
      (trueNeFalse hN))
    ((i: Nat) => (_: Eq Bool (i <= succ N) true_ -> Eq Bool (i <= N) false_ -> Eq Nat i (succ N)) => (hS: Eq
      Bool
      (succ i <= succ N)
      true_) => (hN: Eq Bool (succ i <= N) false_) => congE
      Nat
      Nat
      ((q: Nat) => succ q)
      i
      N
      (leqSuccCases N i hS hN))
    m
// --- Nat step-branch congruences -----------------------------------------

val modStepTrueEq: (d: Nat)
-> (F: Nat) -> (G: Nat) -> (m: Nat) -> Eq Nat (modStep d F m true_) (modStep d G m true_) =
  (d: Nat) => (F: Nat) => (G: Nat) => (m: Nat) => refl m

val modStepFalseEq: (d: Nat)
-> (F: Nat)
  -> (G: Nat)
    -> (m: Nat)
      -> Eq Nat (modAcc F (sub m (succ d)) (succ d)) (modAcc G (sub m (succ d)) (succ d))
        -> Eq Nat (modStep d F m false_) (modStep d G m false_) =
  (d: Nat) => (F: Nat) => (G: Nat) => (m: Nat) => (ih: Eq
    Nat
    (modAcc F (sub m (succ d)) (succ d))
    (modAcc G (sub m (succ d)) (succ d))) => ih

val divStepTrueEq: (d: Nat)
-> (F: Nat) -> (G: Nat) -> (m: Nat) -> Eq Nat (divStep d F m true_) (divStep d G m true_) =
  (d: Nat) => (F: Nat) => (G: Nat) => (m: Nat) => refl zero

val divStepFalseEq: (d: Nat)
-> (F: Nat)
  -> (G: Nat)
    -> (m: Nat)
      -> Eq Nat (divAcc F (sub m (succ d)) (succ d)) (divAcc G (sub m (succ d)) (succ d))
        -> Eq Nat (divStep d F m false_) (divStep d G m false_) =
  (d: Nat) => (F: Nat) => (G: Nat) => (m: Nat) => (ih: Eq
    Nat
    (divAcc F (sub m (succ d)) (succ d))
    (divAcc G (sub m (succ d)) (succ d))) => congE
    Nat
    Nat
    ((q: Nat) => succ q)
    (divAcc F (sub m (succ d)) (succ d))
    (divAcc G (sub m (succ d)) (succ d))
    ih
// --- Nat fuel stability --------------------------------------------------
//
// The accumulator loops are bounded by a fuel argument. If a value fits
// under two fuels, the loops return the same result at both fuels. The
// divAcc statements fix a positive divisor, because divAcc at a zero divisor
// returns its fuel.

val modAccFuelLe: (F: Nat)
-> (G: Nat)
  -> (m: Nat)
    -> (n: Nat)
      -> Eq Bool (m <= F) true_ -> Eq Bool (m <= G) true_ -> Eq Nat (modAcc F m n) (modAcc G m n) =
  (F: Nat) => Nat.ind
    ((k: Nat) => (G: Nat)
    -> (m: Nat)
      -> (n: Nat)
        -> Eq Bool (m <= k) true_ -> Eq Bool (m <= G) true_ -> Eq Nat (modAcc k m n) (modAcc G m n))
    ((G: Nat) => (m: Nat) => (n: Nat) => (hF: Eq Bool (m <= zero) true_) => (_: Eq
      Bool
      (m <= G)
      true_) => transE
      Nat
      (modAcc zero m n)
      m
      (modAcc G m n)
      (refl m)
      (transE
        Nat
        m
        zero
        (modAcc G m n)
        (leqZeroEq m hF)
        (symE
          Nat
          (modAcc G m n)
          zero
          (transE
            Nat
            (modAcc G m n)
            (modAcc G zero n)
            zero
            (congE Nat Nat ((q: Nat) => modAcc G q n) m zero (leqZeroEq m hF))
            (modAccZeroValue G n)))))
    ((Fp: Nat) => (ih: (G: Nat)
    -> (m: Nat)
      -> (n: Nat)
        -> Eq Bool (m <= Fp) true_
          -> Eq Bool (m <= G) true_ -> Eq Nat (modAcc Fp m n) (modAcc G m n)) => (G: Nat) => (m: Nat) => (n: Nat) => Nat.ind
      ((j: Nat) => Eq Bool (j <= succ Fp) true_
      -> Eq Bool (j <= G) true_ -> Eq Nat (modAcc (succ Fp) j n) (modAcc G j n))
      ((hF: Eq Bool (zero <= succ Fp) true_) => (hG: Eq Bool (zero <= G) true_) => transE
        Nat
        (modAcc (succ Fp) zero n)
        zero
        (modAcc G zero n)
        (modAccZeroValue (succ Fp) n)
        (symE Nat (modAcc G zero n) zero (modAccZeroValue G n)))
      ((mp: Nat) => (_: Eq Bool (mp <= succ Fp) true_
      -> Eq Bool (mp <= G) true_ -> Eq Nat (modAcc (succ Fp) mp n) (modAcc G mp n)) => (hF: Eq
        Bool
        (succ mp <= succ Fp)
        true_) => (hG: Eq Bool (succ mp <= G) true_) => Nat.ind
        ((j: Nat) => Eq Nat (modAcc (succ Fp) (succ mp) j) (modAcc G (succ mp) j))
        (transE
          Nat
          (modAcc (succ Fp) (succ mp) zero)
          (succ mp)
          (modAcc G (succ mp) zero)
          (modAccZero (succ Fp) (succ mp))
          (symE Nat (modAcc G (succ mp) zero) (succ mp) (modAccZero G (succ mp))))
        ((d: Nat) => (_: Eq Nat (modAcc (succ Fp) (succ mp) d) (modAcc G (succ mp) d)) => Nat.ind
          ((g: Nat) => Eq Bool (succ mp <= g) true_
          -> Eq Nat (modAcc (succ Fp) (succ mp) (succ d)) (modAcc g (succ mp) (succ d)))
          ((hG0: Eq Bool (succ mp <= zero) true_) => False.rec
            ((_: False) => Eq
              Nat
              (modAcc (succ Fp) (succ mp) (succ d))
              (modAcc zero (succ mp) (succ d)))
            (trueNeFalse (symE Bool false_ true_ hG0)))
          ((gp: Nat) => (_: Eq Bool (succ mp <= gp) true_
          -> Eq Nat (modAcc (succ Fp) (succ mp) (succ d)) (modAcc gp (succ mp) (succ d))) => (hG2: Eq
            Bool
            (succ mp <= succ gp)
            true_) => Bool.ind
            ((x: Bool) => Eq Nat (modStep d Fp (succ mp) x) (modStep d gp (succ mp) x))
            (modStepTrueEq d Fp gp (succ mp))
            (modStepFalseEq
              d
              Fp
              gp
              (succ mp)
              (ih
                gp
                (sub (succ mp) (succ d))
                (succ d)
                (subSuccLeq (succ mp) d Fp hF)
                (subSuccLeq (succ mp) d gp hG2)))
            (lt (succ mp) (succ d)))
          G
          hG)
        n)
      m)
    F

val divAccFuelLe: (d: Nat)
-> (F: Nat)
  -> (G: Nat)
    -> (m: Nat)
      -> Eq Bool (m <= F) true_
        -> Eq Bool (m <= G) true_ -> Eq Nat (divAcc F m (succ d)) (divAcc G m (succ d)) =
  (d: Nat) => (F: Nat) => Nat.ind
    ((k: Nat) => (G: Nat)
    -> (m: Nat)
      -> Eq Bool (m <= k) true_
        -> Eq Bool (m <= G) true_ -> Eq Nat (divAcc k m (succ d)) (divAcc G m (succ d)))
    ((G: Nat) => (m: Nat) => (hF: Eq Bool (m <= zero) true_) => (_: Eq Bool (m <= G) true_) => transE
      Nat
      (divAcc zero m (succ d))
      zero
      (divAcc G m (succ d))
      (refl zero)
      (symE
        Nat
        (divAcc G m (succ d))
        zero
        (transE
          Nat
          (divAcc G m (succ d))
          (divAcc G zero (succ d))
          zero
          (congE Nat Nat ((q: Nat) => divAcc G q (succ d)) m zero (leqZeroEq m hF))
          (divAccZeroSucc G d))))
    ((Fp: Nat) => (ih: (G: Nat)
    -> (m: Nat)
      -> Eq Bool (m <= Fp) true_
        -> Eq Bool (m <= G) true_ -> Eq Nat (divAcc Fp m (succ d)) (divAcc G m (succ d))) => (G: Nat) => (m: Nat) => Nat.ind
      ((j: Nat) => Eq Bool (j <= succ Fp) true_
      -> Eq Bool (j <= G) true_ -> Eq Nat (divAcc (succ Fp) j (succ d)) (divAcc G j (succ d)))
      ((hF: Eq Bool (zero <= succ Fp) true_) => (hG: Eq Bool (zero <= G) true_) => transE
        Nat
        (divAcc (succ Fp) zero (succ d))
        zero
        (divAcc G zero (succ d))
        (refl zero)
        (symE Nat (divAcc G zero (succ d)) zero (divAccZeroSucc G d)))
      ((mp: Nat) => (_: Eq Bool (mp <= succ Fp) true_
      -> Eq Bool (mp <= G) true_ -> Eq Nat (divAcc (succ Fp) mp (succ d)) (divAcc G mp (succ d))) => (hF: Eq
        Bool
        (succ mp <= succ Fp)
        true_) => (hG: Eq Bool (succ mp <= G) true_) => Nat.ind
        ((g: Nat) => Eq Bool (succ mp <= g) true_
        -> Eq Nat (divAcc (succ Fp) (succ mp) (succ d)) (divAcc g (succ mp) (succ d)))
        ((hG0: Eq Bool (succ mp <= zero) true_) => False.rec
          ((_: False) => Eq
            Nat
            (divAcc (succ Fp) (succ mp) (succ d))
            (divAcc zero (succ mp) (succ d)))
          (trueNeFalse (symE Bool false_ true_ hG0)))
        ((gp: Nat) => (_: Eq Bool (succ mp <= gp) true_
        -> Eq Nat (divAcc (succ Fp) (succ mp) (succ d)) (divAcc gp (succ mp) (succ d))) => (hG2: Eq
          Bool
          (succ mp <= succ gp)
          true_) => Bool.ind
          ((x: Bool) => Eq Nat (divStep d Fp (succ mp) x) (divStep d gp (succ mp) x))
          (divStepTrueEq d Fp gp (succ mp))
          (divStepFalseEq
            d
            Fp
            gp
            (succ mp)
            (ih
              gp
              (sub (succ mp) (succ d))
              (subSuccLeq (succ mp) d Fp hF)
              (subSuccLeq (succ mp) d gp hG2)))
          (lt (succ mp) (succ d)))
        G
        hG)
      m)
    F

val modAccFuel: (k: Nat) -> (m: Nat) -> (n: Nat) -> Eq Nat (modAcc (k + m) m n) (modAcc m m n) =
  (k: Nat) => (m: Nat) => (n: Nat) => modAccFuelLe (k + m) m m n (leqSelfPlus m k) (leqRefl m)

val divAccFuel: (d: Nat)
-> (k: Nat) -> (m: Nat) -> Eq Nat (divAcc (k + m) m (succ d)) (divAcc m m (succ d)) =
  (d: Nat) => (k: Nat) => (m: Nat) => divAccFuelLe d (k + m) m m (leqSelfPlus m k) (leqRefl m)

val modAddSelf: (n: Nat) -> (m: Nat) -> Lt zero n -> Eq Nat (mod (n + m) n) (mod m n) =
  (n: Nat) => (m: Nat) => (h: Lt zero n) => (match n returning (h2: Lt zero n)
  -> Eq Nat (mod (n + m) n) (mod m n) {
    case zero => (h0: Lt zero zero) => False.rec
      ((_: False) => Eq Nat (mod (zero + m) zero) (mod m zero))
      (ltZeroAbsurd h0)
    case succ d => (h2: Lt zero (succ d)) => transE
      Nat
      (modAcc (succ d + m) (succ d + m) (succ d))
      (modAcc (d + m) m (succ d))
      (modAcc m m (succ d))
      (transE
        Nat
        (modAcc (succ d + m) (succ d + m) (succ d))
        (modStep d (d + m) (succ d + m) false_)
        (modAcc (d + m) m (succ d))
        (congE
          Bool
          Nat
          (modStep d (d + m) (succ d + m))
          (lt (succ d + m) (succ d))
          false_
          (ltAddFalse (succ d) m))
        (congE
          Nat
          Nat
          ((q: Nat) => modAcc (d + m) q (succ d))
          (sub (succ d + m) (succ d))
          m
          (subAddRight d m)))
      (modAccFuel d m (succ d))
  })
    h

val divAddSelf: (n: Nat) -> (m: Nat) -> Lt zero n -> Eq Nat (div (n + m) n) (succ (div m n)) =
  (n: Nat) => Nat.ind
    ((k: Nat) => (m: Nat) -> Lt zero k -> Eq Nat (div (k + m) k) (succ (div m k)))
    ((m: Nat) => (h: Lt zero zero) => False.rec
      ((_: False) => Eq Nat (div (zero + m) zero) (succ (div m zero)))
      (ltZeroAbsurd h))
    ((d: Nat) => (_: (m: Nat) -> Lt zero d -> Eq Nat (div (d + m) d) (succ (div m d))) => (m: Nat) => (_: Lt
      zero
      (succ d)) => transE
      Nat
      (divAcc (succ d + m) (succ d + m) (succ d))
      (succ (divAcc (d + m) m (succ d)))
      (succ (divAcc m m (succ d)))
      (transE
        Nat
        (divAcc (succ d + m) (succ d + m) (succ d))
        (divStep d (d + m) (succ d + m) false_)
        (succ (divAcc (d + m) m (succ d)))
        (congE
          Bool
          Nat
          (divStep d (d + m) (succ d + m))
          (lt (succ d + m) (succ d))
          false_
          (ltAddFalse (succ d) m))
        (congE
          Nat
          Nat
          ((q: Nat) => succ (divAcc (d + m) q (succ d)))
          (sub (succ d + m) (succ d))
          m
          (subAddRight d m)))
      (congE
        Nat
        Nat
        ((q: Nat) => succ q)
        (divAcc (d + m) m (succ d))
        (divAcc m m (succ d))
        (divAccFuel d d m)))
    n
// --- Well-founded accessibility for Nat -----------------------------------
//
// `Acc` takes the relation as a parameter, so accessibility is stated as
// `Acc Nat ltRel n`. The constructor supplies only the value and the
// accessibility function.

fun ltRel(a: Nat, b: Nat): Prop = Lt a b

fun natWf(n: Nat): Acc Nat ltRel n = match n {
  case zero => accIntro
    zero
    ((y: Nat) => (h: Lt y zero) => False.rec
      ((_: False) => Acc Nat ltRel y)
      (Lt.rec
        ((a: Nat) => (b: Nat) => (_: Lt a b) => Eq Nat b zero -> False)
        y
        zero
        ((n_: Nat) => (eq: Eq Nat (succ n_) zero) => succNeZero n_ eq)
        ((n_: Nat) => (m: Nat) => (k: Nat) => (_: Lt n_ m) => (_: Lt m k) => (_: Eq Nat m zero
        -> False) => (ih2: Eq Nat k zero -> False) => (eq: Eq Nat k zero) => ih2 eq)
        h
        (refl zero)))
  case succ k => accIntro (succ k) ((y: Nat) => (h: Lt y (succ k)) => natWfHelp k y h)
} and natWfHelp(k: Nat, y: Nat, h: Lt y (succ k)): Acc Nat ltRel y {struct h} = match h {
  case ltSucc y_ => natWf y_
  case ltTrans y_ m _ p1 p2 => match natWfHelp k m p2 {
    case accIntro _ f => f y_ p1
  }
}
// --- Theorems about an indexed family -----------------------------------
//
// `Vec[A] n` is length-indexed: the length lives in the type. These prove
// theorems whose *statement* depends on that index, via the dependent
// eliminator `Vec.ind` whose motive binds both the index and the vector.
// This is the part that requires elaboration, indexed-family recursion,
// and dependent motives to cohere, beyond merely computing with the type.

val vlengthIndex: (A: Type) -> (n: Nat) -> (v: Vec A n) -> Eq Nat (vlength v) n =
  (A: Type) => (n: Nat) => (v: Vec A n) => Vec.ind
    A
    ((m: Nat) => (w: Vec A m) => Eq Nat (vlength w) m)
    n
    (refl zero)
    ((k: Nat) => (x: A) => (rest: Vec A k) => (ih: Eq Nat (vlength rest) k) => cong
      ((j: Nat) => succ j)
      ih)
    v
// succInj: succ is injective

val succInj: (a: Nat) -> (b: Nat) -> Eq Nat (succ a) (succ b) -> Eq Nat a b =
  (a: Nat) => (b: Nat) => (p: Eq Nat (succ a) (succ b)) => congE
    Nat
    Nat
    ((n: Nat) => match n {
      case zero => zero
      case succ n_ => n_
    })
    (succ a)
    (succ b)
    p
// --- Well-founded induction for Nat -----------------------------------------
// strongIndImpl: well-founded induction on n, via Acc.rec over natWf.

fun strongIndImpl(n: Nat, P: Nat -> Prop, step: (n: Nat) -> ((k: Nat) -> Lt k n -> P k) -> P n): P n =
  Acc.rec
    Nat
    ltRel
    ((m: Nat) => (v: Acc Nat ltRel m) => P m)
    n
    ((x: Nat) => (f: (y: Nat) -> ltRel y x -> Acc Nat ltRel y) => (ih: (y: Nat)
    -> (h: ltRel y x) -> P y) => step x ih)
    (natWf n)

val strongInd: (P: Nat -> Prop)
-> ((n: Nat) -> ((k: Nat) -> Lt k n -> P k) -> P n) -> (n: Nat) -> P n =
  (P: Nat -> Prop) => (step: (n: Nat) -> ((k: Nat) -> Lt k n -> P k) -> P n) => (n: Nat) => strongIndImpl
    n
    P
    step
