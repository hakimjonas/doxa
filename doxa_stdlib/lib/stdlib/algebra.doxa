// Monoids, commutative monoids, and additive groups, with instances for `Nat`
// (addition and multiplication), `List` (append), and `Int` (addition and
// negation).
//
// Additive and multiplicative structures are separate classes. The instance
// table holds one dictionary per class and tuple of target heads, and search
// has no specificity preference, so one class could not hold both `plus` and
// `mult` at `Nat`. `AddMonoid` and `Monoid` give each operation its own class,
// as Lean's `AddMonoid` and `Monoid` do.
//
// The laws are ordinary dictionary fields. A law field names the operation
// projections declared before it, so `add_assoc` is stated over `add` and each
// instance proves it over that instance's operation. `AddCommMonoid`,
// `AddGroup`, and `CommMonoid` embed their monoid as a superclass dictionary,
// so a constraint `[A: AddCommMonoid]` or `[A: AddGroup]` supplies
// `AddMonoid A` by projection. The inverse field is `negate` because `neg` is
// a constructor of `Int` and class methods are global projections.
//
// `Ring` extends `AddGroup` with its own multiplicative operation and laws.
// Projections are class-qualified, so `Ring.mul` and `Monoid.mul` are distinct
// even though both classes declare a `mul` field. A bare `mul` resolves to a
// local dictionary's class, or to the only declaring class when one exists.
// The additive commutative variants, the naming pass, and default method
// bodies are not part of this module.
//
// `sum` folds a list with `add` and `azero`. `sumViaComm` takes the
// commutative constraint and uses the same fold through the derived parent
// dictionary. `double` and `negTwice` take the group constraint, and `double`
// reaches `add` through the parent dictionary. `square` multiplies a value by
// itself under a `Ring` constraint.
import "int.doxa"

import "proofs.doxa"

typeclass AddMonoid[A: Type] {
  fun add(x: A, y: A): A;
  fun azero(): A;
  fun add_assoc(x: A, y: A, z: A): Eq A (add (add x y) z) (add x (add y z));
  fun add_zero_left(x: A): Eq A (add azero x) x;
  fun add_zero_right(x: A): Eq A (add x azero) x;
}

typeclass AddCommMonoid[A: Type]: AddMonoid A {
  fun add_comm(x: A, y: A): Eq A (add x y) (add y x);
}

typeclass AddGroup[A: Type]: AddMonoid A {
  fun negate(x: A): A;
  fun add_neg_left(x: A): Eq A (add (negate x) x) azero;
  fun add_neg_right(x: A): Eq A (add x (negate x)) azero;
}

typeclass Monoid[A: Type] {
  fun mul(x: A, y: A): A;
  fun mone(): A;
  fun mul_assoc(x: A, y: A, z: A): Eq A (mul (mul x y) z) (mul x (mul y z));
  fun mul_one_left(x: A): Eq A (mul mone x) x;
  fun mul_one_right(x: A): Eq A (mul x mone) x;
}

typeclass Ring[A: Type]: AddGroup A {
  fun mul(x: A, y: A): A;
  fun mone(): A;
  fun mul_assoc(x: A, y: A, z: A): Eq A (mul (mul x y) z) (mul x (mul y z));
  fun mul_one_left(x: A): Eq A (mul mone x) x;
  fun mul_one_right(x: A): Eq A (mul x mone) x;
  fun mul_add(x: A, y: A, z: A): Eq A (mul (add x y) z) (add (mul x z) (mul y z));
  fun add_mul(x: A, y: A, z: A): Eq A (mul x (add y z)) (add (mul x y) (mul x z));
}

typeclass CommMonoid[A: Type]: Monoid A {
  fun mul_comm(x: A, y: A): Eq A (mul x y) (mul y x);
}

impl AddMonoid[Nat] {
  fun add(x: Nat, y: Nat): Nat = x + y;
  fun azero(): Nat = zero;
  fun add_assoc(x: Nat, y: Nat, z: Nat): Eq Nat (x + y + z) (x + (y + z)) = plus_assoc x y z;
  fun add_zero_left(x: Nat): Eq Nat (zero + x) x = refl x;
  fun add_zero_right(x: Nat): Eq Nat (x + zero) x = plus_zero x;
}

impl AddCommMonoid[Nat] {
  fun add_comm(x: Nat, y: Nat): Eq Nat (x + y) (y + x) = plus_comm x y;
}

impl Monoid[Nat] {
  fun mul(x: Nat, y: Nat): Nat = x * y;
  fun mone(): Nat = succ zero;
  fun mul_assoc(x: Nat, y: Nat, z: Nat): Eq Nat (x * y * z) (x * (y * z)) = mult_assoc x y z;
  fun mul_one_left(x: Nat): Eq Nat (succ zero * x) x = plus_zero x;
  fun mul_one_right(x: Nat): Eq Nat (x * succ zero) x = mult_one x;
}

impl CommMonoid[Nat] {
  fun mul_comm(x: Nat, y: Nat): Eq Nat (x * y) (y * x) = mult_comm x y;
}

impl [A: Type] AddMonoid[List A] {
  fun add(xs: List A, ys: List A): List A = append xs ys;
  fun azero(): List A = nil;
  fun add_assoc(xs: List A, ys: List A, zs: List A): Eq
    (List A)
    (append (append xs ys) zs)
    (append xs (append ys zs)) = append_assoc A xs ys zs;
  fun add_zero_left(xs: List A): Eq (List A) (append nil xs) xs = refl xs;
  fun add_zero_right(xs: List A): Eq (List A) (append xs nil) xs = append_nil A xs;
}

impl AddMonoid[Int] {
  fun add(x: Int, y: Int): Int = intPlus x y;
  fun azero(): Int = pos zero;
  fun add_assoc(x: Int, y: Int, z: Int): Eq Int (intPlus (intPlus x y) z) (intPlus x (intPlus y z)) =
    intPlus_assoc x y z;
  fun add_zero_left(x: Int): Eq Int (intPlus (pos zero) x) x = intPlus_zero_left x;
  fun add_zero_right(x: Int): Eq Int (intPlus x (pos zero)) x = intPlus_zero_right x;
}

impl AddGroup[Int] {
  fun negate(x: Int): Int = intNeg x;
  fun add_neg_left(x: Int): Eq Int (intPlus (intNeg x) x) (pos zero) = intAdd_neg_left x;
  fun add_neg_right(x: Int): Eq Int (intPlus x (intNeg x)) (pos zero) = intAdd_neg_right x;
}

impl Ring[Int] {
  fun mul(x: Int, y: Int): Int = intMult x y;
  fun mone(): Int = pos (succ zero);
  fun mul_assoc(x: Int, y: Int, z: Int): Eq Int (intMult (intMult x y) z) (intMult x (intMult y z)) =
    intMult_assoc x y z;
  fun mul_one_left(x: Int): Eq Int (intMult (pos (succ zero)) x) x = intMult_one_left x;
  fun mul_one_right(x: Int): Eq Int (intMult x (pos (succ zero))) x = intMult_one_right x;
  fun mul_add(x: Int, y: Int, z: Int): Eq
    Int
    (intMult (intPlus x y) z)
    (intPlus (intMult x z) (intMult y z)) = intMul_add x y z;
  fun add_mul(x: Int, y: Int, z: Int): Eq
    Int
    (intMult x (intPlus y z))
    (intPlus (intMult x y) (intMult x z)) = intAdd_mul x y z;
}

fun sum[A: AddMonoid](xs: List A): A = match xs {
  case nil => azero
  case cons x rest => add x (sum A rest)
}

fun sumViaComm[A: AddCommMonoid](xs: List A): A = sum A xs

fun double[A: AddGroup](x: A): A = add x x

fun negTwice[A: AddGroup](x: A): A = negate (negate x)

fun square[A: Ring](x: A): A = mul x x

val square_one: Eq Int (square Int (pos (succ zero))) (pos (succ zero)) = refl (pos (succ zero))
