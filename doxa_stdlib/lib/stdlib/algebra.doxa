// Monoids, commutative monoids, and additive groups, with instances for `Nat`
// (addition and multiplication), `List` (append), and `Int` (addition and
// negation).
//
// Additive and multiplicative structures are separate classes. The instance
// table holds one dictionary per class and tuple of target heads, and search
// has no specificity preference, so one class could not hold both `plus` and
// `multiply` at `Nat`. `AddMonoid` and `Monoid` give each operation its own class,
// as Lean's `AddMonoid` and `Monoid` do.
//
// The laws are ordinary dictionary fields. A law field names the operation
// projections declared before it, so `addAssoc` is stated over `add` and each
// instance proves it over that instance's operation. `AddCommMonoid`,
// `AddGroup`, and `CommMonoid` embed their monoid as a superclass dictionary,
// so a constraint `[A: AddCommMonoid]` or `[A: AddGroup]` supplies
// `AddMonoid A` by projection. The inverse field is `negate` because `neg` is
// a constructor of `Int` and class methods are global projections.
//
// `Ring` extends `AddGroup` with its own multiplicative operation and laws.
// Projections are class-qualified, so `Ring.multiply` and `Monoid.multiply` are distinct
// even though both classes declare a `multiply` field. A bare `multiply` resolves to a
// local dictionary's class, or to the only declaring class when one exists.
// The additive commutative variants, the naming pass, and default method
// bodies are not part of this module.
//
// `sum` folds a list with `add` and `addZero`. `sumViaComm` takes the
// commutative constraint and uses the same fold through the derived parent
// dictionary. `double` and `negTwice` take the group constraint, and `double`
// reaches `add` through the parent dictionary. `square` multiplies a value by
// itself under a `Ring` constraint.
import "int.doxa"

import "proofs.doxa"

typeclass AddMonoid[A: Type] {
  fun add(x: A, y: A): A;
  fun addZero(): A;
  fun addAssoc(x: A, y: A, z: A): Eq A (add (add x y) z) (add x (add y z));
  fun addZeroLeft(x: A): Eq A (add addZero x) x;
  fun addZeroRight(x: A): Eq A (add x addZero) x;
}

typeclass AddCommMonoid[A: Type]: AddMonoid A {
  fun addComm(x: A, y: A): Eq A (add x y) (add y x);
}

typeclass AddGroup[A: Type]: AddMonoid A {
  fun negate(x: A): A;
  fun addNegateLeft(x: A): Eq A (add (negate x) x) addZero;
  fun addNegateRight(x: A): Eq A (add x (negate x)) addZero;
}

typeclass Monoid[A: Type] {
  fun multiply(x: A, y: A): A;
  fun one(): A;
  fun multiplyAssoc(x: A, y: A, z: A): Eq A (x * y * z) (x * (y * z));
  fun multiplyOneLeft(x: A): Eq A (one * x) x;
  fun multiplyOneRight(x: A): Eq A (x * one) x;
}

typeclass Ring[A: Type]: AddGroup A {
  fun multiply(x: A, y: A): A;
  fun one(): A;
  fun multiplyAssoc(x: A, y: A, z: A): Eq A (x * y * z) (x * (y * z));
  fun multiplyOneLeft(x: A): Eq A (one * x) x;
  fun multiplyOneRight(x: A): Eq A (x * one) x;
  fun multiplyAdd(x: A, y: A, z: A): Eq A (add x y * z) (add (x * z) (y * z));
  fun addMultiply(x: A, y: A, z: A): Eq A (x * add y z) (add (x * y) (x * z));
}

typeclass CommMonoid[A: Type]: Monoid A {
  fun multiplyComm(x: A, y: A): Eq A (x * y) (y * x);
}

impl AddMonoid[Nat] {
  fun add(x: Nat, y: Nat): Nat = x + y;
  fun addZero(): Nat = zero;
  fun addAssoc(x: Nat, y: Nat, z: Nat): Eq Nat (x + y + z) (x + (y + z)) = plusAssoc x y z;
  fun addZeroLeft(x: Nat): Eq Nat (zero + x) x = refl x;
  fun addZeroRight(x: Nat): Eq Nat (x + zero) x = plusZero x;
}

impl AddCommMonoid[Nat] {
  fun addComm(x: Nat, y: Nat): Eq Nat (x + y) (y + x) = plusComm x y;
}

impl Monoid[Nat] {
  fun multiply(x: Nat, y: Nat): Nat = x * y;
  fun one(): Nat = succ zero;
  fun multiplyAssoc(x: Nat, y: Nat, z: Nat): Eq Nat (x * y * z) (x * (y * z)) = multiplyAssoc x y z;
  fun multiplyOneLeft(x: Nat): Eq Nat (succ zero * x) x = plusZero x;
  fun multiplyOneRight(x: Nat): Eq Nat (x * succ zero) x = multiplyOne x;
}

impl CommMonoid[Nat] {
  fun multiplyComm(x: Nat, y: Nat): Eq Nat (x * y) (y * x) = multiplyComm x y;
}

impl [A: Type] AddMonoid[List A] {
  fun add(xs: List A, ys: List A): List A = append xs ys;
  fun addZero(): List A = nil;
  fun addAssoc(xs: List A, ys: List A, zs: List A): Eq
    (List A)
    (append (append xs ys) zs)
    (append xs (append ys zs)) = appendAssoc A xs ys zs;
  fun addZeroLeft(xs: List A): Eq (List A) (append nil xs) xs = refl xs;
  fun addZeroRight(xs: List A): Eq (List A) (append xs nil) xs = appendNil A xs;
}

impl AddMonoid[Int] {
  fun add(x: Int, y: Int): Int = intPlus x y;
  fun addZero(): Int = pos zero;
  fun addAssoc(x: Int, y: Int, z: Int): Eq Int (intPlus (intPlus x y) z) (intPlus x (intPlus y z)) =
    intPlusAssoc x y z;
  fun addZeroLeft(x: Int): Eq Int (intPlus (pos zero) x) x = intPlusZeroLeft x;
  fun addZeroRight(x: Int): Eq Int (intPlus x (pos zero)) x = intPlusZeroRight x;
}

impl AddGroup[Int] {
  fun negate(x: Int): Int = intNegate x;
  fun addNegateLeft(x: Int): Eq Int (intPlus (intNegate x) x) (pos zero) = intAddNegateLeft x;
  fun addNegateRight(x: Int): Eq Int (intPlus x (intNegate x)) (pos zero) = intAddNegateRight x;
}

impl Ring[Int] {
  fun multiply(x: Int, y: Int): Int = intMultiply x y;
  fun one(): Int = pos (succ zero);
  fun multiplyAssoc(x: Int, y: Int, z: Int): Eq
    Int
    (intMultiply (intMultiply x y) z)
    (intMultiply x (intMultiply y z)) = intMultiplyAssoc x y z;
  fun multiplyOneLeft(x: Int): Eq Int (intMultiply (pos (succ zero)) x) x = intMultiplyOneLeft x;
  fun multiplyOneRight(x: Int): Eq Int (intMultiply x (pos (succ zero))) x = intMultiplyOneRight x;
  fun multiplyAdd(x: Int, y: Int, z: Int): Eq
    Int
    (intMultiply (intPlus x y) z)
    (intPlus (intMultiply x z) (intMultiply y z)) = intMultiplyAdd x y z;
  fun addMultiply(x: Int, y: Int, z: Int): Eq
    Int
    (intMultiply x (intPlus y z))
    (intPlus (intMultiply x y) (intMultiply x z)) = intAddMultiply x y z;
}

fun sum[A: AddMonoid](xs: List A): A = match xs {
  case nil => addZero
  case cons x rest => add x (sum A rest)
}

fun sumViaComm[A: AddCommMonoid](xs: List A): A = sum A xs

fun double[A: AddGroup](x: A): A = add x x

fun negTwice[A: AddGroup](x: A): A = negate (negate x)

fun square[A: Ring](x: A): A = x * x

val squareOne: Eq Int (square Int (pos (succ zero))) (pos (succ zero)) = refl (pos (succ zero))
