// Integers: Int = Pos Nat | Neg Nat where Pos n = n, Neg n = -(n+1).
// Zero is Pos zero, avoiding double representation of zero.
import "bool.doxa"

import "eq.doxa"

import "nat.doxa"

import "proofs.doxa"

data Int: Type {
  pos: Nat -> Int;
  neg: Nat -> Int;
}
// Helper for intPlus with mixed signs: pos n + neg m = n - (m+1)

fun intPlusHelp(n: Nat, m: Nat): Int = match n {
  case zero => neg m
  case succ n_ => match m {
    case zero => pos n_
    case succ m_ => intPlusHelp n_ m_
  }
}

fun intPlus(a: Int, b: Int): Int = match a {
  case pos n => match b {
    case pos m => pos (n + m)
    case neg m => intPlusHelp n m
  }
  case neg n => match b {
    case pos m => intPlusHelp m n
    case neg m => neg (succ (n + m))
  }
}

fun intNeg(a: Int): Int = match a {
  case pos n => match n {
    case zero => pos zero
    case succ n_ => neg n_
  }
  case neg n => pos (succ n)
}

fun intSub(a: Int, b: Int): Int = intPlus a (intNeg b)

fun intMult(a: Int, b: Int): Int = match a {
  case pos n => match b {
    case pos m => pos (n * m)
    case neg m => intNeg (pos (n * succ m))
  }
  case neg n => match b {
    case pos m => intNeg (pos (succ n * m))
    case neg m => pos (succ (n * m + n + m))
  }
}

fun intLeq(a: Int, b: Int): Bool = match a {
  case pos n => match b {
    case pos m => n <= m
    case neg _ => false_
  }
  case neg n => match b {
    case pos _ => true_
    case neg m => m <= n
  }
}

fun intAbs(a: Int): Nat = match a {
  case pos n => n
  case neg n => succ n
}

fun intSign(a: Int): Bool = match a {
  case pos _ => true_
  case neg _ => false_
}
// --- Integer division and modulo (Euclidean) ------------------------------
//
// For a divisor b with b != 0, `intDiv a b` and `intMod a b` satisfy
// `a = b * q + r` and `0 <= r < |b|`. For b = 0, `intDiv a 0 = pos zero`
// and `intMod a 0 = a`, matching the Nat conventions. The definitions
// reduce to Nat.div and Nat.mod on the magnitudes and adjust the quotient
// when the remainder is nonzero.

fun intDivNegQ(u: Nat, v: Nat): Nat = match v {
  case zero => u
  case succ _ => succ u
}

fun intModNegR(B: Nat, v: Nat): Nat = match v {
  case zero => zero
  case succ _ => sub B v
}

fun intDiv(a: Int, b: Int): Int = match b {
  case pos m => match m {
    case zero => pos zero
    case succ m_ => match a {
      case pos n => pos (div n (succ m_))
      case neg n => intNeg (pos (intDivNegQ (div (succ n) (succ m_)) (mod (succ n) (succ m_))))
    }
  }
  case neg m => match a {
    case pos n => intNeg (pos (div n (succ m)))
    case neg n => pos (intDivNegQ (div (succ n) (succ m)) (mod (succ n) (succ m)))
  }
}

fun intMod(a: Int, b: Int): Int = match b {
  case pos m => match m {
    case zero => a
    case succ m_ => match a {
      case pos n => pos (mod n (succ m_))
      case neg n => pos (intModNegR (succ m_) (mod (succ n) (succ m_)))
    }
  }
  case neg m => match a {
    case pos n => pos (mod n (succ m))
    case neg n => pos (intModNegR (succ m) (mod (succ n) (succ m)))
  }
}
// --- Lemmas ---
// intPlus_comm: a + b = b + a

val intPlus_comm: (a: Int) -> (b: Int) -> Eq Int (intPlus a b) (intPlus b a) =
  Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intPlus x y) (intPlus y x))
    ((n: Nat) => (y: Int) => Int.ind
      ((z: Int) => Eq Int (intPlus (pos n) z) (intPlus z (pos n)))
      ((m: Nat) => cong_e Nat Int ((k: Nat) => pos k) (n + m) (m + n) (plus_comm n m))
      ((m: Nat) => refl (intPlusHelp n m))
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((z: Int) => Eq Int (intPlus (neg n) z) (intPlus z (neg n)))
      ((m: Nat) => refl (intPlusHelp m n))
      ((m: Nat) => cong_e Nat Int ((k: Nat) => neg (succ k)) (n + m) (m + n) (plus_comm n m))
      y)
// intNeg_neg: neg (neg a) = a

val intNeg_neg: (a: Int) -> Eq Int (intNeg (intNeg a)) a =
  Int.ind
    ((x: Int) => Eq Int (intNeg (intNeg x)) x)
    ((n: Nat) => Nat.ind
      ((k: Nat) => Eq Int (intNeg (intNeg (pos k))) (pos k))
      (refl (pos zero))
      ((k: Nat) => (_: Eq Int (intNeg (intNeg (pos k))) (pos k)) => refl (pos (succ k)))
      n)
    ((n: Nat) => refl (neg n))
// intSign_pos: sign of positive is true

fun intSign_pos(n: Nat): Eq Bool (intSign (pos n)) true_ = refl true_
// intSign_neg: sign of negative is false

fun intSign_neg(n: Nat): Eq Bool (intSign (neg n)) false_ = refl false_
// intAbs_pos: abs of positive is n

fun intAbs_pos(n: Nat): Eq Nat (intAbs (pos n)) n = refl n
// intAbs_neg: abs of negative is succ n

fun intAbs_neg(n: Nat): Eq Nat (intAbs (neg n)) (succ n) = refl (succ n)

val intNeg_pos_zero: Eq Int (intNeg (pos zero)) (pos zero) = refl (pos zero)

val intMult_neg_intNeg: (m: Nat)
-> (u: Nat) -> Eq Int (intMult (neg m) (intNeg (pos u))) (pos (succ m * u)) =
  (m: Nat) => (u: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intMult (neg m) (intNeg (pos k))) (pos (succ m * k)))
    (trans_e
      Int
      (intNeg (pos (succ m * zero)))
      (intNeg (pos zero))
      (pos (succ m * zero))
      (cong_e Nat Int ((t: Nat) => intNeg (pos t)) (succ m * zero) zero (mult_zero (succ m)))
      (trans_e
        Int
        (intNeg (pos zero))
        (pos zero)
        (pos (succ m * zero))
        intNeg_pos_zero
        (sym_e
          Int
          (pos (succ m * zero))
          (pos zero)
          (cong_e Nat Int ((t: Nat) => pos t) (succ m * zero) zero (mult_zero (succ m))))))
    ((k: Nat) => (ih: Eq Int (intMult (neg m) (intNeg (pos k))) (pos (succ m * k))) => {
      val a: Nat = m * k + m;
      val l: Nat = succ (a + k);
      val t1: Nat = a + succ k;
      val t2: Nat = m * k + (m + succ k);
      val t3: Nat = m + succ k + m * k;
      val t4: Nat = succ k + m + m * k;
      val t5: Nat = succ k + (m + m * k);
      val e1: Eq Nat l t1 = sym_e Nat t1 l (plus_succ a k);
      val e2: Eq Nat t1 t2 = plus_assoc (m * k) m (succ k);
      val e3: Eq Nat t2 t3 = plus_comm (m * k) (m + succ k);
      val e4: Eq Nat t3 t4 = cong_e
        Nat
        Nat
        ((t: Nat) => t + m * k)
        (m + succ k)
        (succ k + m)
        (plus_comm m (succ k));
      val e5: Eq Nat t4 t5 = plus_assoc (succ k) m (m * k);
      val e6: Eq Nat t5 (succ m * succ k) = sym_e
        Nat
        (succ m * succ k)
        t5
        (cong_e Nat Nat ((t: Nat) => succ k + t) (m * succ k) (m + m * k) (mult_succ_right m k));
      val p: Eq Nat l (succ m * succ k) = trans_e
        Nat
        l
        t1
        (succ m * succ k)
        e1
        (trans_e
          Nat
          t1
          t2
          (succ m * succ k)
          e2
          (trans_e
            Nat
            t2
            t3
            (succ m * succ k)
            e3
            (trans_e Nat t3 t4 (succ m * succ k) e4 (trans_e Nat t4 t5 (succ m * succ k) e5 e6))));
      cong_e Nat Int ((t: Nat) => pos t) l (succ m * succ k) p
      })
    u

val intDivMod_pos_pos: (n: Nat)
-> (m: Nat)
  -> Eq
      Int
      (intPlus
        (intMult (pos (succ m)) (intDiv (pos n) (pos (succ m))))
        (intMod (pos n) (pos (succ m))))
      (pos n) =
  (n: Nat) => (m: Nat) => cong_e
    Nat
    Int
    ((k: Nat) => pos k)
    (succ m * div n (succ m) + mod n (succ m))
    n
    (trans_e
      Nat
      (succ m * div n (succ m) + mod n (succ m))
      (div n (succ m) * succ m + mod n (succ m))
      n
      (cong_e
        Nat
        Nat
        ((t: Nat) => t + mod n (succ m))
        (succ m * div n (succ m))
        (div n (succ m) * succ m)
        (mult_comm (succ m) (div n (succ m))))
      (div_add_mod n (succ m) (lt_zero_succ m)))

val intDivMod_pos_neg: (n: Nat)
-> (m: Nat)
  -> Eq Int (intPlus (intMult (neg m) (intDiv (pos n) (neg m))) (intMod (pos n) (neg m))) (pos n) =
  (n: Nat) => (m: Nat) => {
    val B: Nat = succ m;
    val u: Nat = div n B;
    val v: Nat = mod n B;
    val e1: Eq Int (intMult (neg m) (intDiv (pos n) (neg m))) (pos (B * u)) = intMult_neg_intNeg m u;
    val chain: Eq Nat (B * u + v) n = trans_e
      Nat
      (B * u + v)
      (u * B + v)
      n
      (cong_e Nat Nat ((t: Nat) => t + v) (B * u) (u * B) (mult_comm B u))
      (div_add_mod n B (lt_zero_succ m));
    val e2: Eq Int (intPlus (pos (B * u)) (intMod (pos n) (neg m))) (pos n) = cong_e
      Nat
      Int
      ((k: Nat) => pos k)
      (B * u + v)
      n
      chain;
    trans_e
      Int
      (intPlus (intMult (neg m) (intDiv (pos n) (neg m))) (intMod (pos n) (neg m)))
      (intPlus (pos (B * u)) (intMod (pos n) (neg m)))
      (pos n)
      (cong_e
        Int
        Int
        ((t: Int) => intPlus t (intMod (pos n) (neg m)))
        (intMult (neg m) (intDiv (pos n) (neg m)))
        (pos (B * u))
        e1)
      e2
    }

val intDivMod_pos: (n: Nat)
-> (b: Int) -> Eq Int (intPlus (intMult b (intDiv (pos n) b)) (intMod (pos n) b)) (pos n) =
  (n: Nat) => (b: Int) => Int.ind
    ((y: Int) => Eq Int (intPlus (intMult y (intDiv (pos n) y)) (intMod (pos n) y)) (pos n))
    ((m: Nat) => Nat.ind
      ((k: Nat) => Eq
        Int
        (intPlus (intMult (pos k) (intDiv (pos n) (pos k))) (intMod (pos n) (pos k)))
        (pos n))
      (refl (pos n))
      ((k: Nat) => (ih: Eq
        Int
        (intPlus (intMult (pos k) (intDiv (pos n) (pos k))) (intMod (pos n) (pos k)))
        (pos n)) => intDivMod_pos_pos n k)
      m)
    ((m: Nat) => intDivMod_pos_neg n m)
    b

val intMult_pos_intNeg: (B: Nat)
-> (k: Nat) -> Eq Int (intMult (pos B) (intNeg (pos k))) (intNeg (pos (B * k))) =
  (B: Nat) => (k: Nat) => Nat.ind
    ((i: Nat) => Eq Int (intMult (pos B) (intNeg (pos i))) (intNeg (pos (B * i))))
    (trans_e
      Int
      (pos (B * zero))
      (pos zero)
      (intNeg (pos (B * zero)))
      (cong_e Nat Int ((t: Nat) => pos t) (B * zero) zero (mult_zero B))
      (sym_e
        Int
        (intNeg (pos (B * zero)))
        (pos zero)
        (cong_e Nat Int ((t: Nat) => intNeg (pos t)) (B * zero) zero (mult_zero B))))
    ((i: Nat) => (ih: Eq Int (intMult (pos B) (intNeg (pos i))) (intNeg (pos (B * i)))) => refl
      (intNeg (pos (B * succ i))))
    k

val intPlusHelp_plus: (x: Nat) -> (y: Nat) -> Eq Int (intPlusHelp x (y + x)) (neg y) =
  (x: Nat) => (y: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intPlusHelp k (y + k)) (neg y))
    (cong_e Nat Int ((t: Nat) => neg t) (y + zero) y (plus_zero y))
    ((k: Nat) => (ih: Eq Int (intPlusHelp k (y + k)) (neg y)) => trans_e
      Int
      (intPlusHelp (succ k) (y + succ k))
      (intPlusHelp (succ k) (succ (y + k)))
      (neg y)
      (cong_e
        Nat
        Int
        ((t: Nat) => intPlusHelp (succ k) t)
        (y + succ k)
        (succ (y + k))
        (plus_succ y k))
      ih)
    x

val intDivNeg_shift_help: (n: Nat)
-> (B: Nat)
  -> (u: Nat)
    -> (v: Nat)
      -> Eq Nat (u * B + v) (succ n)
        -> Eq Bool (v <= B) true_ -> Eq Nat (B * intDivNegQ u v) (succ (n + intModNegR B v)) =
  (n: Nat) => (B: Nat) => (u: Nat) => (v: Nat) => (h: Eq Nat (u * B + v) (succ n)) => (hB: Eq
    Bool
    (v <= B)
    true_) => Nat.ind
    ((k: Nat) => Eq Nat (u * B + k) (succ n)
    -> Eq Bool (k <= B) true_ -> Eq Nat (B * intDivNegQ u k) (succ (n + intModNegR B k)))
    ((h0: Eq Nat (u * B + zero) (succ n)) => (hb0: Eq Bool (zero <= B) true_) => trans_e
      Nat
      (B * u)
      (succ n)
      (succ (n + zero))
      (trans_e
        Nat
        (B * u)
        (u * B)
        (succ n)
        (mult_comm B u)
        (trans_e
          Nat
          (u * B)
          (u * B + zero)
          (succ n)
          (sym_e Nat (u * B + zero) (u * B) (plus_zero (u * B)))
          h0))
      (cong_e Nat Nat ((t: Nat) => succ t) n (n + zero) (sym_e Nat (n + zero) n (plus_zero n))))
    ((k: Nat) => (ih: Eq Nat (u * B + k) (succ n)
    -> Eq Bool (k <= B) true_ -> Eq Nat (B * intDivNegQ u k) (succ (n + intModNegR B k))) => (h1: Eq
      Nat
      (u * B + succ k)
      (succ n)) => (hb1: Eq Bool (succ k <= B) true_) => trans_e
      Nat
      (B * succ u)
      (B + u * B)
      (succ n + sub B (succ k))
      (trans_e Nat (B * succ u) (succ u * B) (B + u * B) (mult_comm B (succ u)) (refl (B + u * B)))
      (trans_e
        Nat
        (B + u * B)
        (B + sub (succ n) (succ k))
        (succ n + sub B (succ k))
        (cong_e
          Nat
          Nat
          ((t: Nat) => B + t)
          (u * B)
          (sub (succ n) (succ k))
          (sym_e
            Nat
            (sub (succ n) (succ k))
            (u * B)
            (trans_e
              Nat
              (sub (succ n) (succ k))
              (sub (u * B + succ k) (succ k))
              (u * B)
              (sym_e
                Nat
                (sub (u * B + succ k) (succ k))
                (sub (succ n) (succ k))
                (cong_e Nat Nat ((t: Nat) => sub t (succ k)) (u * B + succ k) (succ n) h1))
              (sub_plus_self (u * B) (succ k)))))
        (plus_sub_swap
          (succ n)
          B
          (succ k)
          (trans_e
            Bool
            (succ k <= succ n)
            (succ k <= u * B + succ k)
            true_
            (sym_e
              Bool
              (succ k <= u * B + succ k)
              (succ k <= succ n)
              (cong_e Nat Bool ((t: Nat) => succ k <= t) (u * B + succ k) (succ n) h1))
            (leq_self_plus (succ k) (u * B)))
          hb1)))
    v
    h
    hB

val intDivNeg_shift: (n: Nat)
-> (m: Nat)
  -> Eq
      Nat
      (succ m * intDivNegQ (div (succ n) (succ m)) (mod (succ n) (succ m)))
      (succ (n + intModNegR (succ m) (mod (succ n) (succ m)))) =
  (n: Nat) => (m: Nat) => intDivNeg_shift_help
    n
    (succ m)
    (div (succ n) (succ m))
    (mod (succ n) (succ m))
    (div_add_mod (succ n) (succ m) (lt_zero_succ m))
    (lt_leq (mod (succ n) (succ m)) (succ m) (mod_lt (succ n) (succ m) (lt_zero_succ m)))

val intMult_neg_pos: (m: Nat)
-> (k: Nat) -> Eq Int (intMult (neg m) (pos k)) (intNeg (pos (succ m * k))) =
  (m: Nat) => (k: Nat) => refl

val intDivMod_neg_pos: (n: Nat)
-> (m: Nat)
  -> Eq
      Int
      (intPlus
        (intMult (pos (succ m)) (intDiv (neg n) (pos (succ m))))
        (intMod (neg n) (pos (succ m))))
      (neg n) =
  (n: Nat) => (m: Nat) => {
    val B: Nat = succ m;
    val k: Nat = intDivNegQ (div (succ n) B) (mod (succ n) B);
    val r: Nat = intModNegR B (mod (succ n) B);
    val e1: Eq Int (intMult (pos B) (intDiv (neg n) (pos B))) (intNeg (pos (B * k))) = intMult_pos_intNeg
      B
      k;
    val e2: Eq Int (intNeg (pos (B * k))) (intNeg (pos (succ (n + r)))) = cong_e
      Nat
      Int
      ((t: Nat) => intNeg (pos t))
      (B * k)
      (succ (n + r))
      (intDivNeg_shift n m);
    val e3: Eq Int (intPlus (intNeg (pos (succ (n + r)))) (pos r)) (neg n) = intPlusHelp_plus r n;
    trans_e
      Int
      (intPlus (intMult (pos B) (intDiv (neg n) (pos B))) (intMod (neg n) (pos B)))
      (intPlus (intNeg (pos (B * k))) (intMod (neg n) (pos B)))
      (neg n)
      (cong_e
        Int
        Int
        ((t: Int) => intPlus t (intMod (neg n) (pos B)))
        (intMult (pos B) (intDiv (neg n) (pos B)))
        (intNeg (pos (B * k)))
        e1)
      (trans_e
        Int
        (intPlus (intNeg (pos (B * k))) (intMod (neg n) (pos B)))
        (intPlus (intNeg (pos (succ (n + r)))) (intMod (neg n) (pos B)))
        (neg n)
        (cong_e
          Int
          Int
          ((t: Int) => intPlus t (intMod (neg n) (pos B)))
          (intNeg (pos (B * k)))
          (intNeg (pos (succ (n + r))))
          e2)
        e3)
    }

val intDivMod_neg_neg: (n: Nat)
-> (m: Nat)
  -> Eq Int (intPlus (intMult (neg m) (intDiv (neg n) (neg m))) (intMod (neg n) (neg m))) (neg n) =
  (n: Nat) => (m: Nat) => {
    val B: Nat = succ m;
    val k: Nat = intDivNegQ (div (succ n) B) (mod (succ n) B);
    val r: Nat = intModNegR B (mod (succ n) B);
    val e2: Eq Int (intNeg (pos (B * k))) (intNeg (pos (succ (n + r)))) = cong_e
      Nat
      Int
      ((t: Nat) => intNeg (pos t))
      (B * k)
      (succ (n + r))
      (intDivNeg_shift n m);
    val e3: Eq Int (intPlus (intNeg (pos (succ (n + r)))) (pos r)) (neg n) = intPlusHelp_plus r n;
    trans_e
      Int
      (intPlus (intMult (neg m) (intDiv (neg n) (neg m))) (intMod (neg n) (neg m)))
      (intPlus (intNeg (pos (B * k))) (intMod (neg n) (neg m)))
      (neg n)
      (cong_e
        Int
        Int
        ((t: Int) => intPlus t (intMod (neg n) (neg m)))
        (intMult (neg m) (intDiv (neg n) (neg m)))
        (intNeg (pos (B * k)))
        (intMult_neg_pos m k))
      (trans_e
        Int
        (intPlus (intNeg (pos (B * k))) (intMod (neg n) (neg m)))
        (intPlus (intNeg (pos (succ (n + r)))) (intMod (neg n) (neg m)))
        (neg n)
        (cong_e
          Int
          Int
          ((t: Int) => intPlus t (intMod (neg n) (neg m)))
          (intNeg (pos (B * k)))
          (intNeg (pos (succ (n + r))))
          e2)
        e3)
    }

val intDivMod_neg: (n: Nat)
-> (b: Int) -> Eq Int (intPlus (intMult b (intDiv (neg n) b)) (intMod (neg n) b)) (neg n) =
  (n: Nat) => (b: Int) => Int.ind
    ((y: Int) => Eq Int (intPlus (intMult y (intDiv (neg n) y)) (intMod (neg n) y)) (neg n))
    ((m: Nat) => Nat.ind
      ((k: Nat) => Eq
        Int
        (intPlus (intMult (pos k) (intDiv (neg n) (pos k))) (intMod (neg n) (pos k)))
        (neg n))
      (refl (neg n))
      ((k: Nat) => (ih: Eq
        Int
        (intPlus (intMult (pos k) (intDiv (neg n) (pos k))) (intMod (neg n) (pos k)))
        (neg n)) => intDivMod_neg_pos n k)
      m)
    ((m: Nat) => intDivMod_neg_neg n m)
    b

val intDivMod: (a: Int) -> (b: Int) -> Eq Int (intPlus (intMult b (intDiv a b)) (intMod a b)) a =
  (a: Int) => Int.ind
    ((x: Int) => (b: Int) -> Eq Int (intPlus (intMult b (intDiv x b)) (intMod x b)) x)
    ((n: Nat) => (b: Int) => intDivMod_pos n b)
    ((n: Nat) => (b: Int) => intDivMod_neg n b)
    a

val intPlus_one: (r: Nat) -> Eq Int (intPlus (pos r) (pos (succ zero))) (pos (succ r)) =
  (r: Nat) => cong_e
    Nat
    Int
    ((t: Nat) => pos t)
    (r + succ zero)
    (succ r)
    (trans_e
      Nat
      (r + succ zero)
      (succ (r + zero))
      (succ r)
      (plus_succ r zero)
      (cong_e Nat Nat ((t: Nat) => succ t) (r + zero) r (plus_zero r)))

val intModNegR_bound: (m: Nat) -> (v: Nat) -> Eq Bool (succ (intModNegR (succ m) v) <= succ m) true_ =
  (m: Nat) => (v: Nat) => Nat.ind
    ((i: Nat) => Eq Bool (succ (intModNegR (succ m) i) <= succ m) true_)
    (refl true_)
    ((i: Nat) => (ih: Eq Bool (succ (intModNegR (succ m) i) <= succ m) true_) => sub_lt_succ
      m
      (succ i)
      (lt_zero_succ i))
    v

val intMod_nonneg: (a: Int)
-> (b: Int) -> (Eq Int b (pos zero) -> False) -> Eq Bool (intLeq (pos zero) (intMod a b)) true_ =
  (a: Int) => (b: Int) => (h: Eq Int b (pos zero) -> False) => Int.ind
    ((y: Int) => (Eq Int y (pos zero) -> False) -> Eq Bool (intLeq (pos zero) (intMod a y)) true_)
    ((m: Nat) => Nat.ind
      ((j: Nat) => (Eq Int (pos j) (pos zero) -> False)
      -> Eq Bool (intLeq (pos zero) (intMod a (pos j))) true_)
      ((h0: Eq Int (pos zero) (pos zero) -> False) => False.rec
        ((_: False) => Eq Bool (intLeq (pos zero) (intMod a (pos zero))) true_)
        (h0 (refl (pos zero))))
      ((j: Nat) => (ih: (Eq Int (pos j) (pos zero) -> False)
      -> Eq Bool (intLeq (pos zero) (intMod a (pos j))) true_) => (h1: Eq
        Int
        (pos (succ j))
        (pos zero)
      -> False) => Int.ind
        ((x: Int) => Eq Bool (intLeq (pos zero) (intMod x (pos (succ j)))) true_)
        ((n: Nat) => refl true_)
        ((n: Nat) => refl true_)
        a)
      m)
    ((m: Nat) => (h0: Eq Int (neg m) (pos zero) -> False) => Int.ind
      ((x: Int) => Eq Bool (intLeq (pos zero) (intMod x (neg m))) true_)
      ((n: Nat) => refl true_)
      ((n: Nat) => refl true_)
      a)
    b
    h

val intMod_lt: (a: Int)
-> (b: Int)
  -> (Eq Int b (pos zero) -> False)
    -> Eq Bool (intLeq (intPlus (intMod a b) (pos (succ zero))) (pos (intAbs b))) true_ =
  (a: Int) => (b: Int) => (h: Eq Int b (pos zero) -> False) => Int.ind
    ((y: Int) => (Eq Int y (pos zero) -> False)
    -> Eq Bool (intLeq (intPlus (intMod a y) (pos (succ zero))) (pos (intAbs y))) true_)
    ((m: Nat) => Nat.ind
      ((j: Nat) => (Eq Int (pos j) (pos zero) -> False)
      -> Eq
          Bool
          (intLeq (intPlus (intMod a (pos j)) (pos (succ zero))) (pos (intAbs (pos j))))
          true_)
      ((h0: Eq Int (pos zero) (pos zero) -> False) => False.rec
        ((_: False) => Eq
          Bool
          (intLeq (intPlus (intMod a (pos zero)) (pos (succ zero))) (pos (intAbs (pos zero))))
          true_)
        (h0 (refl (pos zero))))
      ((j: Nat) => (ih: (Eq Int (pos j) (pos zero) -> False)
      -> Eq
          Bool
          (intLeq (intPlus (intMod a (pos j)) (pos (succ zero))) (pos (intAbs (pos j))))
          true_) => (h1: Eq Int (pos (succ j)) (pos zero) -> False) => Int.ind
        ((x: Int) => Eq
          Bool
          (intLeq
            (intPlus (intMod x (pos (succ j))) (pos (succ zero)))
            (pos (intAbs (pos (succ j)))))
          true_)
        ((n: Nat) => trans_e
          Bool
          (intLeq (intPlus (pos (mod n (succ j))) (pos (succ zero))) (pos (succ j)))
          (intLeq (pos (succ (mod n (succ j)))) (pos (succ j)))
          true_
          (cong_e
            Int
            Bool
            ((t: Int) => intLeq t (pos (succ j)))
            (intPlus (pos (mod n (succ j))) (pos (succ zero)))
            (pos (succ (mod n (succ j))))
            (intPlus_one (mod n (succ j))))
          (lt_succ_leq (mod n (succ j)) (succ j) (mod_lt n (succ j) (lt_zero_succ j))))
        ((n: Nat) => trans_e
          Bool
          (intLeq
            (intPlus (pos (intModNegR (succ j) (mod (succ n) (succ j)))) (pos (succ zero)))
            (pos (succ j)))
          (intLeq (pos (succ (intModNegR (succ j) (mod (succ n) (succ j))))) (pos (succ j)))
          true_
          (cong_e
            Int
            Bool
            ((t: Int) => intLeq t (pos (succ j)))
            (intPlus (pos (intModNegR (succ j) (mod (succ n) (succ j)))) (pos (succ zero)))
            (pos (succ (intModNegR (succ j) (mod (succ n) (succ j)))))
            (intPlus_one (intModNegR (succ j) (mod (succ n) (succ j)))))
          (intModNegR_bound j (mod (succ n) (succ j))))
        a)
      m)
    ((m: Nat) => (h0: Eq Int (neg m) (pos zero) -> False) => Int.ind
      ((x: Int) => Eq
        Bool
        (intLeq (intPlus (intMod x (neg m)) (pos (succ zero))) (pos (intAbs (neg m))))
        true_)
      ((n: Nat) => trans_e
        Bool
        (intLeq (intPlus (pos (mod n (succ m))) (pos (succ zero))) (pos (succ m)))
        (intLeq (pos (succ (mod n (succ m)))) (pos (succ m)))
        true_
        (cong_e
          Int
          Bool
          ((t: Int) => intLeq t (pos (succ m)))
          (intPlus (pos (mod n (succ m))) (pos (succ zero)))
          (pos (succ (mod n (succ m))))
          (intPlus_one (mod n (succ m))))
        (lt_succ_leq (mod n (succ m)) (succ m) (mod_lt n (succ m) (lt_zero_succ m))))
      ((n: Nat) => trans_e
        Bool
        (intLeq
          (intPlus (pos (intModNegR (succ m) (mod (succ n) (succ m)))) (pos (succ zero)))
          (pos (succ m)))
        (intLeq (pos (succ (intModNegR (succ m) (mod (succ n) (succ m))))) (pos (succ m)))
        true_
        (cong_e
          Int
          Bool
          ((t: Int) => intLeq t (pos (succ m)))
          (intPlus (pos (intModNegR (succ m) (mod (succ n) (succ m)))) (pos (succ zero)))
          (pos (succ (intModNegR (succ m) (mod (succ n) (succ m)))))
          (intPlus_one (intModNegR (succ m) (mod (succ n) (succ m)))))
        (intModNegR_bound m (mod (succ n) (succ m))))
      a)
    b
    h
// --- intPlusHelp arithmetic helpers ---------------------------------------

val intPlusHelp_shift_left: (n: Nat)
-> (x: Nat) -> (y: Nat) -> Eq Int (intPlus (pos n) (intPlusHelp x y)) (intPlusHelp (n + x) y) =
  (n: Nat) => (x: Nat) => Nat.ind
    ((k: Nat) => (y: Nat) -> Eq Int (intPlus (pos n) (intPlusHelp k y)) (intPlusHelp (n + k) y))
    ((y: Nat) => sym_e
      Int
      (intPlusHelp (n + zero) y)
      (intPlusHelp n y)
      (cong_e Nat Int ((t: Nat) => intPlusHelp t y) (n + zero) n (plus_zero n)))
    ((k: Nat) => (ih: (y: Nat) -> Eq Int (intPlus (pos n) (intPlusHelp k y)) (intPlusHelp (n + k) y)) => (y: Nat) => Nat.ind
      ((j: Nat) => Eq Int (intPlus (pos n) (intPlusHelp (succ k) j)) (intPlusHelp (n + succ k) j))
      (sym_e
        Int
        (intPlusHelp (n + succ k) zero)
        (pos (n + k))
        (cong_e Nat Int ((t: Nat) => intPlusHelp t zero) (n + succ k) (succ (n + k)) (plus_succ n k)))
      ((j: Nat) => (_: Eq
        Int
        (intPlus (pos n) (intPlusHelp (succ k) j))
        (intPlusHelp (n + succ k) j)) => trans_e
        Int
        (intPlus (pos n) (intPlusHelp k j))
        (intPlusHelp (n + k) j)
        (intPlusHelp (n + succ k) (succ j))
        (ih j)
        (sym_e
          Int
          (intPlusHelp (n + succ k) (succ j))
          (intPlusHelp (n + k) j)
          (cong_e
            Nat
            Int
            ((t: Nat) => intPlusHelp t (succ j))
            (n + succ k)
            (succ (n + k))
            (plus_succ n k))))
      y)
    x

val intPlusHelp_add_right: (x: Nat)
-> (y: Nat) -> (p: Nat) -> Eq Int (intPlus (intPlusHelp x y) (pos p)) (intPlusHelp (x + p) y) =
  (x: Nat) => Nat.ind
    ((k: Nat) => (y: Nat)
    -> (p: Nat) -> Eq Int (intPlus (intPlusHelp k y) (pos p)) (intPlusHelp (k + p) y))
    ((y: Nat) => (p: Nat) => refl (intPlusHelp p y))
    ((k: Nat) => (ih: (y: Nat)
    -> (p: Nat) -> Eq Int (intPlus (intPlusHelp k y) (pos p)) (intPlusHelp (k + p) y)) => (y: Nat) => (p: Nat) => Nat.ind
      ((j: Nat) => Eq Int (intPlus (intPlusHelp (succ k) j) (pos p)) (intPlusHelp (succ k + p) j))
      (refl (pos (k + p)))
      ((j: Nat) => (_: Eq
        Int
        (intPlus (intPlusHelp (succ k) j) (pos p))
        (intPlusHelp (succ k + p) j)) => ih j p)
      y)
    x

val intPlusHelp_neg_right: (x: Nat)
-> (y: Nat) -> (p: Nat) -> Eq Int (intPlus (intPlusHelp x y) (neg p)) (intPlusHelp x (succ (y + p))) =
  (x: Nat) => Nat.ind
    ((k: Nat) => (y: Nat)
    -> (p: Nat) -> Eq Int (intPlus (intPlusHelp k y) (neg p)) (intPlusHelp k (succ (y + p))))
    ((y: Nat) => (p: Nat) => refl (neg (succ (y + p))))
    ((k: Nat) => (ih: (y: Nat)
    -> (p: Nat) -> Eq Int (intPlus (intPlusHelp k y) (neg p)) (intPlusHelp k (succ (y + p)))) => (y: Nat) => (p: Nat) => Nat.ind
      ((j: Nat) => Eq
        Int
        (intPlus (intPlusHelp (succ k) j) (neg p))
        (intPlusHelp (succ k) (succ (j + p))))
      (refl (intPlusHelp k p))
      ((j: Nat) => (_: Eq
        Int
        (intPlus (intPlusHelp (succ k) j) (neg p))
        (intPlusHelp (succ k) (succ (j + p)))) => ih j p)
      y)
    x

val intPlusHelp_neg_shift: (n: Nat)
-> (x: Nat) -> (y: Nat) -> Eq Int (intPlus (neg n) (intPlusHelp x y)) (intPlusHelp x (succ (n + y))) =
  (n: Nat) => (x: Nat) => Nat.ind
    ((k: Nat) => (y: Nat)
    -> Eq Int (intPlus (neg n) (intPlusHelp k y)) (intPlusHelp k (succ (n + y))))
    ((y: Nat) => refl (neg (succ (n + y))))
    ((k: Nat) => (ih: (y: Nat)
    -> Eq Int (intPlus (neg n) (intPlusHelp k y)) (intPlusHelp k (succ (n + y)))) => (y: Nat) => Nat.ind
      ((j: Nat) => Eq
        Int
        (intPlus (neg n) (intPlusHelp (succ k) j))
        (intPlusHelp (succ k) (succ (n + j))))
      (sym_e
        Int
        (intPlusHelp k (n + zero))
        (intPlusHelp k n)
        (cong_e Nat Int ((t: Nat) => intPlusHelp k t) (n + zero) n (plus_zero n)))
      ((j: Nat) => (_: Eq
        Int
        (intPlus (neg n) (intPlusHelp (succ k) j))
        (intPlusHelp (succ k) (succ (n + j)))) => trans_e
        Int
        (intPlus (neg n) (intPlusHelp k j))
        (intPlusHelp k (succ (n + j)))
        (intPlusHelp (succ k) (succ (n + succ j)))
        (ih j)
        (sym_e
          Int
          (intPlusHelp k (n + succ j))
          (intPlusHelp k (succ (n + j)))
          (cong_e Nat Int ((t: Nat) => intPlusHelp k t) (n + succ j) (succ (n + j)) (plus_succ n j))))
      y)
    x
// --- Additive monoid laws --------------------------------------------------

val intPlus_zero_left: (a: Int) -> Eq Int (intPlus (pos zero) a) a =
  Int.ind
    ((x: Int) => Eq Int (intPlus (pos zero) x) x)
    ((n: Nat) => refl (pos n))
    ((n: Nat) => refl (neg n))

val intPlus_zero_right: (a: Int) -> Eq Int (intPlus a (pos zero)) a =
  Int.ind
    ((x: Int) => Eq Int (intPlus x (pos zero)) x)
    ((n: Nat) => cong_e Nat Int ((t: Nat) => pos t) (n + zero) n (plus_zero n))
    ((n: Nat) => refl (neg n))

val intPlus_assoc: (a: Int)
-> (b: Int) -> (c: Int) -> Eq Int (intPlus (intPlus a b) c) (intPlus a (intPlus b c)) =
  (a: Int) => Int.ind
    ((x: Int) => (y: Int) -> (z: Int) -> Eq Int (intPlus (intPlus x y) z) (intPlus x (intPlus y z)))
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => (z: Int)
      -> Eq Int (intPlus (intPlus (pos n) w) z) (intPlus (pos n) (intPlus w z)))
      ((m: Nat) => (z: Int) => Int.ind
        ((v: Int) => Eq
          Int
          (intPlus (intPlus (pos n) (pos m)) v)
          (intPlus (pos n) (intPlus (pos m) v)))
        ((p: Nat) => cong_e Nat Int ((t: Nat) => pos t) (n + m + p) (n + (m + p)) (plus_assoc n m p))
        ((p: Nat) => sym_e
          Int
          (intPlus (pos n) (intPlusHelp m p))
          (intPlusHelp (n + m) p)
          (intPlusHelp_shift_left n m p))
        z)
      ((m: Nat) => (z: Int) => Int.ind
        ((v: Int) => Eq
          Int
          (intPlus (intPlus (pos n) (neg m)) v)
          (intPlus (pos n) (intPlus (neg m) v)))
        ((p: Nat) => trans_e
          Int
          (intPlus (intPlusHelp n m) (pos p))
          (intPlusHelp (n + p) m)
          (intPlus (pos n) (intPlusHelp p m))
          (intPlusHelp_add_right n m p)
          (sym_e
            Int
            (intPlus (pos n) (intPlusHelp p m))
            (intPlusHelp (n + p) m)
            (intPlusHelp_shift_left n p m)))
        ((p: Nat) => intPlusHelp_neg_right n m p)
        z)
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => (z: Int)
      -> Eq Int (intPlus (intPlus (neg n) w) z) (intPlus (neg n) (intPlus w z)))
      ((m: Nat) => (z: Int) => Int.ind
        ((v: Int) => Eq
          Int
          (intPlus (intPlus (neg n) (pos m)) v)
          (intPlus (neg n) (intPlus (pos m) v)))
        ((p: Nat) => intPlusHelp_add_right m n p)
        ((p: Nat) => trans_e
          Int
          (intPlus (intPlusHelp m n) (neg p))
          (intPlusHelp m (succ (n + p)))
          (intPlus (neg n) (intPlusHelp m p))
          (intPlusHelp_neg_right m n p)
          (sym_e
            Int
            (intPlus (neg n) (intPlusHelp m p))
            (intPlusHelp m (succ (n + p)))
            (intPlusHelp_neg_shift n m p)))
        z)
      ((m: Nat) => (z: Int) => Int.ind
        ((v: Int) => Eq
          Int
          (intPlus (intPlus (neg n) (neg m)) v)
          (intPlus (neg n) (intPlus (neg m) v)))
        ((p: Nat) => sym_e
          Int
          (intPlus (neg n) (intPlusHelp p m))
          (intPlusHelp p (succ (n + m)))
          (intPlusHelp_neg_shift n p m))
        ((p: Nat) => cong_e
          Nat
          Int
          ((t: Nat) => neg (succ t))
          (succ (n + m) + p)
          (n + succ (m + p))
          (trans_e
            Nat
            (succ (n + m) + p)
            (succ (n + m + p))
            (n + succ (m + p))
            (refl (succ (n + m + p)))
            (trans_e
              Nat
              (succ (n + m + p))
              (succ (n + (m + p)))
              (n + succ (m + p))
              (cong_e Nat Nat ((t: Nat) => succ t) (n + m + p) (n + (m + p)) (plus_assoc n m p))
              (sym_e Nat (n + succ (m + p)) (succ (n + (m + p))) (plus_succ n (m + p))))))
        z)
      y)
    a
// --- Additive inverse laws -------------------------------------------------

val intPlusHelp_succ_self: (n: Nat) -> Eq Int (intPlusHelp (succ n) n) (pos zero) =
  (n: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intPlusHelp (succ k) k) (pos zero))
    (refl (pos zero))
    ((k: Nat) => (ih: Eq Int (intPlusHelp (succ k) k) (pos zero)) => ih)
    n

val intAdd_neg_left: (a: Int) -> Eq Int (intPlus (intNeg a) a) (pos zero) =
  Int.ind
    ((x: Int) => Eq Int (intPlus (intNeg x) x) (pos zero))
    ((n: Nat) => Nat.ind
      ((k: Nat) => Eq Int (intPlus (intNeg (pos k)) (pos k)) (pos zero))
      (refl (pos zero))
      ((k: Nat) => (_: Eq Int (intPlus (intNeg (pos k)) (pos k)) (pos zero)) => intPlusHelp_succ_self
        k)
      n)
    ((n: Nat) => intPlusHelp_succ_self n)

val intAdd_neg_right: (a: Int) -> Eq Int (intPlus a (intNeg a)) (pos zero) =
  (a: Int) => trans_e
    Int
    (intPlus a (intNeg a))
    (intPlus (intNeg a) a)
    (pos zero)
    (intPlus_comm a (intNeg a))
    (intAdd_neg_left a)
// --- Multiplication magnitude facts ---------------------------------------

val intSuccMult: (n: Nat) -> (m: Nat) -> Eq Nat (succ n * succ m) (succ (n * m + n + m)) =
  (n: Nat) => (m: Nat) => trans_e
    Nat
    (succ n * succ m)
    (succ m + (n + n * m))
    (succ (n * m + n + m))
    (cong_e Nat Nat ((t: Nat) => succ m + t) (n * succ m) (n + n * m) (mult_succ_right n m))
    (cong_e
      Nat
      Nat
      ((t: Nat) => succ t)
      (m + (n + n * m))
      (n * m + n + m)
      (trans_e
        Nat
        (m + (n + n * m))
        (m + n + n * m)
        (n * m + n + m)
        (sym_e Nat (m + n + n * m) (m + (n + n * m)) (plus_assoc m n (n * m)))
        (trans_e
          Nat
          (m + n + n * m)
          (n + m + n * m)
          (n * m + n + m)
          (cong_e Nat Nat ((t: Nat) => t + n * m) (m + n) (n + m) (plus_comm m n))
          (trans_e
            Nat
            (n + m + n * m)
            (n * m + (n + m))
            (n * m + n + m)
            (plus_comm (n + m) (n * m))
            (sym_e Nat (n * m + n + m) (n * m + (n + m)) (plus_assoc (n * m) n m))))))
// --- The negation laws for multiplication ---------------------------------

val intMult_neg_right: (a: Int) -> (b: Int) -> Eq Int (intMult a (intNeg b)) (intNeg (intMult a b)) =
  (a: Int) => Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intMult x (intNeg y)) (intNeg (intMult x y)))
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMult (pos n) (intNeg w)) (intNeg (intMult (pos n) w)))
      ((m: Nat) => Nat.ind
        ((k: Nat) => Eq Int (intMult (pos n) (intNeg (pos k))) (intNeg (intMult (pos n) (pos k))))
        (trans_e
          Int
          (pos (n * zero))
          (pos zero)
          (intNeg (pos (n * zero)))
          (cong_e Nat Int ((t: Nat) => pos t) (n * zero) zero (mult_zero n))
          (trans_e
            Int
            (pos zero)
            (intNeg (pos zero))
            (intNeg (pos (n * zero)))
            (sym_e Int (intNeg (pos zero)) (pos zero) intNeg_pos_zero)
            (sym_e
              Int
              (intNeg (pos (n * zero)))
              (intNeg (pos zero))
              (cong_e Nat Int ((t: Nat) => intNeg (pos t)) (n * zero) zero (mult_zero n)))))
        ((k: Nat) => (_: Eq
          Int
          (intMult (pos n) (intNeg (pos k)))
          (intNeg (intMult (pos n) (pos k)))) => refl (intNeg (pos (n * succ k))))
        m)
      ((m: Nat) => sym_e
        Int
        (intNeg (intNeg (pos (n * succ m))))
        (pos (n * succ m))
        (intNeg_neg (pos (n * succ m))))
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMult (neg n) (intNeg w)) (intNeg (intMult (neg n) w)))
      ((m: Nat) => Nat.ind
        ((k: Nat) => Eq Int (intMult (neg n) (intNeg (pos k))) (intNeg (intMult (neg n) (pos k))))
        (trans_e
          Int
          (intNeg (pos (succ n * zero)))
          (pos (succ n * zero))
          (intNeg (intNeg (pos (succ n * zero))))
          (trans_e
            Int
            (intNeg (pos (succ n * zero)))
            (pos zero)
            (pos (succ n * zero))
            (cong_e Nat Int ((t: Nat) => intNeg (pos t)) (succ n * zero) zero (mult_zero (succ n)))
            (cong_e
              Nat
              Int
              ((t: Nat) => pos t)
              zero
              (succ n * zero)
              (sym_e Nat (succ n * zero) zero (mult_zero (succ n)))))
          (sym_e
            Int
            (intNeg (intNeg (pos (succ n * zero))))
            (pos (succ n * zero))
            (intNeg_neg (pos (succ n * zero)))))
        ((k: Nat) => (_: Eq
          Int
          (intMult (neg n) (intNeg (pos k)))
          (intNeg (intMult (neg n) (pos k)))) => trans_e
          Int
          (pos (succ (n * k + n + k)))
          (pos (succ n * succ k))
          (intNeg (intNeg (pos (succ n * succ k))))
          (sym_e
            Int
            (pos (succ n * succ k))
            (pos (succ (n * k + n + k)))
            (cong_e
              Nat
              Int
              ((t: Nat) => pos t)
              (succ n * succ k)
              (succ (n * k + n + k))
              (intSuccMult n k)))
          (sym_e
            Int
            (intNeg (intNeg (pos (succ n * succ k))))
            (pos (succ n * succ k))
            (intNeg_neg (pos (succ n * succ k)))))
        m)
      ((m: Nat) => cong_e
        Nat
        Int
        ((t: Nat) => intNeg (pos t))
        (succ n * succ m)
        (succ (n * m + n + m))
        (intSuccMult n m))
      y)
    a

val intMult_neg_left: (a: Int) -> (b: Int) -> Eq Int (intMult (intNeg a) b) (intNeg (intMult a b)) =
  (a: Int) => Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intMult (intNeg x) y) (intNeg (intMult x y)))
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMult (intNeg (pos n)) w) (intNeg (intMult (pos n) w)))
      ((m: Nat) => Nat.ind
        ((k: Nat) => Eq Int (intMult (intNeg (pos k)) (pos m)) (intNeg (intMult (pos k) (pos m))))
        (refl (pos zero))
        ((k: Nat) => (_: Eq
          Int
          (intMult (intNeg (pos k)) (pos m))
          (intNeg (intMult (pos k) (pos m)))) => refl (intNeg (pos (succ k * m))))
        n)
      ((m: Nat) => Nat.ind
        ((k: Nat) => Eq Int (intMult (intNeg (pos k)) (neg m)) (intNeg (intMult (pos k) (neg m))))
        (refl (pos zero))
        ((k: Nat) => (_: Eq
          Int
          (intMult (intNeg (pos k)) (neg m))
          (intNeg (intMult (pos k) (neg m)))) => sym_e
          Int
          (pos (succ k * succ m))
          (pos (succ (k * m + k + m)))
          (cong_e
            Nat
            Int
            ((t: Nat) => pos t)
            (succ k * succ m)
            (succ (k * m + k + m))
            (intSuccMult k m)))
        n)
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMult (intNeg (neg n)) w) (intNeg (intMult (neg n) w)))
      ((m: Nat) => sym_e
        Int
        (intNeg (intNeg (pos (succ n * m))))
        (pos (succ n * m))
        (intNeg_neg (pos (succ n * m))))
      ((m: Nat) => cong_e
        Nat
        Int
        ((t: Nat) => intNeg (pos t))
        (succ n * succ m)
        (succ (n * m + n + m))
        (intSuccMult n m))
      y)
    a
// --- Multiplication by a positive integer ---------------------------------

val intMultPosZero: (z: Int) -> Eq Int (intMult (pos zero) z) (pos zero) =
  Int.ind
    ((x: Int) => Eq Int (intMult (pos zero) x) (pos zero))
    ((m: Nat) => refl (pos zero))
    ((m: Nat) => refl (pos zero))

val intPlusNegPos: (m: Nat) -> (B: Nat) -> Eq Int (intPlus (neg m) (intNeg (pos B))) (neg (m + B)) =
  (m: Nat) => (B: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intPlus (neg m) (intNeg (pos k))) (neg (m + k)))
    (sym_e
      Int
      (neg (m + zero))
      (neg m)
      (cong_e Nat Int ((t: Nat) => neg t) (m + zero) m (plus_zero m)))
    ((k: Nat) => (_: Eq Int (intPlus (neg m) (intNeg (pos k))) (neg (m + k))) => sym_e
      Int
      (neg (m + succ k))
      (neg (succ (m + k)))
      (cong_e Nat Int ((t: Nat) => neg t) (m + succ k) (succ (m + k)) (plus_succ m k)))
    B

