// Integers: Int = Pos Nat | Neg Nat where Pos n = n, Neg n = -(n+1).
// Zero is Pos zero, avoiding double representation of zero.
//
// Additive group lemmas: `intPlusAssoc`, `intPlusZeroLeft`,
// `intPlusZeroRight`, `intAddNegateLeft`, and `intAddNegateRight`, with
// `intPlusComm`, `intNegateAdd`, and `intNegateNegate` alongside. `algebra.doxa`
// uses them for its `AddMonoid[Int]` and `AddGroup[Int]` instances.
//
// Multiplicative lemmas: `intMultiplyAssoc`, `intMultiplyOneLeft`,
// `intMultiplyOneRight`, `intMultiplyAdd`, `intAddMultiply`, and `intMultiplyComm`. The
// first five are the laws a ring instance needs; `intMultiplyComm` is the
// commutativity law. This module has no ring class because `Monoid` in
// `algebra.doxa` already owns the multiplication projections.
import "bool.doxa"

import "eq.doxa"

import "nat.doxa"

import "proofs.doxa"

data Int: Type {
  pos: Nat -> Int;
  neg: Nat -> Int;
}
// Helper for intPlus with mixed signs: pos n + neg m = n - (m+1)

fun intPlusHelp(n: Nat, m: Nat): Int = match n {
  case zero => neg m
  case succ n_ => match m {
    case zero => pos n_
    case succ m_ => intPlusHelp n_ m_
  }
}

fun intPlus(a: Int, b: Int): Int = match a {
  case pos n => match b {
    case pos m => pos (n + m)
    case neg m => intPlusHelp n m
  }
  case neg n => match b {
    case pos m => intPlusHelp m n
    case neg m => neg (succ (n + m))
  }
}

fun intNegate(a: Int): Int = match a {
  case pos n => match n {
    case zero => pos zero
    case succ n_ => neg n_
  }
  case neg n => pos (succ n)
}

fun intSub(a: Int, b: Int): Int = intPlus a (intNegate b)

fun intMultiply(a: Int, b: Int): Int = match a {
  case pos n => match b {
    case pos m => pos (n * m)
    case neg m => intNegate (pos (n * succ m))
  }
  case neg n => match b {
    case pos m => intNegate (pos (succ n * m))
    case neg m => pos (succ (n * m + n + m))
  }
}

fun intLeq(a: Int, b: Int): Bool = match a {
  case pos n => match b {
    case pos m => n <= m
    case neg _ => false_
  }
  case neg n => match b {
    case pos _ => true_
    case neg m => m <= n
  }
}

fun intEqb(a: Int, b: Int): Bool = and_ (intLeq a b) (intLeq b a)

fun intAbs(a: Int): Nat = match a {
  case pos n => n
  case neg n => succ n
}

fun intSign(a: Int): Bool = match a {
  case pos _ => true_
  case neg _ => false_
}
// --- Integer division and modulo (Euclidean) ------------------------------
//
// For a divisor b with b != 0, `intDiv a b` and `intMod a b` satisfy
// `a = b * q + r` and `0 <= r < |b|`. For b = 0, `intDiv a 0 = pos zero`
// and `intMod a 0 = a`, matching the Nat conventions. The definitions
// reduce to Nat.div and Nat.mod on the magnitudes and adjust the quotient
// when the remainder is nonzero.

fun intDivNegQ(u: Nat, v: Nat): Nat = match v {
  case zero => u
  case succ _ => succ u
}

fun intModNegR(B: Nat, v: Nat): Nat = match v {
  case zero => zero
  case succ _ => sub B v
}

fun intDiv(a: Int, b: Int): Int = match b {
  case pos m => match m {
    case zero => pos zero
    case succ m_ => match a {
      case pos n => pos (div n (succ m_))
      case neg n => intNegate (pos (intDivNegQ (div (succ n) (succ m_)) (mod (succ n) (succ m_))))
    }
  }
  case neg m => match a {
    case pos n => intNegate (pos (div n (succ m)))
    case neg n => pos (intDivNegQ (div (succ n) (succ m)) (mod (succ n) (succ m)))
  }
}

fun intMod(a: Int, b: Int): Int = match b {
  case pos m => match m {
    case zero => a
    case succ m_ => match a {
      case pos n => pos (mod n (succ m_))
      case neg n => pos (intModNegR (succ m_) (mod (succ n) (succ m_)))
    }
  }
  case neg m => match a {
    case pos n => pos (mod n (succ m))
    case neg n => pos (intModNegR (succ m) (mod (succ n) (succ m)))
  }
}
// --- Lemmas ---
// intPlusComm: a + b = b + a

val intPlusComm: (a: Int) -> (b: Int) -> Eq Int (intPlus a b) (intPlus b a) =
  Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intPlus x y) (intPlus y x))
    ((n: Nat) => (y: Int) => Int.ind
      ((z: Int) => Eq Int (intPlus (pos n) z) (intPlus z (pos n)))
      ((m: Nat) => congE Nat Int ((k: Nat) => pos k) (n + m) (m + n) (plusComm n m))
      ((m: Nat) => refl (intPlusHelp n m))
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((z: Int) => Eq Int (intPlus (neg n) z) (intPlus z (neg n)))
      ((m: Nat) => refl (intPlusHelp m n))
      ((m: Nat) => congE Nat Int ((k: Nat) => neg (succ k)) (n + m) (m + n) (plusComm n m))
      y)
// intNegateNegate: neg (neg a) = a

val intNegateNegate: (a: Int) -> Eq Int (intNegate (intNegate a)) a =
  Int.ind
    ((x: Int) => Eq Int (intNegate (intNegate x)) x)
    ((n: Nat) => Nat.ind
      ((k: Nat) => Eq Int (intNegate (intNegate (pos k))) (pos k))
      (refl (pos zero))
      ((k: Nat) => (_: Eq Int (intNegate (intNegate (pos k))) (pos k)) => refl (pos (succ k)))
      n)
    ((n: Nat) => refl (neg n))
// intSignPos: sign of positive is true

fun intSignPos(n: Nat): Eq Bool (intSign (pos n)) true_ = refl true_
// intSignNeg: sign of negative is false

fun intSignNeg(n: Nat): Eq Bool (intSign (neg n)) false_ = refl false_
// intAbsPos: abs of positive is n

fun intAbsPos(n: Nat): Eq Nat (intAbs (pos n)) n = refl n
// intAbsNeg: abs of negative is succ n

fun intAbsNeg(n: Nat): Eq Nat (intAbs (neg n)) (succ n) = refl (succ n)
// intLeqRefl: a <= a

fun intLeqRefl(a: Int): Eq Bool (intLeq a a) true_ =
  Int.ind ((x: Int) => Eq Bool (intLeq x x) true_) ((n: Nat) => leqRefl n) ((n: Nat) => leqRefl n) a
// intEqbRefl: intEqb a a

fun intEqbRefl(a: Int): Eq Bool (intEqb a a) true_ =
  transE
    Bool
    (and_ (intLeq a a) (intLeq a a))
    (and_ true_ true_)
    true_
    (cong2 and_ (intLeqRefl a) (intLeqRefl a))
    (refl true_)

val intNegatePosZero: Eq Int (intNegate (pos zero)) (pos zero) = refl (pos zero)

val intMultiplyNegIntNegate: (m: Nat)
-> (u: Nat) -> Eq Int (intMultiply (neg m) (intNegate (pos u))) (pos (succ m * u)) =
  (m: Nat) => (u: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intMultiply (neg m) (intNegate (pos k))) (pos (succ m * k)))
    (transE
      Int
      (intNegate (pos (succ m * zero)))
      (intNegate (pos zero))
      (pos (succ m * zero))
      (congE Nat Int ((t: Nat) => intNegate (pos t)) (succ m * zero) zero (multiplyZero (succ m)))
      (transE
        Int
        (intNegate (pos zero))
        (pos zero)
        (pos (succ m * zero))
        intNegatePosZero
        (symE
          Int
          (pos (succ m * zero))
          (pos zero)
          (congE Nat Int ((t: Nat) => pos t) (succ m * zero) zero (multiplyZero (succ m))))))
    ((k: Nat) => (ih: Eq Int (intMultiply (neg m) (intNegate (pos k))) (pos (succ m * k))) => {
      val a: Nat = m * k + m;
      val l: Nat = succ (a + k);
      val t1: Nat = a + succ k;
      val t2: Nat = m * k + (m + succ k);
      val t3: Nat = m + succ k + m * k;
      val t4: Nat = succ k + m + m * k;
      val t5: Nat = succ k + (m + m * k);
      val e1: Eq Nat l t1 = symE Nat t1 l (plusSucc a k);
      val e2: Eq Nat t1 t2 = plusAssoc (m * k) m (succ k);
      val e3: Eq Nat t2 t3 = plusComm (m * k) (m + succ k);
      val e4: Eq Nat t3 t4 = congE
        Nat
        Nat
        ((t: Nat) => t + m * k)
        (m + succ k)
        (succ k + m)
        (plusComm m (succ k));
      val e5: Eq Nat t4 t5 = plusAssoc (succ k) m (m * k);
      val e6: Eq Nat t5 (succ m * succ k) = symE
        Nat
        (succ m * succ k)
        t5
        (congE Nat Nat ((t: Nat) => succ k + t) (m * succ k) (m + m * k) (multiplySuccRight m k));
      val p: Eq Nat l (succ m * succ k) = transE
        Nat
        l
        t1
        (succ m * succ k)
        e1
        (transE
          Nat
          t1
          t2
          (succ m * succ k)
          e2
          (transE
            Nat
            t2
            t3
            (succ m * succ k)
            e3
            (transE Nat t3 t4 (succ m * succ k) e4 (transE Nat t4 t5 (succ m * succ k) e5 e6))));
      congE Nat Int ((t: Nat) => pos t) l (succ m * succ k) p
      })
    u

val intDivModPosPos: (n: Nat)
-> (m: Nat)
  -> Eq
      Int
      (intPlus
        (intMultiply (pos (succ m)) (intDiv (pos n) (pos (succ m))))
        (intMod (pos n) (pos (succ m))))
      (pos n) =
  (n: Nat) => (m: Nat) => congE
    Nat
    Int
    ((k: Nat) => pos k)
    (succ m * div n (succ m) + mod n (succ m))
    n
    (transE
      Nat
      (succ m * div n (succ m) + mod n (succ m))
      (div n (succ m) * succ m + mod n (succ m))
      n
      (congE
        Nat
        Nat
        ((t: Nat) => t + mod n (succ m))
        (succ m * div n (succ m))
        (div n (succ m) * succ m)
        (multiplyComm (succ m) (div n (succ m))))
      (divAddMod n (succ m) (ltZeroSucc m)))

val intDivModPosNeg: (n: Nat)
-> (m: Nat)
  -> Eq
      Int
      (intPlus (intMultiply (neg m) (intDiv (pos n) (neg m))) (intMod (pos n) (neg m)))
      (pos n) =
  (n: Nat) => (m: Nat) => {
    val B: Nat = succ m;
    val u: Nat = div n B;
    val v: Nat = mod n B;
    val e1: Eq Int (intMultiply (neg m) (intDiv (pos n) (neg m))) (pos (B * u)) = intMultiplyNegIntNegate
      m
      u;
    val chain: Eq Nat (B * u + v) n = transE
      Nat
      (B * u + v)
      (u * B + v)
      n
      (congE Nat Nat ((t: Nat) => t + v) (B * u) (u * B) (multiplyComm B u))
      (divAddMod n B (ltZeroSucc m));
    val e2: Eq Int (intPlus (pos (B * u)) (intMod (pos n) (neg m))) (pos n) = congE
      Nat
      Int
      ((k: Nat) => pos k)
      (B * u + v)
      n
      chain;
    transE
      Int
      (intPlus (intMultiply (neg m) (intDiv (pos n) (neg m))) (intMod (pos n) (neg m)))
      (intPlus (pos (B * u)) (intMod (pos n) (neg m)))
      (pos n)
      (congE
        Int
        Int
        ((t: Int) => intPlus t (intMod (pos n) (neg m)))
        (intMultiply (neg m) (intDiv (pos n) (neg m)))
        (pos (B * u))
        e1)
      e2
    }

val intDivModPos: (n: Nat)
-> (b: Int) -> Eq Int (intPlus (intMultiply b (intDiv (pos n) b)) (intMod (pos n) b)) (pos n) =
  (n: Nat) => (b: Int) => Int.ind
    ((y: Int) => Eq Int (intPlus (intMultiply y (intDiv (pos n) y)) (intMod (pos n) y)) (pos n))
    ((m: Nat) => Nat.ind
      ((k: Nat) => Eq
        Int
        (intPlus (intMultiply (pos k) (intDiv (pos n) (pos k))) (intMod (pos n) (pos k)))
        (pos n))
      (refl (pos n))
      ((k: Nat) => (ih: Eq
        Int
        (intPlus (intMultiply (pos k) (intDiv (pos n) (pos k))) (intMod (pos n) (pos k)))
        (pos n)) => intDivModPosPos n k)
      m)
    ((m: Nat) => intDivModPosNeg n m)
    b

val intMultiplyPosIntNegate: (B: Nat)
-> (k: Nat) -> Eq Int (intMultiply (pos B) (intNegate (pos k))) (intNegate (pos (B * k))) =
  (B: Nat) => (k: Nat) => Nat.ind
    ((i: Nat) => Eq Int (intMultiply (pos B) (intNegate (pos i))) (intNegate (pos (B * i))))
    (transE
      Int
      (pos (B * zero))
      (pos zero)
      (intNegate (pos (B * zero)))
      (congE Nat Int ((t: Nat) => pos t) (B * zero) zero (multiplyZero B))
      (symE
        Int
        (intNegate (pos (B * zero)))
        (pos zero)
        (congE Nat Int ((t: Nat) => intNegate (pos t)) (B * zero) zero (multiplyZero B))))
    ((i: Nat) => (ih: Eq Int (intMultiply (pos B) (intNegate (pos i))) (intNegate (pos (B * i)))) => refl
      (intNegate (pos (B * succ i))))
    k

val intPlusHelpPlus: (x: Nat) -> (y: Nat) -> Eq Int (intPlusHelp x (y + x)) (neg y) =
  (x: Nat) => (y: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intPlusHelp k (y + k)) (neg y))
    (congE Nat Int ((t: Nat) => neg t) (y + zero) y (plusZero y))
    ((k: Nat) => (ih: Eq Int (intPlusHelp k (y + k)) (neg y)) => transE
      Int
      (intPlusHelp (succ k) (y + succ k))
      (intPlusHelp (succ k) (succ (y + k)))
      (neg y)
      (congE Nat Int ((t: Nat) => intPlusHelp (succ k) t) (y + succ k) (succ (y + k)) (plusSucc y k))
      ih)
    x

val intDivNegShiftHelp: (n: Nat)
-> (B: Nat)
  -> (u: Nat)
    -> (v: Nat)
      -> Eq Nat (u * B + v) (succ n)
        -> Eq Bool (v <= B) true_ -> Eq Nat (B * intDivNegQ u v) (succ (n + intModNegR B v)) =
  (n: Nat) => (B: Nat) => (u: Nat) => (v: Nat) => (h: Eq Nat (u * B + v) (succ n)) => (hB: Eq
    Bool
    (v <= B)
    true_) => Nat.ind
    ((k: Nat) => Eq Nat (u * B + k) (succ n)
    -> Eq Bool (k <= B) true_ -> Eq Nat (B * intDivNegQ u k) (succ (n + intModNegR B k)))
    ((h0: Eq Nat (u * B + zero) (succ n)) => (hb0: Eq Bool (zero <= B) true_) => transE
      Nat
      (B * u)
      (succ n)
      (succ (n + zero))
      (transE
        Nat
        (B * u)
        (u * B)
        (succ n)
        (multiplyComm B u)
        (transE
          Nat
          (u * B)
          (u * B + zero)
          (succ n)
          (symE Nat (u * B + zero) (u * B) (plusZero (u * B)))
          h0))
      (congE Nat Nat ((t: Nat) => succ t) n (n + zero) (symE Nat (n + zero) n (plusZero n))))
    ((k: Nat) => (ih: Eq Nat (u * B + k) (succ n)
    -> Eq Bool (k <= B) true_ -> Eq Nat (B * intDivNegQ u k) (succ (n + intModNegR B k))) => (h1: Eq
      Nat
      (u * B + succ k)
      (succ n)) => (hb1: Eq Bool (succ k <= B) true_) => transE
      Nat
      (B * succ u)
      (B + u * B)
      (succ n + sub B (succ k))
      (transE Nat (B * succ u) (succ u * B) (B + u * B) (multiplyComm B (succ u)) (refl (B + u * B)))
      (transE
        Nat
        (B + u * B)
        (B + sub (succ n) (succ k))
        (succ n + sub B (succ k))
        (congE
          Nat
          Nat
          ((t: Nat) => B + t)
          (u * B)
          (sub (succ n) (succ k))
          (symE
            Nat
            (sub (succ n) (succ k))
            (u * B)
            (transE
              Nat
              (sub (succ n) (succ k))
              (sub (u * B + succ k) (succ k))
              (u * B)
              (symE
                Nat
                (sub (u * B + succ k) (succ k))
                (sub (succ n) (succ k))
                (congE Nat Nat ((t: Nat) => sub t (succ k)) (u * B + succ k) (succ n) h1))
              (subPlusSelf (u * B) (succ k)))))
        (plusSubSwap
          (succ n)
          B
          (succ k)
          (transE
            Bool
            (succ k <= succ n)
            (succ k <= u * B + succ k)
            true_
            (symE
              Bool
              (succ k <= u * B + succ k)
              (succ k <= succ n)
              (congE Nat Bool ((t: Nat) => succ k <= t) (u * B + succ k) (succ n) h1))
            (leqSelfPlus (succ k) (u * B)))
          hb1)))
    v
    h
    hB

val intDivNegShift: (n: Nat)
-> (m: Nat)
  -> Eq
      Nat
      (succ m * intDivNegQ (div (succ n) (succ m)) (mod (succ n) (succ m)))
      (succ (n + intModNegR (succ m) (mod (succ n) (succ m)))) =
  (n: Nat) => (m: Nat) => intDivNegShiftHelp
    n
    (succ m)
    (div (succ n) (succ m))
    (mod (succ n) (succ m))
    (divAddMod (succ n) (succ m) (ltZeroSucc m))
    (ltLeq (mod (succ n) (succ m)) (succ m) (modLt (succ n) (succ m) (ltZeroSucc m)))

val intMultiplyNegPos: (m: Nat)
-> (k: Nat) -> Eq Int (intMultiply (neg m) (pos k)) (intNegate (pos (succ m * k))) =
  (m: Nat) => (k: Nat) => refl

val intDivModNegPos: (n: Nat)
-> (m: Nat)
  -> Eq
      Int
      (intPlus
        (intMultiply (pos (succ m)) (intDiv (neg n) (pos (succ m))))
        (intMod (neg n) (pos (succ m))))
      (neg n) =
  (n: Nat) => (m: Nat) => {
    val B: Nat = succ m;
    val k: Nat = intDivNegQ (div (succ n) B) (mod (succ n) B);
    val r: Nat = intModNegR B (mod (succ n) B);
    val e1: Eq Int (intMultiply (pos B) (intDiv (neg n) (pos B))) (intNegate (pos (B * k))) = intMultiplyPosIntNegate
      B
      k;
    val e2: Eq Int (intNegate (pos (B * k))) (intNegate (pos (succ (n + r)))) = congE
      Nat
      Int
      ((t: Nat) => intNegate (pos t))
      (B * k)
      (succ (n + r))
      (intDivNegShift n m);
    val e3: Eq Int (intPlus (intNegate (pos (succ (n + r)))) (pos r)) (neg n) = intPlusHelpPlus r n;
    transE
      Int
      (intPlus (intMultiply (pos B) (intDiv (neg n) (pos B))) (intMod (neg n) (pos B)))
      (intPlus (intNegate (pos (B * k))) (intMod (neg n) (pos B)))
      (neg n)
      (congE
        Int
        Int
        ((t: Int) => intPlus t (intMod (neg n) (pos B)))
        (intMultiply (pos B) (intDiv (neg n) (pos B)))
        (intNegate (pos (B * k)))
        e1)
      (transE
        Int
        (intPlus (intNegate (pos (B * k))) (intMod (neg n) (pos B)))
        (intPlus (intNegate (pos (succ (n + r)))) (intMod (neg n) (pos B)))
        (neg n)
        (congE
          Int
          Int
          ((t: Int) => intPlus t (intMod (neg n) (pos B)))
          (intNegate (pos (B * k)))
          (intNegate (pos (succ (n + r))))
          e2)
        e3)
    }

val intDivModNegNeg: (n: Nat)
-> (m: Nat)
  -> Eq
      Int
      (intPlus (intMultiply (neg m) (intDiv (neg n) (neg m))) (intMod (neg n) (neg m)))
      (neg n) =
  (n: Nat) => (m: Nat) => {
    val B: Nat = succ m;
    val k: Nat = intDivNegQ (div (succ n) B) (mod (succ n) B);
    val r: Nat = intModNegR B (mod (succ n) B);
    val e2: Eq Int (intNegate (pos (B * k))) (intNegate (pos (succ (n + r)))) = congE
      Nat
      Int
      ((t: Nat) => intNegate (pos t))
      (B * k)
      (succ (n + r))
      (intDivNegShift n m);
    val e3: Eq Int (intPlus (intNegate (pos (succ (n + r)))) (pos r)) (neg n) = intPlusHelpPlus r n;
    transE
      Int
      (intPlus (intMultiply (neg m) (intDiv (neg n) (neg m))) (intMod (neg n) (neg m)))
      (intPlus (intNegate (pos (B * k))) (intMod (neg n) (neg m)))
      (neg n)
      (congE
        Int
        Int
        ((t: Int) => intPlus t (intMod (neg n) (neg m)))
        (intMultiply (neg m) (intDiv (neg n) (neg m)))
        (intNegate (pos (B * k)))
        (intMultiplyNegPos m k))
      (transE
        Int
        (intPlus (intNegate (pos (B * k))) (intMod (neg n) (neg m)))
        (intPlus (intNegate (pos (succ (n + r)))) (intMod (neg n) (neg m)))
        (neg n)
        (congE
          Int
          Int
          ((t: Int) => intPlus t (intMod (neg n) (neg m)))
          (intNegate (pos (B * k)))
          (intNegate (pos (succ (n + r))))
          e2)
        e3)
    }

val intDivModNeg: (n: Nat)
-> (b: Int) -> Eq Int (intPlus (intMultiply b (intDiv (neg n) b)) (intMod (neg n) b)) (neg n) =
  (n: Nat) => (b: Int) => Int.ind
    ((y: Int) => Eq Int (intPlus (intMultiply y (intDiv (neg n) y)) (intMod (neg n) y)) (neg n))
    ((m: Nat) => Nat.ind
      ((k: Nat) => Eq
        Int
        (intPlus (intMultiply (pos k) (intDiv (neg n) (pos k))) (intMod (neg n) (pos k)))
        (neg n))
      (refl (neg n))
      ((k: Nat) => (ih: Eq
        Int
        (intPlus (intMultiply (pos k) (intDiv (neg n) (pos k))) (intMod (neg n) (pos k)))
        (neg n)) => intDivModNegPos n k)
      m)
    ((m: Nat) => intDivModNegNeg n m)
    b

val intDivMod: (a: Int) -> (b: Int) -> Eq Int (intPlus (intMultiply b (intDiv a b)) (intMod a b)) a =
  (a: Int) => Int.ind
    ((x: Int) => (b: Int) -> Eq Int (intPlus (intMultiply b (intDiv x b)) (intMod x b)) x)
    ((n: Nat) => (b: Int) => intDivModPos n b)
    ((n: Nat) => (b: Int) => intDivModNeg n b)
    a

val intPlusOne: (r: Nat) -> Eq Int (intPlus (pos r) (pos (succ zero))) (pos (succ r)) =
  (r: Nat) => congE
    Nat
    Int
    ((t: Nat) => pos t)
    (r + succ zero)
    (succ r)
    (transE
      Nat
      (r + succ zero)
      (succ (r + zero))
      (succ r)
      (plusSucc r zero)
      (congE Nat Nat ((t: Nat) => succ t) (r + zero) r (plusZero r)))

val intModNegRBound: (m: Nat) -> (v: Nat) -> Eq Bool (succ (intModNegR (succ m) v) <= succ m) true_ =
  (m: Nat) => (v: Nat) => Nat.ind
    ((i: Nat) => Eq Bool (succ (intModNegR (succ m) i) <= succ m) true_)
    (refl true_)
    ((i: Nat) => (ih: Eq Bool (succ (intModNegR (succ m) i) <= succ m) true_) => subLtSucc
      m
      (succ i)
      (ltZeroSucc i))
    v

val intModNonneg: (a: Int)
-> (b: Int) -> (Eq Int b (pos zero) -> False) -> Eq Bool (intLeq (pos zero) (intMod a b)) true_ =
  (a: Int) => (b: Int) => (h: Eq Int b (pos zero) -> False) => Int.ind
    ((y: Int) => (Eq Int y (pos zero) -> False) -> Eq Bool (intLeq (pos zero) (intMod a y)) true_)
    ((m: Nat) => Nat.ind
      ((j: Nat) => (Eq Int (pos j) (pos zero) -> False)
      -> Eq Bool (intLeq (pos zero) (intMod a (pos j))) true_)
      ((h0: Eq Int (pos zero) (pos zero) -> False) => False.rec
        ((_: False) => Eq Bool (intLeq (pos zero) (intMod a (pos zero))) true_)
        (h0 (refl (pos zero))))
      ((j: Nat) => (ih: (Eq Int (pos j) (pos zero) -> False)
      -> Eq Bool (intLeq (pos zero) (intMod a (pos j))) true_) => (h1: Eq
        Int
        (pos (succ j))
        (pos zero)
      -> False) => Int.ind
        ((x: Int) => Eq Bool (intLeq (pos zero) (intMod x (pos (succ j)))) true_)
        ((n: Nat) => refl true_)
        ((n: Nat) => refl true_)
        a)
      m)
    ((m: Nat) => (h0: Eq Int (neg m) (pos zero) -> False) => Int.ind
      ((x: Int) => Eq Bool (intLeq (pos zero) (intMod x (neg m))) true_)
      ((n: Nat) => refl true_)
      ((n: Nat) => refl true_)
      a)
    b
    h

val intModLt: (a: Int)
-> (b: Int)
  -> (Eq Int b (pos zero) -> False)
    -> Eq Bool (intLeq (intPlus (intMod a b) (pos (succ zero))) (pos (intAbs b))) true_ =
  (a: Int) => (b: Int) => (h: Eq Int b (pos zero) -> False) => Int.ind
    ((y: Int) => (Eq Int y (pos zero) -> False)
    -> Eq Bool (intLeq (intPlus (intMod a y) (pos (succ zero))) (pos (intAbs y))) true_)
    ((m: Nat) => Nat.ind
      ((j: Nat) => (Eq Int (pos j) (pos zero) -> False)
      -> Eq
          Bool
          (intLeq (intPlus (intMod a (pos j)) (pos (succ zero))) (pos (intAbs (pos j))))
          true_)
      ((h0: Eq Int (pos zero) (pos zero) -> False) => False.rec
        ((_: False) => Eq
          Bool
          (intLeq (intPlus (intMod a (pos zero)) (pos (succ zero))) (pos (intAbs (pos zero))))
          true_)
        (h0 (refl (pos zero))))
      ((j: Nat) => (ih: (Eq Int (pos j) (pos zero) -> False)
      -> Eq
          Bool
          (intLeq (intPlus (intMod a (pos j)) (pos (succ zero))) (pos (intAbs (pos j))))
          true_) => (h1: Eq Int (pos (succ j)) (pos zero) -> False) => Int.ind
        ((x: Int) => Eq
          Bool
          (intLeq
            (intPlus (intMod x (pos (succ j))) (pos (succ zero)))
            (pos (intAbs (pos (succ j)))))
          true_)
        ((n: Nat) => transE
          Bool
          (intLeq (intPlus (pos (mod n (succ j))) (pos (succ zero))) (pos (succ j)))
          (intLeq (pos (succ (mod n (succ j)))) (pos (succ j)))
          true_
          (congE
            Int
            Bool
            ((t: Int) => intLeq t (pos (succ j)))
            (intPlus (pos (mod n (succ j))) (pos (succ zero)))
            (pos (succ (mod n (succ j))))
            (intPlusOne (mod n (succ j))))
          (ltSuccLeq (mod n (succ j)) (succ j) (modLt n (succ j) (ltZeroSucc j))))
        ((n: Nat) => transE
          Bool
          (intLeq
            (intPlus (pos (intModNegR (succ j) (mod (succ n) (succ j)))) (pos (succ zero)))
            (pos (succ j)))
          (intLeq (pos (succ (intModNegR (succ j) (mod (succ n) (succ j))))) (pos (succ j)))
          true_
          (congE
            Int
            Bool
            ((t: Int) => intLeq t (pos (succ j)))
            (intPlus (pos (intModNegR (succ j) (mod (succ n) (succ j)))) (pos (succ zero)))
            (pos (succ (intModNegR (succ j) (mod (succ n) (succ j)))))
            (intPlusOne (intModNegR (succ j) (mod (succ n) (succ j)))))
          (intModNegRBound j (mod (succ n) (succ j))))
        a)
      m)
    ((m: Nat) => (h0: Eq Int (neg m) (pos zero) -> False) => Int.ind
      ((x: Int) => Eq
        Bool
        (intLeq (intPlus (intMod x (neg m)) (pos (succ zero))) (pos (intAbs (neg m))))
        true_)
      ((n: Nat) => transE
        Bool
        (intLeq (intPlus (pos (mod n (succ m))) (pos (succ zero))) (pos (succ m)))
        (intLeq (pos (succ (mod n (succ m)))) (pos (succ m)))
        true_
        (congE
          Int
          Bool
          ((t: Int) => intLeq t (pos (succ m)))
          (intPlus (pos (mod n (succ m))) (pos (succ zero)))
          (pos (succ (mod n (succ m))))
          (intPlusOne (mod n (succ m))))
        (ltSuccLeq (mod n (succ m)) (succ m) (modLt n (succ m) (ltZeroSucc m))))
      ((n: Nat) => transE
        Bool
        (intLeq
          (intPlus (pos (intModNegR (succ m) (mod (succ n) (succ m)))) (pos (succ zero)))
          (pos (succ m)))
        (intLeq (pos (succ (intModNegR (succ m) (mod (succ n) (succ m))))) (pos (succ m)))
        true_
        (congE
          Int
          Bool
          ((t: Int) => intLeq t (pos (succ m)))
          (intPlus (pos (intModNegR (succ m) (mod (succ n) (succ m)))) (pos (succ zero)))
          (pos (succ (intModNegR (succ m) (mod (succ n) (succ m)))))
          (intPlusOne (intModNegR (succ m) (mod (succ n) (succ m)))))
        (intModNegRBound m (mod (succ n) (succ m))))
      a)
    b
    h
// --- intPlusHelp arithmetic helpers ---------------------------------------

val intPlusHelpShiftLeft: (n: Nat)
-> (x: Nat) -> (y: Nat) -> Eq Int (intPlus (pos n) (intPlusHelp x y)) (intPlusHelp (n + x) y) =
  (n: Nat) => (x: Nat) => Nat.ind
    ((k: Nat) => (y: Nat) -> Eq Int (intPlus (pos n) (intPlusHelp k y)) (intPlusHelp (n + k) y))
    ((y: Nat) => symE
      Int
      (intPlusHelp (n + zero) y)
      (intPlusHelp n y)
      (congE Nat Int ((t: Nat) => intPlusHelp t y) (n + zero) n (plusZero n)))
    ((k: Nat) => (ih: (y: Nat) -> Eq Int (intPlus (pos n) (intPlusHelp k y)) (intPlusHelp (n + k) y)) => (y: Nat) => Nat.ind
      ((j: Nat) => Eq Int (intPlus (pos n) (intPlusHelp (succ k) j)) (intPlusHelp (n + succ k) j))
      (symE
        Int
        (intPlusHelp (n + succ k) zero)
        (pos (n + k))
        (congE Nat Int ((t: Nat) => intPlusHelp t zero) (n + succ k) (succ (n + k)) (plusSucc n k)))
      ((j: Nat) => (_: Eq
        Int
        (intPlus (pos n) (intPlusHelp (succ k) j))
        (intPlusHelp (n + succ k) j)) => transE
        Int
        (intPlus (pos n) (intPlusHelp k j))
        (intPlusHelp (n + k) j)
        (intPlusHelp (n + succ k) (succ j))
        (ih j)
        (symE
          Int
          (intPlusHelp (n + succ k) (succ j))
          (intPlusHelp (n + k) j)
          (congE
            Nat
            Int
            ((t: Nat) => intPlusHelp t (succ j))
            (n + succ k)
            (succ (n + k))
            (plusSucc n k))))
      y)
    x

val intPlusHelpAddRight: (x: Nat)
-> (y: Nat) -> (p: Nat) -> Eq Int (intPlus (intPlusHelp x y) (pos p)) (intPlusHelp (x + p) y) =
  (x: Nat) => Nat.ind
    ((k: Nat) => (y: Nat)
    -> (p: Nat) -> Eq Int (intPlus (intPlusHelp k y) (pos p)) (intPlusHelp (k + p) y))
    ((y: Nat) => (p: Nat) => refl (intPlusHelp p y))
    ((k: Nat) => (ih: (y: Nat)
    -> (p: Nat) -> Eq Int (intPlus (intPlusHelp k y) (pos p)) (intPlusHelp (k + p) y)) => (y: Nat) => (p: Nat) => Nat.ind
      ((j: Nat) => Eq Int (intPlus (intPlusHelp (succ k) j) (pos p)) (intPlusHelp (succ k + p) j))
      (refl (pos (k + p)))
      ((j: Nat) => (_: Eq
        Int
        (intPlus (intPlusHelp (succ k) j) (pos p))
        (intPlusHelp (succ k + p) j)) => ih j p)
      y)
    x

val intPlusHelpNegRight: (x: Nat)
-> (y: Nat) -> (p: Nat) -> Eq Int (intPlus (intPlusHelp x y) (neg p)) (intPlusHelp x (succ (y + p))) =
  (x: Nat) => Nat.ind
    ((k: Nat) => (y: Nat)
    -> (p: Nat) -> Eq Int (intPlus (intPlusHelp k y) (neg p)) (intPlusHelp k (succ (y + p))))
    ((y: Nat) => (p: Nat) => refl (neg (succ (y + p))))
    ((k: Nat) => (ih: (y: Nat)
    -> (p: Nat) -> Eq Int (intPlus (intPlusHelp k y) (neg p)) (intPlusHelp k (succ (y + p)))) => (y: Nat) => (p: Nat) => Nat.ind
      ((j: Nat) => Eq
        Int
        (intPlus (intPlusHelp (succ k) j) (neg p))
        (intPlusHelp (succ k) (succ (j + p))))
      (refl (intPlusHelp k p))
      ((j: Nat) => (_: Eq
        Int
        (intPlus (intPlusHelp (succ k) j) (neg p))
        (intPlusHelp (succ k) (succ (j + p)))) => ih j p)
      y)
    x

val intPlusHelpNegShift: (n: Nat)
-> (x: Nat) -> (y: Nat) -> Eq Int (intPlus (neg n) (intPlusHelp x y)) (intPlusHelp x (succ (n + y))) =
  (n: Nat) => (x: Nat) => Nat.ind
    ((k: Nat) => (y: Nat)
    -> Eq Int (intPlus (neg n) (intPlusHelp k y)) (intPlusHelp k (succ (n + y))))
    ((y: Nat) => refl (neg (succ (n + y))))
    ((k: Nat) => (ih: (y: Nat)
    -> Eq Int (intPlus (neg n) (intPlusHelp k y)) (intPlusHelp k (succ (n + y)))) => (y: Nat) => Nat.ind
      ((j: Nat) => Eq
        Int
        (intPlus (neg n) (intPlusHelp (succ k) j))
        (intPlusHelp (succ k) (succ (n + j))))
      (symE
        Int
        (intPlusHelp k (n + zero))
        (intPlusHelp k n)
        (congE Nat Int ((t: Nat) => intPlusHelp k t) (n + zero) n (plusZero n)))
      ((j: Nat) => (_: Eq
        Int
        (intPlus (neg n) (intPlusHelp (succ k) j))
        (intPlusHelp (succ k) (succ (n + j)))) => transE
        Int
        (intPlus (neg n) (intPlusHelp k j))
        (intPlusHelp k (succ (n + j)))
        (intPlusHelp (succ k) (succ (n + succ j)))
        (ih j)
        (symE
          Int
          (intPlusHelp k (n + succ j))
          (intPlusHelp k (succ (n + j)))
          (congE Nat Int ((t: Nat) => intPlusHelp k t) (n + succ j) (succ (n + j)) (plusSucc n j))))
      y)
    x
// --- Additive monoid laws --------------------------------------------------

val intPlusZeroLeft: (a: Int) -> Eq Int (intPlus (pos zero) a) a =
  Int.ind
    ((x: Int) => Eq Int (intPlus (pos zero) x) x)
    ((n: Nat) => refl (pos n))
    ((n: Nat) => refl (neg n))

val intPlusZeroRight: (a: Int) -> Eq Int (intPlus a (pos zero)) a =
  Int.ind
    ((x: Int) => Eq Int (intPlus x (pos zero)) x)
    ((n: Nat) => congE Nat Int ((t: Nat) => pos t) (n + zero) n (plusZero n))
    ((n: Nat) => refl (neg n))

val intPlusAssoc: (a: Int)
-> (b: Int) -> (c: Int) -> Eq Int (intPlus (intPlus a b) c) (intPlus a (intPlus b c)) =
  (a: Int) => Int.ind
    ((x: Int) => (y: Int) -> (z: Int) -> Eq Int (intPlus (intPlus x y) z) (intPlus x (intPlus y z)))
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => (z: Int)
      -> Eq Int (intPlus (intPlus (pos n) w) z) (intPlus (pos n) (intPlus w z)))
      ((m: Nat) => (z: Int) => Int.ind
        ((v: Int) => Eq
          Int
          (intPlus (intPlus (pos n) (pos m)) v)
          (intPlus (pos n) (intPlus (pos m) v)))
        ((p: Nat) => congE Nat Int ((t: Nat) => pos t) (n + m + p) (n + (m + p)) (plusAssoc n m p))
        ((p: Nat) => symE
          Int
          (intPlus (pos n) (intPlusHelp m p))
          (intPlusHelp (n + m) p)
          (intPlusHelpShiftLeft n m p))
        z)
      ((m: Nat) => (z: Int) => Int.ind
        ((v: Int) => Eq
          Int
          (intPlus (intPlus (pos n) (neg m)) v)
          (intPlus (pos n) (intPlus (neg m) v)))
        ((p: Nat) => transE
          Int
          (intPlus (intPlusHelp n m) (pos p))
          (intPlusHelp (n + p) m)
          (intPlus (pos n) (intPlusHelp p m))
          (intPlusHelpAddRight n m p)
          (symE
            Int
            (intPlus (pos n) (intPlusHelp p m))
            (intPlusHelp (n + p) m)
            (intPlusHelpShiftLeft n p m)))
        ((p: Nat) => intPlusHelpNegRight n m p)
        z)
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => (z: Int)
      -> Eq Int (intPlus (intPlus (neg n) w) z) (intPlus (neg n) (intPlus w z)))
      ((m: Nat) => (z: Int) => Int.ind
        ((v: Int) => Eq
          Int
          (intPlus (intPlus (neg n) (pos m)) v)
          (intPlus (neg n) (intPlus (pos m) v)))
        ((p: Nat) => intPlusHelpAddRight m n p)
        ((p: Nat) => transE
          Int
          (intPlus (intPlusHelp m n) (neg p))
          (intPlusHelp m (succ (n + p)))
          (intPlus (neg n) (intPlusHelp m p))
          (intPlusHelpNegRight m n p)
          (symE
            Int
            (intPlus (neg n) (intPlusHelp m p))
            (intPlusHelp m (succ (n + p)))
            (intPlusHelpNegShift n m p)))
        z)
      ((m: Nat) => (z: Int) => Int.ind
        ((v: Int) => Eq
          Int
          (intPlus (intPlus (neg n) (neg m)) v)
          (intPlus (neg n) (intPlus (neg m) v)))
        ((p: Nat) => symE
          Int
          (intPlus (neg n) (intPlusHelp p m))
          (intPlusHelp p (succ (n + m)))
          (intPlusHelpNegShift n p m))
        ((p: Nat) => congE
          Nat
          Int
          ((t: Nat) => neg (succ t))
          (succ (n + m) + p)
          (n + succ (m + p))
          (transE
            Nat
            (succ (n + m) + p)
            (succ (n + m + p))
            (n + succ (m + p))
            (refl (succ (n + m + p)))
            (transE
              Nat
              (succ (n + m + p))
              (succ (n + (m + p)))
              (n + succ (m + p))
              (congE Nat Nat ((t: Nat) => succ t) (n + m + p) (n + (m + p)) (plusAssoc n m p))
              (symE Nat (n + succ (m + p)) (succ (n + (m + p))) (plusSucc n (m + p))))))
        z)
      y)
    a
// --- Additive inverse laws -------------------------------------------------

val intPlusHelpSuccSelf: (n: Nat) -> Eq Int (intPlusHelp (succ n) n) (pos zero) =
  (n: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intPlusHelp (succ k) k) (pos zero))
    (refl (pos zero))
    ((k: Nat) => (ih: Eq Int (intPlusHelp (succ k) k) (pos zero)) => ih)
    n

val intAddNegateLeft: (a: Int) -> Eq Int (intPlus (intNegate a) a) (pos zero) =
  Int.ind
    ((x: Int) => Eq Int (intPlus (intNegate x) x) (pos zero))
    ((n: Nat) => Nat.ind
      ((k: Nat) => Eq Int (intPlus (intNegate (pos k)) (pos k)) (pos zero))
      (refl (pos zero))
      ((k: Nat) => (_: Eq Int (intPlus (intNegate (pos k)) (pos k)) (pos zero)) => intPlusHelpSuccSelf
        k)
      n)
    ((n: Nat) => intPlusHelpSuccSelf n)

val intAddNegateRight: (a: Int) -> Eq Int (intPlus a (intNegate a)) (pos zero) =
  (a: Int) => transE
    Int
    (intPlus a (intNegate a))
    (intPlus (intNegate a) a)
    (pos zero)
    (intPlusComm a (intNegate a))
    (intAddNegateLeft a)
// --- Multiplication magnitude facts ---------------------------------------

val intSuccMultiply: (n: Nat) -> (m: Nat) -> Eq Nat (succ n * succ m) (succ (n * m + n + m)) =
  (n: Nat) => (m: Nat) => transE
    Nat
    (succ n * succ m)
    (succ m + (n + n * m))
    (succ (n * m + n + m))
    (congE Nat Nat ((t: Nat) => succ m + t) (n * succ m) (n + n * m) (multiplySuccRight n m))
    (congE
      Nat
      Nat
      ((t: Nat) => succ t)
      (m + (n + n * m))
      (n * m + n + m)
      (transE
        Nat
        (m + (n + n * m))
        (m + n + n * m)
        (n * m + n + m)
        (symE Nat (m + n + n * m) (m + (n + n * m)) (plusAssoc m n (n * m)))
        (transE
          Nat
          (m + n + n * m)
          (n + m + n * m)
          (n * m + n + m)
          (congE Nat Nat ((t: Nat) => t + n * m) (m + n) (n + m) (plusComm m n))
          (transE
            Nat
            (n + m + n * m)
            (n * m + (n + m))
            (n * m + n + m)
            (plusComm (n + m) (n * m))
            (symE Nat (n * m + n + m) (n * m + (n + m)) (plusAssoc (n * m) n m))))))
// --- The negation laws for multiplication ---------------------------------

val intMultiplyNegateRight: (a: Int)
-> (b: Int) -> Eq Int (intMultiply a (intNegate b)) (intNegate (intMultiply a b)) =
  (a: Int) => Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intMultiply x (intNegate y)) (intNegate (intMultiply x y)))
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMultiply (pos n) (intNegate w)) (intNegate (intMultiply (pos n) w)))
      ((m: Nat) => Nat.ind
        ((k: Nat) => Eq
          Int
          (intMultiply (pos n) (intNegate (pos k)))
          (intNegate (intMultiply (pos n) (pos k))))
        (transE
          Int
          (pos (n * zero))
          (pos zero)
          (intNegate (pos (n * zero)))
          (congE Nat Int ((t: Nat) => pos t) (n * zero) zero (multiplyZero n))
          (transE
            Int
            (pos zero)
            (intNegate (pos zero))
            (intNegate (pos (n * zero)))
            (symE Int (intNegate (pos zero)) (pos zero) intNegatePosZero)
            (symE
              Int
              (intNegate (pos (n * zero)))
              (intNegate (pos zero))
              (congE Nat Int ((t: Nat) => intNegate (pos t)) (n * zero) zero (multiplyZero n)))))
        ((k: Nat) => (_: Eq
          Int
          (intMultiply (pos n) (intNegate (pos k)))
          (intNegate (intMultiply (pos n) (pos k)))) => refl (intNegate (pos (n * succ k))))
        m)
      ((m: Nat) => symE
        Int
        (intNegate (intNegate (pos (n * succ m))))
        (pos (n * succ m))
        (intNegateNegate (pos (n * succ m))))
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMultiply (neg n) (intNegate w)) (intNegate (intMultiply (neg n) w)))
      ((m: Nat) => Nat.ind
        ((k: Nat) => Eq
          Int
          (intMultiply (neg n) (intNegate (pos k)))
          (intNegate (intMultiply (neg n) (pos k))))
        (transE
          Int
          (intNegate (pos (succ n * zero)))
          (pos (succ n * zero))
          (intNegate (intNegate (pos (succ n * zero))))
          (transE
            Int
            (intNegate (pos (succ n * zero)))
            (pos zero)
            (pos (succ n * zero))
            (congE
              Nat
              Int
              ((t: Nat) => intNegate (pos t))
              (succ n * zero)
              zero
              (multiplyZero (succ n)))
            (congE
              Nat
              Int
              ((t: Nat) => pos t)
              zero
              (succ n * zero)
              (symE Nat (succ n * zero) zero (multiplyZero (succ n)))))
          (symE
            Int
            (intNegate (intNegate (pos (succ n * zero))))
            (pos (succ n * zero))
            (intNegateNegate (pos (succ n * zero)))))
        ((k: Nat) => (_: Eq
          Int
          (intMultiply (neg n) (intNegate (pos k)))
          (intNegate (intMultiply (neg n) (pos k)))) => transE
          Int
          (pos (succ (n * k + n + k)))
          (pos (succ n * succ k))
          (intNegate (intNegate (pos (succ n * succ k))))
          (symE
            Int
            (pos (succ n * succ k))
            (pos (succ (n * k + n + k)))
            (congE
              Nat
              Int
              ((t: Nat) => pos t)
              (succ n * succ k)
              (succ (n * k + n + k))
              (intSuccMultiply n k)))
          (symE
            Int
            (intNegate (intNegate (pos (succ n * succ k))))
            (pos (succ n * succ k))
            (intNegateNegate (pos (succ n * succ k)))))
        m)
      ((m: Nat) => congE
        Nat
        Int
        ((t: Nat) => intNegate (pos t))
        (succ n * succ m)
        (succ (n * m + n + m))
        (intSuccMultiply n m))
      y)
    a

val intMultiplyNegateLeft: (a: Int)
-> (b: Int) -> Eq Int (intMultiply (intNegate a) b) (intNegate (intMultiply a b)) =
  (a: Int) => Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intMultiply (intNegate x) y) (intNegate (intMultiply x y)))
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMultiply (intNegate (pos n)) w) (intNegate (intMultiply (pos n) w)))
      ((m: Nat) => Nat.ind
        ((k: Nat) => Eq
          Int
          (intMultiply (intNegate (pos k)) (pos m))
          (intNegate (intMultiply (pos k) (pos m))))
        (refl (pos zero))
        ((k: Nat) => (_: Eq
          Int
          (intMultiply (intNegate (pos k)) (pos m))
          (intNegate (intMultiply (pos k) (pos m)))) => refl (intNegate (pos (succ k * m))))
        n)
      ((m: Nat) => Nat.ind
        ((k: Nat) => Eq
          Int
          (intMultiply (intNegate (pos k)) (neg m))
          (intNegate (intMultiply (pos k) (neg m))))
        (refl (pos zero))
        ((k: Nat) => (_: Eq
          Int
          (intMultiply (intNegate (pos k)) (neg m))
          (intNegate (intMultiply (pos k) (neg m)))) => symE
          Int
          (pos (succ k * succ m))
          (pos (succ (k * m + k + m)))
          (congE
            Nat
            Int
            ((t: Nat) => pos t)
            (succ k * succ m)
            (succ (k * m + k + m))
            (intSuccMultiply k m)))
        n)
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMultiply (intNegate (neg n)) w) (intNegate (intMultiply (neg n) w)))
      ((m: Nat) => symE
        Int
        (intNegate (intNegate (pos (succ n * m))))
        (pos (succ n * m))
        (intNegateNegate (pos (succ n * m))))
      ((m: Nat) => congE
        Nat
        Int
        ((t: Nat) => intNegate (pos t))
        (succ n * succ m)
        (succ (n * m + n + m))
        (intSuccMultiply n m))
      y)
    a
// --- Multiplication by a positive integer ---------------------------------

val intMultiplyPosZero: (z: Int) -> Eq Int (intMultiply (pos zero) z) (pos zero) =
  Int.ind
    ((x: Int) => Eq Int (intMultiply (pos zero) x) (pos zero))
    ((m: Nat) => refl (pos zero))
    ((m: Nat) => refl (pos zero))

val intPlusNegPos: (m: Nat)
-> (B: Nat) -> Eq Int (intPlus (neg m) (intNegate (pos B))) (neg (m + B)) =
  (m: Nat) => (B: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intPlus (neg m) (intNegate (pos k))) (neg (m + k)))
    (symE Int (neg (m + zero)) (neg m) (congE Nat Int ((t: Nat) => neg t) (m + zero) m (plusZero m)))
    ((k: Nat) => (_: Eq Int (intPlus (neg m) (intNegate (pos k))) (neg (m + k))) => symE
      Int
      (neg (m + succ k))
      (neg (succ (m + k)))
      (congE Nat Int ((t: Nat) => neg t) (m + succ k) (succ (m + k)) (plusSucc m k)))
    B

val intMultiplyPosStep: (k: Nat)
-> (z: Int) -> Eq Int (intMultiply (pos (succ k)) z) (intPlus z (intMultiply (pos k) z)) =
  (k: Nat) => (z: Int) => Int.ind
    ((x: Int) => Eq Int (intMultiply (pos (succ k)) x) (intPlus x (intMultiply (pos k) x)))
    ((m: Nat) => refl (pos (m + k * m)))
    ((m: Nat) => symE
      Int
      (intPlus (neg m) (intNegate (pos (k * succ m))))
      (neg (m + k * succ m))
      (intPlusNegPos m (k * succ m)))
    z

val intMultiplyPosSum: (n1: Nat)
-> (n2: Nat)
  -> (z: Int)
    -> Eq
        Int
        (intMultiply (pos (n1 + n2)) z)
        (intPlus (intMultiply (pos n1) z) (intMultiply (pos n2) z)) =
  (n1: Nat) => Nat.ind
    ((k: Nat) => (n2: Nat)
    -> (z: Int)
      -> Eq
          Int
          (intMultiply (pos (k + n2)) z)
          (intPlus (intMultiply (pos k) z) (intMultiply (pos n2) z)))
    ((n2: Nat) => (z: Int) => {
      val f: Eq
        Int
        (intPlus (intMultiply (pos zero) z) (intMultiply (pos n2) z))
        (intMultiply (pos n2) z) = transE
        Int
        (intPlus (intMultiply (pos zero) z) (intMultiply (pos n2) z))
        (intPlus (pos zero) (intMultiply (pos n2) z))
        (intMultiply (pos n2) z)
        (congE
          Int
          Int
          ((t: Int) => intPlus t (intMultiply (pos n2) z))
          (intMultiply (pos zero) z)
          (pos zero)
          (intMultiplyPosZero z))
        (intPlusZeroLeft (intMultiply (pos n2) z));
      symE
        Int
        (intPlus (intMultiply (pos zero) z) (intMultiply (pos n2) z))
        (intMultiply (pos n2) z)
        f
      })
    ((k: Nat) => (ih: (n2: Nat)
    -> (z: Int)
      -> Eq
          Int
          (intMultiply (pos (k + n2)) z)
          (intPlus (intMultiply (pos k) z) (intMultiply (pos n2) z))) => (n2: Nat) => (z: Int) => {
      val e1: Eq Int (intMultiply (pos (succ k + n2)) z) (intPlus z (intMultiply (pos (k + n2)) z)) = intMultiplyPosStep
        (k + n2)
        z;
      val e2: Eq
        Int
        (intPlus z (intMultiply (pos (k + n2)) z))
        (intPlus z (intPlus (intMultiply (pos k) z) (intMultiply (pos n2) z))) = congE
        Int
        Int
        ((t: Int) => intPlus z t)
        (intMultiply (pos (k + n2)) z)
        (intPlus (intMultiply (pos k) z) (intMultiply (pos n2) z))
        (ih n2 z);
      val e3: Eq
        Int
        (intPlus z (intPlus (intMultiply (pos k) z) (intMultiply (pos n2) z)))
        (intPlus (intPlus z (intMultiply (pos k) z)) (intMultiply (pos n2) z)) = symE
        Int
        (intPlus (intPlus z (intMultiply (pos k) z)) (intMultiply (pos n2) z))
        (intPlus z (intPlus (intMultiply (pos k) z) (intMultiply (pos n2) z)))
        (intPlusAssoc z (intMultiply (pos k) z) (intMultiply (pos n2) z));
      val e4: Eq
        Int
        (intPlus (intPlus z (intMultiply (pos k) z)) (intMultiply (pos n2) z))
        (intPlus (intMultiply (pos (succ k)) z) (intMultiply (pos n2) z)) = congE
        Int
        Int
        ((t: Int) => intPlus t (intMultiply (pos n2) z))
        (intPlus z (intMultiply (pos k) z))
        (intMultiply (pos (succ k)) z)
        (symE
          Int
          (intMultiply (pos (succ k)) z)
          (intPlus z (intMultiply (pos k) z))
          (intMultiplyPosStep k z));
      transE
        Int
        (intMultiply (pos (succ k + n2)) z)
        (intPlus (intPlus z (intMultiply (pos k) z)) (intMultiply (pos n2) z))
        (intPlus (intMultiply (pos (succ k)) z) (intMultiply (pos n2) z))
        (transE
          Int
          (intMultiply (pos (succ k + n2)) z)
          (intPlus z (intPlus (intMultiply (pos k) z) (intMultiply (pos n2) z)))
          (intPlus (intPlus z (intMultiply (pos k) z)) (intMultiply (pos n2) z))
          (transE
            Int
            (intMultiply (pos (succ k + n2)) z)
            (intPlus z (intMultiply (pos (k + n2)) z))
            (intPlus z (intPlus (intMultiply (pos k) z) (intMultiply (pos n2) z)))
            e1
            e2)
          e3)
        e4
      })
    n1

val intMultiplyPosAssoc: (n: Nat)
-> (m: Nat)
  -> (z: Int) -> Eq Int (intMultiply (pos n) (intMultiply (pos m) z)) (intMultiply (pos (n * m)) z) =
  (n: Nat) => Nat.ind
    ((k: Nat) => (m: Nat)
    -> (z: Int)
      -> Eq Int (intMultiply (pos k) (intMultiply (pos m) z)) (intMultiply (pos (k * m)) z))
    ((m: Nat) => (z: Int) => transE
      Int
      (intMultiply (pos zero) (intMultiply (pos m) z))
      (pos zero)
      (intMultiply (pos (zero * m)) z)
      (intMultiplyPosZero (intMultiply (pos m) z))
      (symE Int (intMultiply (pos (zero * m)) z) (pos zero) (intMultiplyPosZero z)))
    ((k: Nat) => (ih: (m: Nat)
    -> (z: Int)
      -> Eq Int (intMultiply (pos k) (intMultiply (pos m) z)) (intMultiply (pos (k * m)) z)) => (m: Nat) => (z: Int) => {
      val e1: Eq
        Int
        (intMultiply (pos (succ k)) (intMultiply (pos m) z))
        (intPlus (intMultiply (pos m) z) (intMultiply (pos k) (intMultiply (pos m) z))) = intMultiplyPosStep
        k
        (intMultiply (pos m) z);
      val e2: Eq
        Int
        (intPlus (intMultiply (pos m) z) (intMultiply (pos k) (intMultiply (pos m) z)))
        (intPlus (intMultiply (pos m) z) (intMultiply (pos (k * m)) z)) = congE
        Int
        Int
        ((t: Int) => intPlus (intMultiply (pos m) z) t)
        (intMultiply (pos k) (intMultiply (pos m) z))
        (intMultiply (pos (k * m)) z)
        (ih m z);
      val e3: Eq
        Int
        (intPlus (intMultiply (pos m) z) (intMultiply (pos (k * m)) z))
        (intMultiply (pos (m + k * m)) z) = symE
        Int
        (intMultiply (pos (m + k * m)) z)
        (intPlus (intMultiply (pos m) z) (intMultiply (pos (k * m)) z))
        (intMultiplyPosSum m (k * m) z);
      transE
        Int
        (intMultiply (pos (succ k)) (intMultiply (pos m) z))
        (intPlus (intMultiply (pos m) z) (intMultiply (pos (k * m)) z))
        (intMultiply (pos (succ k * m)) z)
        (transE
          Int
          (intMultiply (pos (succ k)) (intMultiply (pos m) z))
          (intPlus (intMultiply (pos m) z) (intMultiply (pos k) (intMultiply (pos m) z)))
          (intPlus (intMultiply (pos m) z) (intMultiply (pos (k * m)) z))
          e1
          e2)
        e3
      })
    n

val intPlusMiddle: (a: Int)
-> (b: Int)
  -> (c: Int)
    -> (d: Int)
      -> Eq Int (intPlus (intPlus a b) (intPlus c d)) (intPlus (intPlus a c) (intPlus b d)) =
  (a: Int) => (b: Int) => (c: Int) => (d: Int) => {
    val e1: Eq Int (intPlus (intPlus a b) (intPlus c d)) (intPlus a (intPlus b (intPlus c d))) = intPlusAssoc
      a
      b
      (intPlus c d);
    val e2: Eq Int (intPlus a (intPlus b (intPlus c d))) (intPlus a (intPlus (intPlus b c) d)) = congE
      Int
      Int
      ((t: Int) => intPlus a t)
      (intPlus b (intPlus c d))
      (intPlus (intPlus b c) d)
      (symE Int (intPlus (intPlus b c) d) (intPlus b (intPlus c d)) (intPlusAssoc b c d));
    val e3: Eq Int (intPlus a (intPlus (intPlus b c) d)) (intPlus a (intPlus (intPlus c b) d)) = congE
      Int
      Int
      ((t: Int) => intPlus a t)
      (intPlus (intPlus b c) d)
      (intPlus (intPlus c b) d)
      (congE Int Int ((t: Int) => intPlus t d) (intPlus b c) (intPlus c b) (intPlusComm b c));
    val e4: Eq Int (intPlus a (intPlus (intPlus c b) d)) (intPlus a (intPlus c (intPlus b d))) = congE
      Int
      Int
      ((t: Int) => intPlus a t)
      (intPlus (intPlus c b) d)
      (intPlus c (intPlus b d))
      (intPlusAssoc c b d);
    val e5: Eq Int (intPlus a (intPlus c (intPlus b d))) (intPlus (intPlus a c) (intPlus b d)) = symE
      Int
      (intPlus (intPlus a c) (intPlus b d))
      (intPlus a (intPlus c (intPlus b d)))
      (intPlusAssoc a c (intPlus b d));
    transE
      Int
      (intPlus (intPlus a b) (intPlus c d))
      (intPlus a (intPlus c (intPlus b d)))
      (intPlus (intPlus a c) (intPlus b d))
      (transE
        Int
        (intPlus (intPlus a b) (intPlus c d))
        (intPlus a (intPlus (intPlus c b) d))
        (intPlus a (intPlus c (intPlus b d)))
        (transE
          Int
          (intPlus (intPlus a b) (intPlus c d))
          (intPlus a (intPlus (intPlus b c) d))
          (intPlus a (intPlus (intPlus c b) d))
          (transE
            Int
            (intPlus (intPlus a b) (intPlus c d))
            (intPlus a (intPlus b (intPlus c d)))
            (intPlus a (intPlus (intPlus b c) d))
            e1
            e2)
          e3)
        e4)
      e5
    }

val intMultPosAdd: (n: Nat)
-> (b: Int)
  -> (c: Int)
    -> Eq
        Int
        (intMultiply (pos n) (intPlus b c))
        (intPlus (intMultiply (pos n) b) (intMultiply (pos n) c)) =
  (n: Nat) => Nat.ind
    ((k: Nat) => (b: Int)
    -> (c: Int)
      -> Eq
          Int
          (intMultiply (pos k) (intPlus b c))
          (intPlus (intMultiply (pos k) b) (intMultiply (pos k) c)))
    ((b: Int) => (c: Int) => {
      val f: Eq Int (intPlus (intMultiply (pos zero) b) (intMultiply (pos zero) c)) (pos zero) = transE
        Int
        (intPlus (intMultiply (pos zero) b) (intMultiply (pos zero) c))
        (intPlus (pos zero) (pos zero))
        (pos zero)
        (transE
          Int
          (intPlus (intMultiply (pos zero) b) (intMultiply (pos zero) c))
          (intPlus (pos zero) (intMultiply (pos zero) c))
          (intPlus (pos zero) (pos zero))
          (congE
            Int
            Int
            ((t: Int) => intPlus t (intMultiply (pos zero) c))
            (intMultiply (pos zero) b)
            (pos zero)
            (intMultiplyPosZero b))
          (congE
            Int
            Int
            ((t: Int) => intPlus (pos zero) t)
            (intMultiply (pos zero) c)
            (pos zero)
            (intMultiplyPosZero c)))
        (intPlusZeroLeft (pos zero));
      transE
        Int
        (intMultiply (pos zero) (intPlus b c))
        (pos zero)
        (intPlus (intMultiply (pos zero) b) (intMultiply (pos zero) c))
        (intMultiplyPosZero (intPlus b c))
        (symE Int (intPlus (intMultiply (pos zero) b) (intMultiply (pos zero) c)) (pos zero) f)
      })
    ((k: Nat) => (ih: (b: Int)
    -> (c: Int)
      -> Eq
          Int
          (intMultiply (pos k) (intPlus b c))
          (intPlus (intMultiply (pos k) b) (intMultiply (pos k) c))) => (b: Int) => (c: Int) => {
      val e1: Eq
        Int
        (intMultiply (pos (succ k)) (intPlus b c))
        (intPlus (intPlus b c) (intMultiply (pos k) (intPlus b c))) = intMultiplyPosStep
        k
        (intPlus b c);
      val e2: Eq
        Int
        (intPlus (intPlus b c) (intMultiply (pos k) (intPlus b c)))
        (intPlus (intPlus b c) (intPlus (intMultiply (pos k) b) (intMultiply (pos k) c))) = congE
        Int
        Int
        ((t: Int) => intPlus (intPlus b c) t)
        (intMultiply (pos k) (intPlus b c))
        (intPlus (intMultiply (pos k) b) (intMultiply (pos k) c))
        (ih b c);
      val e3: Eq
        Int
        (intPlus (intPlus b c) (intPlus (intMultiply (pos k) b) (intMultiply (pos k) c)))
        (intPlus (intPlus b (intMultiply (pos k) b)) (intPlus c (intMultiply (pos k) c))) = intPlusMiddle
        b
        c
        (intMultiply (pos k) b)
        (intMultiply (pos k) c);
      val fwd: Eq
        Int
        (intPlus (intMultiply (pos (succ k)) b) (intMultiply (pos (succ k)) c))
        (intPlus (intPlus b (intMultiply (pos k) b)) (intPlus c (intMultiply (pos k) c))) = transE
        Int
        (intPlus (intMultiply (pos (succ k)) b) (intMultiply (pos (succ k)) c))
        (intPlus (intPlus b (intMultiply (pos k) b)) (intMultiply (pos (succ k)) c))
        (intPlus (intPlus b (intMultiply (pos k) b)) (intPlus c (intMultiply (pos k) c)))
        (congE
          Int
          Int
          ((t: Int) => intPlus t (intMultiply (pos (succ k)) c))
          (intMultiply (pos (succ k)) b)
          (intPlus b (intMultiply (pos k) b))
          (intMultiplyPosStep k b))
        (congE
          Int
          Int
          ((t: Int) => intPlus (intPlus b (intMultiply (pos k) b)) t)
          (intMultiply (pos (succ k)) c)
          (intPlus c (intMultiply (pos k) c))
          (intMultiplyPosStep k c));
      transE
        Int
        (intMultiply (pos (succ k)) (intPlus b c))
        (intPlus (intPlus b (intMultiply (pos k) b)) (intPlus c (intMultiply (pos k) c)))
        (intPlus (intMultiply (pos (succ k)) b) (intMultiply (pos (succ k)) c))
        (transE
          Int
          (intMultiply (pos (succ k)) (intPlus b c))
          (intPlus (intPlus b c) (intPlus (intMultiply (pos k) b) (intMultiply (pos k) c)))
          (intPlus (intPlus b (intMultiply (pos k) b)) (intPlus c (intMultiply (pos k) c)))
          (transE
            Int
            (intMultiply (pos (succ k)) (intPlus b c))
            (intPlus (intPlus b c) (intMultiply (pos k) (intPlus b c)))
            (intPlus (intPlus b c) (intPlus (intMultiply (pos k) b) (intMultiply (pos k) c)))
            e1
            e2)
          e3)
        (symE
          Int
          (intPlus (intMultiply (pos (succ k)) b) (intMultiply (pos (succ k)) c))
          (intPlus (intPlus b (intMultiply (pos k) b)) (intPlus c (intMultiply (pos k) c)))
          fwd)
      })
    n
// --- Negation and addition ------------------------------------------------

val intNegateUnique: (x: Int)
-> (y: Int) -> Eq Int (intPlus x y) (pos zero) -> Eq Int x (intNegate y) =
  (x: Int) => (y: Int) => (h: Eq Int (intPlus x y) (pos zero)) => {
    val e1: Eq Int x (intPlus x (pos zero)) = symE Int (intPlus x (pos zero)) x (intPlusZeroRight x);
    val e2: Eq Int (intPlus x (pos zero)) (intPlus x (intPlus y (intNegate y))) = congE
      Int
      Int
      ((t: Int) => intPlus x t)
      (pos zero)
      (intPlus y (intNegate y))
      (symE Int (intPlus y (intNegate y)) (pos zero) (intAddNegateRight y));
    val e3: Eq Int (intPlus x (intPlus y (intNegate y))) (intPlus (intPlus x y) (intNegate y)) = symE
      Int
      (intPlus (intPlus x y) (intNegate y))
      (intPlus x (intPlus y (intNegate y)))
      (intPlusAssoc x y (intNegate y));
    val e4: Eq Int (intPlus (intPlus x y) (intNegate y)) (intPlus (pos zero) (intNegate y)) = congE
      Int
      Int
      ((t: Int) => intPlus t (intNegate y))
      (intPlus x y)
      (pos zero)
      h;
    val e5: Eq Int (intPlus (pos zero) (intNegate y)) (intNegate y) = intPlusZeroLeft (intNegate y);
    transE
      Int
      x
      (intPlus (intPlus x y) (intNegate y))
      (intNegate y)
      (transE
        Int
        x
        (intPlus x (intPlus y (intNegate y)))
        (intPlus (intPlus x y) (intNegate y))
        (transE Int x (intPlus x (pos zero)) (intPlus x (intPlus y (intNegate y))) e1 e2)
        e3)
      (transE
        Int
        (intPlus (intPlus x y) (intNegate y))
        (intPlus (pos zero) (intNegate y))
        (intNegate y)
        e4
        e5)
    }

val intPlusNegNegZero: (x: Int)
-> (y: Int) -> Eq Int (intPlus (intPlus (intNegate x) (intNegate y)) (intPlus x y)) (pos zero) =
  (x: Int) => (y: Int) => {
    val e1: Eq
      Int
      (intPlus (intPlus (intNegate x) (intNegate y)) (intPlus x y))
      (intPlus (intNegate x) (intPlus (intNegate y) (intPlus x y))) = intPlusAssoc
      (intNegate x)
      (intNegate y)
      (intPlus x y);
    val e2: Eq
      Int
      (intPlus (intNegate x) (intPlus (intNegate y) (intPlus x y)))
      (intPlus (intNegate x) (intPlus (intPlus (intNegate y) x) y)) = congE
      Int
      Int
      ((t: Int) => intPlus (intNegate x) t)
      (intPlus (intNegate y) (intPlus x y))
      (intPlus (intPlus (intNegate y) x) y)
      (symE
        Int
        (intPlus (intPlus (intNegate y) x) y)
        (intPlus (intNegate y) (intPlus x y))
        (intPlusAssoc (intNegate y) x y));
    val e3: Eq
      Int
      (intPlus (intNegate x) (intPlus (intPlus (intNegate y) x) y))
      (intPlus (intNegate x) (intPlus (intPlus x (intNegate y)) y)) = congE
      Int
      Int
      ((t: Int) => intPlus (intNegate x) t)
      (intPlus (intPlus (intNegate y) x) y)
      (intPlus (intPlus x (intNegate y)) y)
      (congE
        Int
        Int
        ((t: Int) => intPlus t y)
        (intPlus (intNegate y) x)
        (intPlus x (intNegate y))
        (intPlusComm (intNegate y) x));
    val e4: Eq
      Int
      (intPlus (intNegate x) (intPlus (intPlus x (intNegate y)) y))
      (intPlus (intNegate x) (intPlus x (intPlus (intNegate y) y))) = congE
      Int
      Int
      ((t: Int) => intPlus (intNegate x) t)
      (intPlus (intPlus x (intNegate y)) y)
      (intPlus x (intPlus (intNegate y) y))
      (intPlusAssoc x (intNegate y) y);
    val e5: Eq
      Int
      (intPlus (intNegate x) (intPlus x (intPlus (intNegate y) y)))
      (intPlus (intNegate x) (intPlus x (pos zero))) = congE
      Int
      Int
      ((t: Int) => intPlus (intNegate x) (intPlus x t))
      (intPlus (intNegate y) y)
      (pos zero)
      (intAddNegateLeft y);
    val e6: Eq Int (intPlus (intNegate x) (intPlus x (pos zero))) (intPlus (intNegate x) x) = congE
      Int
      Int
      ((t: Int) => intPlus (intNegate x) t)
      (intPlus x (pos zero))
      x
      (intPlusZeroRight x);
    val e7: Eq Int (intPlus (intNegate x) x) (pos zero) = intAddNegateLeft x;
    transE
      Int
      (intPlus (intPlus (intNegate x) (intNegate y)) (intPlus x y))
      (intPlus (intNegate x) (intPlus x (pos zero)))
      (pos zero)
      (transE
        Int
        (intPlus (intPlus (intNegate x) (intNegate y)) (intPlus x y))
        (intPlus (intNegate x) (intPlus (intPlus x (intNegate y)) y))
        (intPlus (intNegate x) (intPlus x (pos zero)))
        (transE
          Int
          (intPlus (intPlus (intNegate x) (intNegate y)) (intPlus x y))
          (intPlus (intNegate x) (intPlus (intPlus (intNegate y) x) y))
          (intPlus (intNegate x) (intPlus (intPlus x (intNegate y)) y))
          (transE
            Int
            (intPlus (intPlus (intNegate x) (intNegate y)) (intPlus x y))
            (intPlus (intNegate x) (intPlus (intNegate y) (intPlus x y)))
            (intPlus (intNegate x) (intPlus (intPlus (intNegate y) x) y))
            e1
            e2)
          e3)
        (transE
          Int
          (intPlus (intNegate x) (intPlus (intPlus x (intNegate y)) y))
          (intPlus (intNegate x) (intPlus x (intPlus (intNegate y) y)))
          (intPlus (intNegate x) (intPlus x (pos zero)))
          e4
          e5))
      (transE
        Int
        (intPlus (intNegate x) (intPlus x (pos zero)))
        (intPlus (intNegate x) x)
        (pos zero)
        e6
        e7)
    }

val intNegateAdd: (x: Int)
-> (y: Int) -> Eq Int (intNegate (intPlus x y)) (intPlus (intNegate x) (intNegate y)) =
  (x: Int) => (y: Int) => symE
    Int
    (intPlus (intNegate x) (intNegate y))
    (intNegate (intPlus x y))
    (intNegateUnique (intPlus (intNegate x) (intNegate y)) (intPlus x y) (intPlusNegNegZero x y))
// --- Associativity --------------------------------------------------------

val intMultiplyAssocPos: (n: Nat)
-> (b: Int)
  -> (c: Int)
    -> Eq Int (intMultiply (intMultiply (pos n) b) c) (intMultiply (pos n) (intMultiply b c)) =
  (n: Nat) => (b: Int) => Int.ind
    ((w: Int) => (c: Int)
    -> Eq Int (intMultiply (intMultiply (pos n) w) c) (intMultiply (pos n) (intMultiply w c)))
    ((m: Nat) => (c: Int) => symE
      Int
      (intMultiply (pos n) (intMultiply (pos m) c))
      (intMultiply (pos (n * m)) c)
      (intMultiplyPosAssoc n m c))
    ((m: Nat) => (c: Int) => {
      val e1: Eq
        Int
        (intMultiply (intMultiply (pos n) (neg m)) c)
        (intNegate (intMultiply (pos (n * succ m)) c)) = intMultiplyNegateLeft (pos (n * succ m)) c;
      val e2: Eq
        Int
        (intNegate (intMultiply (pos (n * succ m)) c))
        (intNegate (intMultiply (pos n) (intMultiply (pos (succ m)) c))) = symE
        Int
        (intNegate (intMultiply (pos n) (intMultiply (pos (succ m)) c)))
        (intNegate (intMultiply (pos (n * succ m)) c))
        (congE
          Int
          Int
          ((t: Int) => intNegate t)
          (intMultiply (pos n) (intMultiply (pos (succ m)) c))
          (intMultiply (pos (n * succ m)) c)
          (intMultiplyPosAssoc n (succ m) c));
      val e3: Eq
        Int
        (intNegate (intMultiply (pos n) (intMultiply (pos (succ m)) c)))
        (intMultiply (pos n) (intNegate (intMultiply (pos (succ m)) c))) = symE
        Int
        (intMultiply (pos n) (intNegate (intMultiply (pos (succ m)) c)))
        (intNegate (intMultiply (pos n) (intMultiply (pos (succ m)) c)))
        (intMultiplyNegateRight (pos n) (intMultiply (pos (succ m)) c));
      val e4: Eq
        Int
        (intMultiply (pos n) (intNegate (intMultiply (pos (succ m)) c)))
        (intMultiply (pos n) (intMultiply (neg m) c)) = congE
        Int
        Int
        ((t: Int) => intMultiply (pos n) t)
        (intNegate (intMultiply (pos (succ m)) c))
        (intMultiply (intNegate (pos (succ m))) c)
        (symE
          Int
          (intMultiply (intNegate (pos (succ m))) c)
          (intNegate (intMultiply (pos (succ m)) c))
          (intMultiplyNegateLeft (pos (succ m)) c));
      transE
        Int
        (intMultiply (intMultiply (pos n) (neg m)) c)
        (intNegate (intMultiply (pos n) (intMultiply (pos (succ m)) c)))
        (intMultiply (pos n) (intMultiply (neg m) c))
        (transE
          Int
          (intMultiply (intMultiply (pos n) (neg m)) c)
          (intNegate (intMultiply (pos (n * succ m)) c))
          (intNegate (intMultiply (pos n) (intMultiply (pos (succ m)) c)))
          e1
          e2)
        (transE
          Int
          (intNegate (intMultiply (pos n) (intMultiply (pos (succ m)) c)))
          (intMultiply (pos n) (intNegate (intMultiply (pos (succ m)) c)))
          (intMultiply (pos n) (intMultiply (neg m) c))
          e3
          e4)
      })
    b

val intMultiplyAssoc: (a: Int)
-> (b: Int)
  -> (c: Int) -> Eq Int (intMultiply (intMultiply a b) c) (intMultiply a (intMultiply b c)) =
  (a: Int) => Int.ind
    ((x: Int) => (b: Int)
    -> (c: Int) -> Eq Int (intMultiply (intMultiply x b) c) (intMultiply x (intMultiply b c)))
    ((n: Nat) => (b: Int) => (c: Int) => intMultiplyAssocPos n b c)
    ((n: Nat) => (b: Int) => (c: Int) => {
      val e1: Eq
        Int
        (intMultiply (intMultiply (neg n) b) c)
        (intMultiply (intNegate (intMultiply (pos (succ n)) b)) c) = congE
        Int
        Int
        ((t: Int) => intMultiply t c)
        (intMultiply (neg n) b)
        (intNegate (intMultiply (pos (succ n)) b))
        (intMultiplyNegateLeft (pos (succ n)) b);
      val e2: Eq
        Int
        (intMultiply (intNegate (intMultiply (pos (succ n)) b)) c)
        (intNegate (intMultiply (intMultiply (pos (succ n)) b) c)) = intMultiplyNegateLeft
        (intMultiply (pos (succ n)) b)
        c;
      val e3: Eq
        Int
        (intNegate (intMultiply (intMultiply (pos (succ n)) b) c))
        (intNegate (intMultiply (pos (succ n)) (intMultiply b c))) = congE
        Int
        Int
        ((t: Int) => intNegate t)
        (intMultiply (intMultiply (pos (succ n)) b) c)
        (intMultiply (pos (succ n)) (intMultiply b c))
        (intMultiplyAssocPos (succ n) b c);
      val e4: Eq
        Int
        (intNegate (intMultiply (pos (succ n)) (intMultiply b c)))
        (intMultiply (neg n) (intMultiply b c)) = symE
        Int
        (intMultiply (neg n) (intMultiply b c))
        (intNegate (intMultiply (pos (succ n)) (intMultiply b c)))
        (intMultiplyNegateLeft (pos (succ n)) (intMultiply b c));
      transE
        Int
        (intMultiply (intMultiply (neg n) b) c)
        (intNegate (intMultiply (pos (succ n)) (intMultiply b c)))
        (intMultiply (neg n) (intMultiply b c))
        (transE
          Int
          (intMultiply (intMultiply (neg n) b) c)
          (intNegate (intMultiply (intMultiply (pos (succ n)) b) c))
          (intNegate (intMultiply (pos (succ n)) (intMultiply b c)))
          (transE
            Int
            (intMultiply (intMultiply (neg n) b) c)
            (intMultiply (intNegate (intMultiply (pos (succ n)) b)) c)
            (intNegate (intMultiply (intMultiply (pos (succ n)) b) c))
            e1
            e2)
          e3)
        e4
      })
    a
// --- Distributivity -------------------------------------------------------

val intAddMultiply: (a: Int)
-> (b: Int)
  -> (c: Int) -> Eq Int (intMultiply a (intPlus b c)) (intPlus (intMultiply a b) (intMultiply a c)) =
  (a: Int) => Int.ind
    ((x: Int) => (b: Int)
    -> (c: Int)
      -> Eq Int (intMultiply x (intPlus b c)) (intPlus (intMultiply x b) (intMultiply x c)))
    ((n: Nat) => (b: Int) => (c: Int) => intMultPosAdd n b c)
    ((n: Nat) => (b: Int) => (c: Int) => {
      val e1: Eq
        Int
        (intMultiply (neg n) (intPlus b c))
        (intNegate (intMultiply (pos (succ n)) (intPlus b c))) = intMultiplyNegateLeft
        (pos (succ n))
        (intPlus b c);
      val e2: Eq
        Int
        (intNegate (intMultiply (pos (succ n)) (intPlus b c)))
        (intNegate (intPlus (intMultiply (pos (succ n)) b) (intMultiply (pos (succ n)) c))) = congE
        Int
        Int
        ((t: Int) => intNegate t)
        (intMultiply (pos (succ n)) (intPlus b c))
        (intPlus (intMultiply (pos (succ n)) b) (intMultiply (pos (succ n)) c))
        (intMultPosAdd (succ n) b c);
      val e3: Eq
        Int
        (intNegate (intPlus (intMultiply (pos (succ n)) b) (intMultiply (pos (succ n)) c)))
        (intPlus
          (intNegate (intMultiply (pos (succ n)) b))
          (intNegate (intMultiply (pos (succ n)) c))) = intNegateAdd
        (intMultiply (pos (succ n)) b)
        (intMultiply (pos (succ n)) c);
      val e4: Eq
        Int
        (intPlus
          (intNegate (intMultiply (pos (succ n)) b))
          (intNegate (intMultiply (pos (succ n)) c)))
        (intPlus (intMultiply (neg n) b) (intMultiply (neg n) c)) = transE
        Int
        (intPlus
          (intNegate (intMultiply (pos (succ n)) b))
          (intNegate (intMultiply (pos (succ n)) c)))
        (intPlus (intMultiply (neg n) b) (intNegate (intMultiply (pos (succ n)) c)))
        (intPlus (intMultiply (neg n) b) (intMultiply (neg n) c))
        (congE
          Int
          Int
          ((t: Int) => intPlus t (intNegate (intMultiply (pos (succ n)) c)))
          (intNegate (intMultiply (pos (succ n)) b))
          (intMultiply (neg n) b)
          (symE
            Int
            (intMultiply (neg n) b)
            (intNegate (intMultiply (pos (succ n)) b))
            (intMultiplyNegateLeft (pos (succ n)) b)))
        (congE
          Int
          Int
          ((t: Int) => intPlus (intMultiply (neg n) b) t)
          (intNegate (intMultiply (pos (succ n)) c))
          (intMultiply (neg n) c)
          (symE
            Int
            (intMultiply (neg n) c)
            (intNegate (intMultiply (pos (succ n)) c))
            (intMultiplyNegateLeft (pos (succ n)) c)));
      transE
        Int
        (intMultiply (neg n) (intPlus b c))
        (intPlus
          (intNegate (intMultiply (pos (succ n)) b))
          (intNegate (intMultiply (pos (succ n)) c)))
        (intPlus (intMultiply (neg n) b) (intMultiply (neg n) c))
        (transE
          Int
          (intMultiply (neg n) (intPlus b c))
          (intNegate (intPlus (intMultiply (pos (succ n)) b) (intMultiply (pos (succ n)) c)))
          (intPlus
            (intNegate (intMultiply (pos (succ n)) b))
            (intNegate (intMultiply (pos (succ n)) c)))
          (transE
            Int
            (intMultiply (neg n) (intPlus b c))
            (intNegate (intMultiply (pos (succ n)) (intPlus b c)))
            (intNegate (intPlus (intMultiply (pos (succ n)) b) (intMultiply (pos (succ n)) c)))
            e1
            e2)
          e3)
        e4
      })
    a

val intMultiplyComm: (a: Int) -> (b: Int) -> Eq Int (intMultiply a b) (intMultiply b a) =
  (a: Int) => Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intMultiply x y) (intMultiply y x))
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMultiply (pos n) w) (intMultiply w (pos n)))
      ((m: Nat) => congE Nat Int ((t: Nat) => pos t) (n * m) (m * n) (multiplyComm n m))
      ((m: Nat) => congE
        Nat
        Int
        ((t: Nat) => intNegate (pos t))
        (n * succ m)
        (succ m * n)
        (multiplyComm n (succ m)))
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMultiply (neg n) w) (intMultiply w (neg n)))
      ((m: Nat) => congE
        Nat
        Int
        ((t: Nat) => intNegate (pos t))
        (succ n * m)
        (m * succ n)
        (multiplyComm (succ n) m))
      ((m: Nat) => {
        val c1: Eq Nat (n * m + n + m) (m * n + n + m) = congE
          Nat
          Nat
          ((t: Nat) => t + n + m)
          (n * m)
          (m * n)
          (multiplyComm n m);
        val c2: Eq Nat (m * n + n + m) (m * n + (n + m)) = plusAssoc (m * n) n m;
        val c3: Eq Nat (m * n + (n + m)) (m * n + (m + n)) = congE
          Nat
          Nat
          ((t: Nat) => m * n + t)
          (n + m)
          (m + n)
          (plusComm n m);
        val c4: Eq Nat (m * n + (m + n)) (m * n + m + n) = symE
          Nat
          (m * n + m + n)
          (m * n + (m + n))
          (plusAssoc (m * n) m n);
        congE
          Nat
          Int
          ((t: Nat) => pos (succ t))
          (n * m + n + m)
          (m * n + m + n)
          (transE
            Nat
            (n * m + n + m)
            (m * n + (n + m))
            (m * n + m + n)
            (transE Nat (n * m + n + m) (m * n + n + m) (m * n + (n + m)) c1 c2)
            (transE Nat (m * n + (n + m)) (m * n + (m + n)) (m * n + m + n) c3 c4))
        })
      y)
    a

val intMultiplyAdd: (a: Int)
-> (b: Int)
  -> (c: Int) -> Eq Int (intMultiply (intPlus a b) c) (intPlus (intMultiply a c) (intMultiply b c)) =
  (a: Int) => (b: Int) => (c: Int) => {
    val e1: Eq Int (intMultiply (intPlus a b) c) (intMultiply c (intPlus a b)) = intMultiplyComm
      (intPlus a b)
      c;
    val e2: Eq Int (intMultiply c (intPlus a b)) (intPlus (intMultiply c a) (intMultiply c b)) = intAddMultiply
      c
      a
      b;
    val e3: Eq
      Int
      (intPlus (intMultiply c a) (intMultiply c b))
      (intPlus (intMultiply a c) (intMultiply b c)) = transE
      Int
      (intPlus (intMultiply c a) (intMultiply c b))
      (intPlus (intMultiply a c) (intMultiply c b))
      (intPlus (intMultiply a c) (intMultiply b c))
      (congE
        Int
        Int
        ((t: Int) => intPlus t (intMultiply c b))
        (intMultiply c a)
        (intMultiply a c)
        (symE Int (intMultiply a c) (intMultiply c a) (intMultiplyComm a c)))
      (congE
        Int
        Int
        ((t: Int) => intPlus (intMultiply a c) t)
        (intMultiply c b)
        (intMultiply b c)
        (symE Int (intMultiply b c) (intMultiply c b) (intMultiplyComm b c)));
    transE
      Int
      (intMultiply (intPlus a b) c)
      (intPlus (intMultiply c a) (intMultiply c b))
      (intPlus (intMultiply a c) (intMultiply b c))
      (transE
        Int
        (intMultiply (intPlus a b) c)
        (intMultiply c (intPlus a b))
        (intPlus (intMultiply c a) (intMultiply c b))
        e1
        e2)
      e3
    }
// --- Multiplicative identity ---------------------------------------------

val intOneMultiply: (n: Nat) -> Eq Nat (succ zero * n) n =
  (n: Nat) => transE
    Nat
    (succ zero * n)
    (n * succ zero)
    n
    (multiplyComm (succ zero) n)
    (multiplyOne n)

val intMultiplyOneLeft: (a: Int) -> Eq Int (intMultiply (pos (succ zero)) a) a =
  Int.ind
    ((x: Int) => Eq Int (intMultiply (pos (succ zero)) x) x)
    ((n: Nat) => congE Nat Int ((t: Nat) => pos t) (succ zero * n) n (intOneMultiply n))
    ((n: Nat) => congE
      Nat
      Int
      ((t: Nat) => intNegate (pos t))
      (succ zero * succ n)
      (succ n)
      (transE
        Nat
        (succ zero * succ n)
        (succ n * succ zero)
        (succ n)
        (multiplyComm (succ zero) (succ n))
        (multiplyOne (succ n))))

val intMultiplyOneRight: (a: Int) -> Eq Int (intMultiply a (pos (succ zero))) a =
  Int.ind
    ((x: Int) => Eq Int (intMultiply x (pos (succ zero))) x)
    ((n: Nat) => congE Nat Int ((t: Nat) => pos t) (n * succ zero) n (multiplyOne n))
    ((n: Nat) => congE
      Nat
      Int
      ((t: Nat) => intNegate (pos t))
      (succ n * succ zero)
      (succ n)
      (multiplyOne (succ n)))
