          Int
          (intNeg (intMult (pos n) (intMult (pos (succ m)) c)))
          (intMult (pos n) (intNeg (intMult (pos (succ m)) c)))
          (intMult (pos n) (intMult (neg m) c))
          e3
          e4)
      })
    b

val intMultAssoc: (a: Int)
-> (b: Int) -> (c: Int) -> Eq Int (intMult (intMult a b) c) (intMult a (intMult b c)) =
  (a: Int) => Int.ind
    ((x: Int) => (b: Int) -> (c: Int) -> Eq Int (intMult (intMult x b) c) (intMult x (intMult b c)))
    ((n: Nat) => (b: Int) => (c: Int) => intMultAssocPos n b c)
    ((n: Nat) => (b: Int) => (c: Int) => {
      val e1: Eq Int (intMult (intMult (neg n) b) c) (intMult (intNeg (intMult (pos (succ n)) b)) c) = cong_e
        Int
        Int
        ((t: Int) => intMult t c)
        (intMult (neg n) b)
        (intNeg (intMult (pos (succ n)) b))
        (intMult_neg_left (pos (succ n)) b);
      val e2: Eq
        Int
        (intMult (intNeg (intMult (pos (succ n)) b)) c)
        (intNeg (intMult (intMult (pos (succ n)) b) c)) = intMult_neg_left
        (intMult (pos (succ n)) b)
        c;
      val e3: Eq
        Int
        (intNeg (intMult (intMult (pos (succ n)) b) c))
        (intNeg (intMult (pos (succ n)) (intMult b c))) = cong_e
        Int
        Int
        ((t: Int) => intNeg t)
        (intMult (intMult (pos (succ n)) b) c)
        (intMult (pos (succ n)) (intMult b c))
        (intMultAssocPos (succ n) b c);
      val e4: Eq Int (intNeg (intMult (pos (succ n)) (intMult b c))) (intMult (neg n) (intMult b c)) = sym_e
        Int
        (intMult (neg n) (intMult b c))
        (intNeg (intMult (pos (succ n)) (intMult b c)))
        (intMult_neg_left (pos (succ n)) (intMult b c));
      trans_e
        Int
        (intMult (intMult (neg n) b) c)
        (intNeg (intMult (pos (succ n)) (intMult b c)))
        (intMult (neg n) (intMult b c))
        (trans_e
          Int
          (intMult (intMult (neg n) b) c)
          (intNeg (intMult (intMult (pos (succ n)) b) c))
          (intNeg (intMult (pos (succ n)) (intMult b c)))
          (trans_e
            Int
            (intMult (intMult (neg n) b) c)
            (intMult (intNeg (intMult (pos (succ n)) b)) c)
            (intNeg (intMult (intMult (pos (succ n)) b) c))
            e1
            e2)
          e3)
        e4
      })
    a
// --- Distributivity -------------------------------------------------------

val intAddMul: (a: Int)
-> (b: Int) -> (c: Int) -> Eq Int (intMult a (intPlus b c)) (intPlus (intMult a b) (intMult a c)) =
  (a: Int) => Int.ind
    ((x: Int) => (b: Int)
    -> (c: Int) -> Eq Int (intMult x (intPlus b c)) (intPlus (intMult x b) (intMult x c)))
    ((n: Nat) => (b: Int) => (c: Int) => intMultPosAdd n b c)
    ((n: Nat) => (b: Int) => (c: Int) => {
      val e1: Eq Int (intMult (neg n) (intPlus b c)) (intNeg (intMult (pos (succ n)) (intPlus b c))) = intMult_neg_left
        (pos (succ n))
        (intPlus b c);
      val e2: Eq
        Int
        (intNeg (intMult (pos (succ n)) (intPlus b c)))
        (intNeg (intPlus (intMult (pos (succ n)) b) (intMult (pos (succ n)) c))) = cong_e
        Int
        Int
        ((t: Int) => intNeg t)
        (intMult (pos (succ n)) (intPlus b c))
        (intPlus (intMult (pos (succ n)) b) (intMult (pos (succ n)) c))
        (intMultPosAdd (succ n) b c);
      val e3: Eq
        Int
        (intNeg (intPlus (intMult (pos (succ n)) b) (intMult (pos (succ n)) c)))
        (intPlus (intNeg (intMult (pos (succ n)) b)) (intNeg (intMult (pos (succ n)) c))) = intNegAdd
        (intMult (pos (succ n)) b)
        (intMult (pos (succ n)) c);
      val e4: Eq
        Int
        (intPlus (intNeg (intMult (pos (succ n)) b)) (intNeg (intMult (pos (succ n)) c)))
        (intPlus (intMult (neg n) b) (intMult (neg n) c)) = trans_e
        Int
        (intPlus (intNeg (intMult (pos (succ n)) b)) (intNeg (intMult (pos (succ n)) c)))
        (intPlus (intMult (neg n) b) (intNeg (intMult (pos (succ n)) c)))
        (intPlus (intMult (neg n) b) (intMult (neg n) c))
        (cong_e
          Int
          Int
          ((t: Int) => intPlus t (intNeg (intMult (pos (succ n)) c)))
          (intNeg (intMult (pos (succ n)) b))
          (intMult (neg n) b)
          (sym_e
            Int
            (intMult (neg n) b)
            (intNeg (intMult (pos (succ n)) b))
            (intMult_neg_left (pos (succ n)) b)))
        (cong_e
          Int
          Int
          ((t: Int) => intPlus (intMult (neg n) b) t)
          (intNeg (intMult (pos (succ n)) c))
          (intMult (neg n) c)
          (sym_e
            Int
            (intMult (neg n) c)
            (intNeg (intMult (pos (succ n)) c))
            (intMult_neg_left (pos (succ n)) c)));
      trans_e
        Int
        (intMult (neg n) (intPlus b c))
        (intPlus (intNeg (intMult (pos (succ n)) b)) (intNeg (intMult (pos (succ n)) c)))
        (intPlus (intMult (neg n) b) (intMult (neg n) c))
        (trans_e
          Int
          (intMult (neg n) (intPlus b c))
          (intNeg (intPlus (intMult (pos (succ n)) b) (intMult (pos (succ n)) c)))
          (intPlus (intNeg (intMult (pos (succ n)) b)) (intNeg (intMult (pos (succ n)) c)))
          (trans_e
            Int
            (intMult (neg n) (intPlus b c))
            (intNeg (intMult (pos (succ n)) (intPlus b c)))
            (intNeg (intPlus (intMult (pos (succ n)) b) (intMult (pos (succ n)) c)))
            e1
            e2)
          e3)
        e4
      })
    a

val intMultComm: (a: Int) -> (b: Int) -> Eq Int (intMult a b) (intMult b a) =
  (a: Int) => Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intMult x y) (intMult y x))
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMult (pos n) w) (intMult w (pos n)))
      ((m: Nat) => cong_e Nat Int ((t: Nat) => pos t) (n * m) (m * n) (mult_comm n m))
      ((m: Nat) => cong_e
        Nat
        Int
        ((t: Nat) => intNeg (pos t))
        (n * succ m)
        (succ m * n)
        (mult_comm n (succ m)))
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((w: Int) => Eq Int (intMult (neg n) w) (intMult w (neg n)))
      ((m: Nat) => cong_e
        Nat
        Int
        ((t: Nat) => intNeg (pos t))
        (succ n * m)
        (m * succ n)
        (mult_comm (succ n) m))
      ((m: Nat) => {
        val c1: Eq Nat (n * m + n + m) (m * n + n + m) = cong_e
          Nat
          Nat
          ((t: Nat) => t + n + m)
          (n * m)
          (m * n)
          (mult_comm n m);
        val c2: Eq Nat (m * n + n + m) (m * n + (n + m)) = plus_assoc (m * n) n m;
        val c3: Eq Nat (m * n + (n + m)) (m * n + (m + n)) = cong_e
          Nat
          Nat
          ((t: Nat) => m * n + t)
          (n + m)
          (m + n)
          (plus_comm n m);
        val c4: Eq Nat (m * n + (m + n)) (m * n + m + n) = sym_e
          Nat
          (m * n + m + n)
          (m * n + (m + n))
          (plus_assoc (m * n) m n);
        cong_e
          Nat
          Int
          ((t: Nat) => pos (succ t))
          (n * m + n + m)
          (m * n + m + n)
          (trans_e
            Nat
            (n * m + n + m)
            (m * n + (n + m))
            (m * n + m + n)
            (trans_e Nat (n * m + n + m) (m * n + n + m) (m * n + (n + m)) c1 c2)
            (trans_e Nat (m * n + (n + m)) (m * n + (m + n)) (m * n + m + n) c3 c4))
        })
      y)
    a

val intMulAdd: (a: Int)
-> (b: Int) -> (c: Int) -> Eq Int (intMult (intPlus a b) c) (intPlus (intMult a c) (intMult b c)) =
  (a: Int) => (b: Int) => (c: Int) => {
    val e1: Eq Int (intMult (intPlus a b) c) (intMult c (intPlus a b)) = intMultComm (intPlus a b) c;
    val e2: Eq Int (intMult c (intPlus a b)) (intPlus (intMult c a) (intMult c b)) = intAddMul c a b;
    val e3: Eq Int (intPlus (intMult c a) (intMult c b)) (intPlus (intMult a c) (intMult b c)) = trans_e
      Int
      (intPlus (intMult c a) (intMult c b))
      (intPlus (intMult a c) (intMult c b))
      (intPlus (intMult a c) (intMult b c))
      (cong_e
        Int
        Int
        ((t: Int) => intPlus t (intMult c b))
        (intMult c a)
        (intMult a c)
        (sym_e Int (intMult a c) (intMult c a) (intMultComm a c)))
      (cong_e
        Int
        Int
        ((t: Int) => intPlus (intMult a c) t)
        (intMult c b)
        (intMult b c)
        (sym_e Int (intMult b c) (intMult c b) (intMultComm b c)));
    trans_e
      Int
      (intMult (intPlus a b) c)
      (intPlus (intMult c a) (intMult c b))
      (intPlus (intMult a c) (intMult b c))
      (trans_e
        Int
        (intMult (intPlus a b) c)
        (intMult c (intPlus a b))
        (intPlus (intMult c a) (intMult c b))
        e1
        e2)
      e3
    }
// --- Multiplicative identity ---------------------------------------------

val intOneMult: (n: Nat) -> Eq Nat (succ zero * n) n =
  (n: Nat) => trans_e Nat (succ zero * n) (n * succ zero) n (mult_comm (succ zero) n) (mult_one n)

val intMultOneLeft: (a: Int) -> Eq Int (intMult (pos (succ zero)) a) a =
  Int.ind
    ((x: Int) => Eq Int (intMult (pos (succ zero)) x) x)
    ((n: Nat) => cong_e Nat Int ((t: Nat) => pos t) (succ zero * n) n (intOneMult n))
    ((n: Nat) => cong_e
      Nat
      Int
      ((t: Nat) => intNeg (pos t))
      (succ zero * succ n)
      (succ n)
      (trans_e
        Nat
        (succ zero * succ n)
        (succ n * succ zero)
        (succ n)
        (mult_comm (succ zero) (succ n))
        (mult_one (succ n))))

val intMultOneRight: (a: Int) -> Eq Int (intMult a (pos (succ zero))) a =
  Int.ind
    ((x: Int) => Eq Int (intMult x (pos (succ zero))) x)
    ((n: Nat) => cong_e Nat Int ((t: Nat) => pos t) (n * succ zero) n (mult_one n))
    ((n: Nat) => cong_e
      Nat
      Int
      ((t: Nat) => intNeg (pos t))
      (succ n * succ zero)
      (succ n)
      (mult_one (succ n)))
