    val e2: Eq Int (intPlus x (pos zero)) (intPlus x (intPlus y (intNeg y))) = cong_e
      Int
      Int
      ((t: Int) => intPlus x t)
      (pos zero)
      (intPlus y (intNeg y))
      (sym_e Int (intPlus y (intNeg y)) (pos zero) (intAdd_neg_right y));
    val e3: Eq Int (intPlus x (intPlus y (intNeg y))) (intPlus (intPlus x y) (intNeg y)) = sym_e
      Int
      (intPlus (intPlus x y) (intNeg y))
      (intPlus x (intPlus y (intNeg y)))
      (intPlus_assoc x y (intNeg y));
    val e4: Eq Int (intPlus (intPlus x y) (intNeg y)) (intPlus (pos zero) (intNeg y)) = cong_e
      Int
      Int
      ((t: Int) => intPlus t (intNeg y))
      (intPlus x y)
      (pos zero)
      h;
    val e5: Eq Int (intPlus (pos zero) (intNeg y)) (intNeg y) = intPlus_zero_left (intNeg y);
    trans_e
      Int
      x
      (intPlus (intPlus x y) (intNeg y))
      (intNeg y)
      (trans_e
        Int
        x
        (intPlus x (intPlus y (intNeg y)))
        (intPlus (intPlus x y) (intNeg y))
        (trans_e Int x (intPlus x (pos zero)) (intPlus x (intPlus y (intNeg y))) e1 e2)
        e3)
      (trans_e
        Int
        (intPlus (intPlus x y) (intNeg y))
        (intPlus (pos zero) (intNeg y))
        (intNeg y)
        e4
        e5)
    }

