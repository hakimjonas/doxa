        (intNeg (intMult (pos n) (intMult (pos (succ m)) c)))
        (intMult (pos n) (intNeg (intMult (pos (succ m)) c))) = sym_e
        Int
        (intMult (pos n) (intNeg (intMult (pos (succ m)) c)))
        (intNeg (intMult (pos n) (intMult (pos (succ m)) c)))
        (intMult_neg_right (pos n) (intMult (pos (succ m)) c));
