// The six surface operators, for the manual grammar walkthrough.
// `->` is in the signature, `=>` in the match arms, `<=` and `==` in the
// match arms, and `*` and `+` in the arithmetic expression.
import "../../../../../doxa_stdlib/lib/stdlib/eqb_instances.doxa"

import "../../../../../doxa_stdlib/lib/stdlib/proofs.doxa"

fun inc(n: Nat): Nat -> Nat = (m: Nat) => succ m

fun classify(n: Nat): Bool = match n {
  case zero => n <= succ zero
  case succ _ => n == succ zero
}

fun compute(a: Nat, b: Nat): Nat = a * b + succ a
