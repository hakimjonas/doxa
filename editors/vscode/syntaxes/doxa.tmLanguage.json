{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode-grammars/main/schema/tmLanguage.json",
  "name": "Doxa",
  "scopeName": "source.doxa",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "/\\\\*",
          "end": "\\\\*/",
          "name": "comment.block.doxa"
        },
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.doxa"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.doxa",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.doxa"
        }
      ]
    },
    "numbers": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.doxa"
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(val|fun|data|type|match|case|returning|import|and|by|opaque|rec|struct|termination_by|where|as|typeclass|impl|theorem|with)\\b", "name": "keyword.control.doxa" },
        { "match": "\\b(if_|then_|else_)\\b", "name": "keyword.control.doxa" }
      ]
    },
    "types": {
      "patterns": [
        { "match": "\\b(Type)\\b", "name": "entity.name.type.doxa" },
        { "match": "\\b(Prop)\\b", "name": "entity.name.type.doxa" },
        { "match": "\\b(SProp)\\b", "name": "entity.name.type.doxa" }
      ]
    },
    "builtins": {
      "patterns": [
        { "match": "\\b(Quot)\\b", "name": "support.type.doxa" },
        { "match": "\\b(mk|lift|refl)\\b", "name": "support.function.doxa" }
      ]
    }
  }
}
