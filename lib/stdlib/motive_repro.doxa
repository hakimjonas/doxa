data Nat : Type { zero : Nat; succ : Nat -> Nat; }

data Bool : Type { true_ : Bool; false_ : Bool; }

fun plus(n: Nat, m: Nat) : Nat = match n {
  case zero => m
  case succ n_ => succ (plus n_ m)
}

fun mult(n: Nat, m: Nat) : Nat = match n {
  case zero => zero
  case succ n_ => plus m (mult n_ m)
}

fun mult_comm(n: Nat, m: Nat) : Eq Nat (mult n m) (mult m n) =
  Nat.ind ((k: Nat) => Eq Nat (mult k m) (mult m k))
    (refl zero)
    ((n_: Nat) => (ih: Eq Nat (mult n_ m) (mult m n_)) =>
      refl (mult (succ n_) m))
    n
