            (mult two (succ v))
            (succ k)
            (mult_two_succ v);
          val h_lt_succ_k: Lt (succ v) (succ k) = lt_t_succ_k (succ v) k h_succ_k_2t;
          val h_n_eq_succ_k: Eq Nat x (succ k) = trans_e
            Nat
            x
            (mult two (succ v))
            (succ k)
            h_sv
            (sym_e Nat (succ k) (mult two (succ v)) h_succ_k_2t);
          val h_lt: Lt (succ v) x = Eq.rec
            Nat
            ((a: Nat) => (b: Nat) => (_: Eq Nat a b) => Lt (succ v) a -> Lt (succ v) b)
            (succ k)
            x
            ((z: Nat) => (lt: Lt (succ v) z) => lt)
            (sym_e Nat x (succ k) h_n_eq_succ_k)
            h_lt_succ_k;
          val h_mult_two_t_eq: Eq Nat (mult two t) (mult two (succ v)) = trans_e
            Nat
            (mult two t)
            x
            (mult two (succ v))
            (sym_e Nat x (mult two t) h_double)
            h_sv;
          val h_t_eq_sv: Eq Nat t (succ v) = mult_2_inj t (succ v) h_mult_two_t_eq;
          val h_sq_sv_2u2: Eq Nat (square (succ v)) (mult two (square u)) = trans_e
            Nat
            (square (succ v))
            (square t)
            (mult two (square u))
            (cong_e Nat Nat square (succ v) t (sym_e Nat t (succ v) h_t_eq_sv))
            h_t2_2u2;
          val h_t_zero: Eq Nat (succ v) zero = ih (succ v) h_lt u h_sq_sv_2u2;
          False.rec ((_: False) => Eq Nat x zero) (succ_ne_zero v h_t_zero)
