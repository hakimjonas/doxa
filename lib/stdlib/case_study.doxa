    n
    m
    h
// Descent algebra: square t = 2 * square u
// Case analysis on t
// t = 0: x = 2*0 = 0
// t = succ v: descent
// Transport h_t2_2u2: square t = 2*(square u)  ->  square (succ v) = 2*(square u)
// Apply strong IH
// --- gcd correctness --------------------------------------------------------
// gcd_zero: gcd 0 n = n (definitional via match m { case zero => n }).

val gcd_zero: (n: Nat) -> Eq Nat (gcd zero n) n = (n: Nat) => refl n
// --- Prime number lemmas -----------------------------------------------------
// prime_two: 2 is prime (no divisors between 2 and 1).

val prime_two: Eq Bool (prime (succ (succ zero))) true_ = refl true_
// not_prime_zero: 0 is not prime (trial division fails immediately).

val not_prime_zero: Eq Bool (prime zero) false_ = refl false_
// not_prime_one: 1 is not prime (divisible only by itself).

val not_prime_one: Eq Bool (prime (succ zero)) false_ = refl false_
