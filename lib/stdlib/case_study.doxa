        (cong_e
          Nat
          Bool
          even
          (square m)
          (mult two (square t))
          (sym_e Nat (mult two (square t)) (square m) h_2t2_m2))
        (trans_e
          Bool
          (even (mult two (square t)))
          (even (plus (square t) (square t)))
          true_
          (cong_e
            Nat
            Bool
            even
            (mult two (square t))
            (plus (square t) (square t))
            (mult_2 (square t)))
          (even_double (square t)));
      val h_m_even: Eq Bool (even m) true_ = even_square_implies_even m h_m_sq_even;
      val h_m_double: Eq Nat m (mult two u) = even_implies_double m h_m_even;
      val h_2t2_sq2u: Eq Nat (mult two (square t)) (square (mult two u)) = trans_e
        Nat
        (mult two (square t))
        (square m)
        (square (mult two u))
        h_2t2_m2
        (cong_e Nat Nat square m (mult two u) h_m_double);
      val h_2t2_4u2: Eq Nat (mult two (square t)) (mult four (square u)) = trans_e
        Nat
        (mult two (square t))
        (square (mult two u))
        (mult four (square u))
