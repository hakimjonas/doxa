        (mult two (mult two (square u)))
        h_2t2_4u2
        (mult_4_eq (square u));
      val h_t2_2u2: Eq Nat (square t) (mult two (square u)) = mult_2_inj
        (square t)
        (mult two (square u))
        h_2t2_2_2u2;
      Nat.ind
        ((t0: Nat) => Eq Nat x (mult two t0) -> Eq Nat x zero)
        ((h0: Eq Nat x (mult two zero)) => trans_e Nat x (mult two zero) zero h0 (mult_zero two))
        ((v: Nat) => (_: Eq Nat x (mult two v) -> Eq Nat x zero) => (h_sv: Eq
          Nat
          x
          (mult two (succ v))) => {
