      val h_2t2_m2: Eq Nat (mult two (square t)) (square m) = mult_2_inj
        (mult two (square t))
        (square m)
        h_2_2t2_2m2;
      val h_m_sq_even: Eq Bool (even (square m)) true_ = trans_e
        Bool
        (even (square m))
        (even (mult two (square t)))
