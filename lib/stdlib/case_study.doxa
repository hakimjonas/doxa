// Case study: sqrt(2) is irrational.
// Full proof via parity theory, well-founded induction, and
// equational reasoning on Nat — no coprimality required.
import "bool.doxa"

import "nat.doxa"

import "proofs.doxa"
// even(n) = true_ iff n is even

fun even(n: Nat): Bool = match n {
  case zero => true_
  case succ n_ => match even n_ {
    case true_ => false_
    case false_ => true_
  }
}
// Small concrete parity facts

val even_0: Eq Bool (even zero) true_ = refl true_

val even_1: Eq Bool (even (succ zero)) false_ = refl false_

val even_2: Eq Bool (even (succ (succ zero))) true_ = refl true_

val even_3: Eq Bool (even (succ (succ (succ zero)))) false_ = refl false_
// twice n = n + n

fun twice(n: Nat): Nat = plus n n
// square n = n * n

fun square(n: Nat): Nat = mult n n
// evenness of squares for small n

val even_sq_0: Eq Bool (even (square zero)) true_ = refl true_

val even_sq_1: Eq Bool (even (square (succ zero))) false_ = refl false_

val even_sq_2: Eq Bool (even (square (succ (succ zero)))) true_ = refl true_

val even_sq_3: Eq Bool (even (square (succ (succ (succ zero))))) false_ = refl false_
// A number is divisible by 2 if it is even

fun divisibleBy2(n: Nat): Prop = Eq Bool (even n) true_
// The key property: if n is not even, then n^2 is not even
// This can be proved by induction on n (using the even function's
// alternating behavior). For now we verify the base cases.
// Nat aliases for small constants — surface syntax has no decimal literals.

val two: Nat = succ (succ zero)

val four: Nat = succ (succ (succ (succ zero)))
// --- Parity infrastructure ------------------------------------------------

fun parity_flip_b(b: Bool): Bool = match b {
  case true_ => false_
  case false_ => true_
}

val parity_flip_invol: (b: Bool) -> Eq Bool (parity_flip_b (parity_flip_b b)) b =
  Bool.ind ((b: Bool) => Eq Bool (parity_flip_b (parity_flip_b b)) b) (refl true_) (refl false_)

val even_succ_succ_eq_even: (n: Nat) -> Eq Bool (even (succ (succ n))) (even n) =
  Nat.ind
    ((k: Nat) => Eq Bool (even (succ (succ k))) (even k))
    (refl true_)
    ((k: Nat) => (ih: Eq Bool (even (succ (succ k))) (even k)) => trans_e
      Bool
      (even (succ (succ (succ k))))
      (parity_flip_b (even (succ (succ k))))
      (even (succ k))
      (refl (parity_flip_b (even (succ (succ k)))))
      (cong_e Bool Bool parity_flip_b (even (succ (succ k))) (even k) ih))
// even_double: plus n n is always even

val even_double: (n: Nat) -> Eq Bool (even (plus n n)) true_ =
  Nat.ind
    ((k: Nat) => Eq Bool (even (plus k k)) true_)
    (refl true_)
    ((k: Nat) => (ih: Eq Bool (even (plus k k)) true_) => trans_e
      Bool
      (even (plus (succ k) (succ k)))
      (even (succ (succ (plus k k))))
      true_
      (cong_e
        Nat
        Bool
        even
        (plus (succ k) (succ k))
        (succ (succ (plus k k)))
        (cong ((x: Nat) => succ x) (plus_succ k k)))
      (trans_e
        Bool
        (even (succ (succ (plus k k))))
        (even (plus k k))
        true_
        (even_succ_succ_eq_even (plus k k))
        ih))

fun parity_comb(p: Bool, q: Bool): Bool = match p {
  case true_ => q
  case false_ => match q {
    case true_ => false_
    case false_ => true_
  }
}

fun parity_flip_parity_comb_lemma(p: Bool, q: Bool): Eq
  Bool
  (parity_flip_b (parity_comb p q))
  (parity_comb (parity_flip_b p) q) =
  Bool.ind
    ((p: Bool) => (q: Bool)
    -> Eq Bool (parity_flip_b (parity_comb p q)) (parity_comb (parity_flip_b p) q))
    ((q: Bool) => refl (parity_flip_b q))
    ((q: Bool) => parity_flip_invol q)
    p
    q

val even_plus_parity: (a: Nat)
-> (b: Nat) -> Eq Bool (even (plus a b)) (parity_comb (even a) (even b)) =
  (a: Nat) => Nat.ind
    ((k: Nat) => (b: Nat) -> Eq Bool (even (plus k b)) (parity_comb (even k) (even b)))
    ((b: Nat) => refl (even b))
    ((k: Nat) => (ih: (b: Nat) -> Eq Bool (even (plus k b)) (parity_comb (even k) (even b))) => (b: Nat) => trans_e
      Bool
      (even (plus (succ k) b))
      (parity_flip_b (even (plus k b)))
      (parity_comb (parity_flip_b (even k)) (even b))
      (refl (parity_flip_b (even (plus k b))))
      (trans_e
        Bool
        (parity_flip_b (even (plus k b)))
        (parity_flip_b (parity_comb (even k) (even b)))
        (parity_comb (parity_flip_b (even k)) (even b))
        (cong_e Bool Bool parity_flip_b (even (plus k b)) (parity_comb (even k) (even b)) (ih b))
        (parity_flip_parity_comb_lemma (even k) (even b))))
    a
// square_succ_algebra: (k+1)^2 = succ (k + k + k^2)

val square_succ_algebra: (k: Nat) -> Eq Nat (square (succ k)) (succ (plus (plus k k) (square k))) =
  (k: Nat) => trans_e
    Nat
    (square (succ k))
    (mult (succ k) (succ k))
    (succ (plus (plus k k) (square k)))
    (refl (mult (succ k) (succ k)))
    (trans_e
      Nat
      (mult (succ k) (succ k))
      (plus (succ k) (mult (succ k) k))
      (succ (plus (plus k k) (square k)))
      (mult_succ_right (succ k) k)
      (trans_e
        Nat
        (plus (succ k) (mult (succ k) k))
        (plus (succ k) (mult k (succ k)))
        (succ (plus (plus k k) (square k)))
        (cong_e
          Nat
          Nat
          ((z: Nat) => plus (succ k) z)
          (mult (succ k) k)
          (mult k (succ k))
          (mult_comm (succ k) k))
        (trans_e
          Nat
          (plus (succ k) (mult k (succ k)))
          (succ (plus k (mult k (succ k))))
          (succ (plus (plus k k) (square k)))
          (refl (succ (plus k (mult k (succ k)))))
          (cong
            ((x: Nat) => succ x)
            (trans_e
              Nat
              (plus k (mult k (succ k)))
              (plus k (plus k (mult k k)))
              (plus (plus k k) (square k))
              (cong_e
                Nat
                Nat
                ((z: Nat) => plus k z)
                (mult k (succ k))
                (plus k (mult k k))
                (mult_succ_right k k))
              (sym_e
                Nat
                (plus (plus k k) (mult k k))
                (plus k (plus k (mult k k)))
                (plus_assoc k k (mult k k))))))))

fun parity_comb_true(x: Bool): Eq Bool (parity_comb true_ x) x =
  Bool.ind ((x: Bool) => Eq Bool (parity_comb true_ x) x) (refl true_) (refl false_) x

val even_plus_double: (n: Nat) -> (k: Nat) -> Eq Bool (even (plus (plus k k) n)) (even n) =
  (n: Nat) => (k: Nat) => trans_e
    Bool
    (even (plus (plus k k) n))
    (parity_comb (even (plus k k)) (even n))
    (even n)
    (even_plus_parity (plus k k) n)
    (trans_e
      Bool
      (parity_comb (even (plus k k)) (even n))
      (parity_comb true_ (even n))
      (even n)
      (cong_e
        Bool
        Bool
        ((x: Bool) => parity_comb x (even n))
        (even (plus k k))
        true_
        (even_double k))
      (parity_comb_true (even n)))

val even_square_eq: (k: Nat) -> Eq Bool (even (square k)) (even k) =
  Nat.ind
    ((k: Nat) => Eq Bool (even (square k)) (even k))
    (refl true_)
    ((k: Nat) => (ih: Eq Bool (even (square k)) (even k)) => trans_e
      Bool
      (even (square (succ k)))
      (parity_flip_b (even (square k)))
      (even (succ k))
      (trans_e
        Bool
        (even (square (succ k)))
        (even (succ (plus (plus k k) (square k))))
        (parity_flip_b (even (square k)))
        (cong_e
          Nat
          Bool
          even
          (square (succ k))
          (succ (plus (plus k k) (square k)))
          (square_succ_algebra k))
        (trans_e
          Bool
          (even (succ (plus (plus k k) (square k))))
          (parity_flip_b (even (plus (plus k k) (square k))))
          (parity_flip_b (even (square k)))
          (refl (parity_flip_b (even (plus (plus k k) (square k)))))
          (cong_e
            Bool
            Bool
            parity_flip_b
            (even (plus (plus k k) (square k)))
            (even (square k))
            (even_plus_double (square k) k))))
      (cong_e Bool Bool parity_flip_b (even (square k)) (even k) ih))

val even_square_even: (n: Nat) -> Eq Bool (even n) true_ -> Eq Bool (even (square n)) true_ =
  (n: Nat) => (h: Eq Bool (even n) true_) => trans_e
    Bool
    (even (square n))
    (even n)
    true_
    (even_square_eq n)
    h

val even_square_implies_even: (n: Nat) -> Eq Bool (even (square n)) true_ -> Eq Bool (even n) true_ =
  (n: Nat) => (h: Eq Bool (even (square n)) true_) => trans_e
    Bool
    (even n)
    (even (square n))
    true_
    (sym_e Bool (even (square n)) (even n) (even_square_eq n))
    h

val sqrt2_parity: (n: Nat)
-> (m: Nat) -> Eq Nat (square n) (mult two (square m)) -> Eq Bool (even n) true_ =
  (n: Nat) => (m: Nat) => (h_eq: Eq Nat (square n) (mult two (square m))) => trans_e
    Bool
    (even n)
    (even (square n))
    true_
    (sym_e Bool (even (square n)) (even n) (even_square_eq n))
    (trans_e
      Bool
      (even (square n))
      (even (mult two (square m)))
      true_
      (cong_e Nat Bool even (square n) (mult two (square m)) h_eq)
      (trans_e
        Bool
        (even (mult two (square m)))
        (even (plus (square m) (square m)))
        true_
        (cong_e Nat Bool even (mult two (square m)) (plus (square m) (square m)) (mult_2 (square m)))
        (even_double (square m))))
// --- Lt and well-founded recursion ----------------------------------------
// nat_wf: every Nat is accessible under Lt (well-foundedness).

fun nat_wf(n: Nat): Acc Nat ((x: Nat) => (y: Nat) => Lt x y) n = match n {
  case zero => acc_intro
    ((x: Nat) => (y: Nat) => Lt x y)
    zero
    ((y: Nat) => (h: Lt y zero) => False.rec
      ((_: False) => Acc Nat ((x: Nat) => (y: Nat) => Lt x y) y)
      (Lt.rec
        ((a: Nat) => (b: Nat) => (_: Lt a b) => Eq Nat b zero -> False)
        y
        zero
        ((n: Nat) => (eq: Eq Nat (succ n) zero) => succ_ne_zero n eq)
        ((n: Nat) => (m: Nat) => (k: Nat) => (_: Lt n m) => (_: Lt m k) => (ih1: Eq Nat m zero
        -> False) => (ih2: Eq Nat k zero -> False) => (eq: Eq Nat k zero) => ih2 eq)
        h
        (refl zero)))
  case succ k => acc_intro
    ((x: Nat) => (y: Nat) => Lt x y)
    (succ k)
    ((y: Nat) => (h: Lt y (succ k)) => nat_wf_help k y h)
} and nat_wf_help(k: Nat, y: Nat, h: Lt y (succ k)): Acc Nat ((x: Nat) => (y: Nat) => Lt x y) y {struct h} = match h {
  case lt_succ y_ => nat_wf y_
  case lt_trans y_ m _ p1 p2 => match nat_wf_help k m p2 {
    case acc_intro _ _ f => f y_ p1
  }
}
// --- Algebraic lemmas ----------------------------------------------------

fun half(n: Nat): Nat = match n {
  case zero => zero
  case succ n_ => match n_ {
    case zero => zero
    case succ n__ => succ (half n__)
  }
}

val lt_succ_right: (n: Nat) -> (m: Nat) -> Lt n m -> Lt n (succ m) =
  (n: Nat) => (m: Nat) => (h: Lt n m) => lt_trans n m (succ m) h (lt_succ m)
// --- Algebraic lemmas for the sqrt2 proof --------------------------------
// mult_4_eq: mult 4 n = mult 2 (mult 2 n)

val mult_4_eq: (n: Nat) -> Eq Nat (mult four n) (mult two (mult two n)) =
  (n: Nat) => mult_assoc two two n
// --- mult_two_succ: mult two (succ n) = succ (succ (mult two n)) ------------

val mult_two_succ: (n: Nat) -> Eq Nat (mult two (succ n)) (succ (succ (mult two n))) =
  (n: Nat) => trans_e
    Nat
    (mult two (succ n))
    (plus (succ n) (succ n))
    (succ (succ (mult two n)))
    (mult_2 (succ n))
    (trans_e
      Nat
      (plus (succ n) (succ n))
      (succ (plus (succ n) n))
      (succ (succ (mult two n)))
      (plus_succ (succ n) n)
      (trans_e
        Nat
        (succ (plus (succ n) n))
        (succ (plus n (succ n)))
        (succ (succ (mult two n)))
        (cong ((x: Nat) => succ x) (plus_comm (succ n) n))
        (trans_e
          Nat
          (succ (plus n (succ n)))
          (succ (succ (plus n n)))
          (succ (succ (mult two n)))
          (cong ((x: Nat) => succ x) (plus_succ n n))
          (cong
            ((x: Nat) => succ x)
            (cong ((x: Nat) => succ x) (sym_e Nat (mult two n) (plus n n) (mult_2 n)))))))
// --- mult_2_inj: mult two is injective -----------------------------------

val mult_2_inj: (a: Nat) -> (b: Nat) -> (h: Eq Nat (mult two a) (mult two b)) -> Eq Nat a b =
  (a: Nat) => Nat.ind
    ((x: Nat) => (b: Nat) -> (h: Eq Nat (mult two x) (mult two b)) -> Eq Nat x b)
    ((b: Nat) => (h: Eq Nat (mult two zero) (mult two b)) => Nat.ind
      ((x: Nat) => Eq Nat (mult two zero) (mult two x) -> Eq Nat zero x)
      ((h0: Eq Nat (mult two zero) (mult two zero)) => refl zero)
      ((x: Nat) => (_: Eq Nat (mult two zero) (mult two x) -> Eq Nat zero x) => (h_sx: Eq
        Nat
        (mult two zero)
        (mult two (succ x))) => False.rec
        ((_: False) => Eq Nat zero (succ x))
        (succ_ne_zero
          (succ (mult two x))
          (trans_e
            Nat
            (succ (succ (mult two x)))
            (mult two (succ x))
            (mult two zero)
            (sym_e Nat (mult two (succ x)) (succ (succ (mult two x))) (mult_two_succ x))
            (sym_e Nat (mult two zero) (mult two (succ x)) h_sx))))
      b
      h)
    ((k: Nat) => (ih: (b: Nat) -> (h: Eq Nat (mult two k) (mult two b)) -> Eq Nat k b) => (b: Nat) => (h: Eq
      Nat
      (mult two (succ k))
      (mult two b)) => Nat.ind
      ((x: Nat) => Eq Nat (mult two (succ k)) (mult two x) -> Eq Nat (succ k) x)
      ((h0: Eq Nat (mult two (succ k)) (mult two zero)) => False.rec
        ((_: False) => Eq Nat (succ k) zero)
        (succ_ne_zero
          (succ (mult two k))
          (trans_e
            Nat
            (succ (succ (mult two k)))
            (mult two (succ k))
            zero
            (sym_e Nat (mult two (succ k)) (succ (succ (mult two k))) (mult_two_succ k))
            (trans_e Nat (mult two (succ k)) (mult two zero) zero h0 (mult_zero two)))))
      ((x: Nat) => (_: Eq Nat (mult two (succ k)) (mult two x) -> Eq Nat (succ k) x) => (h_sx: Eq
        Nat
        (mult two (succ k))
        (mult two (succ x))) => cong_e
        Nat
        Nat
        ((y: Nat) => succ y)
        k
        x
        (ih
          x
          (succ_inj
            (mult two k)
            (mult two x)
            (succ_inj
              (succ (mult two k))
              (succ (mult two x))
              (trans_e
                Nat
                (succ (succ (mult two k)))
                (mult two (succ k))
                (succ (succ (mult two x)))
                (sym_e Nat (mult two (succ k)) (succ (succ (mult two k))) (mult_two_succ k))
                (trans_e
                  Nat
                  (mult two (succ k))
                  (mult two (succ x))
                  (succ (succ (mult two x)))
                  h_sx
                  (mult_two_succ x)))))))
      b
      h)
    a
// --- square_double: (2n)² = 4·n² -----------------------------------------

val square_double: (n: Nat) -> Eq Nat (square (mult two n)) (mult four (square n)) =
  (n: Nat) => trans_e
    Nat
    (square (mult two n))
    (mult (mult two n) (mult two n))
    (mult four (square n))
    (refl (mult (mult two n) (mult two n)))
    (trans_e
      Nat
      (mult (mult two n) (mult two n))
      (mult two (mult n (mult two n)))
      (mult four (square n))
      (mult_assoc two n (mult two n))
      (trans_e
        Nat
        (mult two (mult n (mult two n)))
        (mult two (mult (mult two n) n))
        (mult four (square n))
        (cong_e
          Nat
          Nat
          (mult two)
          (mult n (mult two n))
          (mult (mult two n) n)
          (mult_comm n (mult two n)))
        (trans_e
          Nat
          (mult two (mult (mult two n) n))
          (mult two (mult two (mult n n)))
          (mult four (square n))
          (cong_e
            Nat
            Nat
            (mult two)
            (mult (mult two n) n)
            (mult two (mult n n))
            (mult_assoc two n n))
          (trans_e
            Nat
            (mult two (mult two (mult n n)))
            (mult (mult two two) (mult n n))
            (mult four (square n))
            (sym_e
              Nat
              (mult (mult two two) (mult n n))
              (mult two (mult two (mult n n)))
              (mult_assoc two two (mult n n)))
            (trans_e
              Nat
              (mult (mult two two) (mult n n))
              (mult four (mult n n))
              (mult four (square n))
              (cong_e
                Nat
                Nat
                ((x: Nat) => mult x (mult n n))
                (mult two two)
                four
                (trans_e Nat (mult two two) (plus two two) four (mult_2 two) (refl four)))
              (refl (mult four (mult n n))))))))
// lt_succ_mono: Lt a b → Lt (succ a) (succ b)

fun lt_succ_mono(a: Nat, b: Nat, h: Lt a b): Lt (succ a) (succ b) {struct h} = match h {
  case lt_succ n => lt_succ (succ n)
  case lt_trans n m k p1 p2 => lt_trans
    (succ n)
    (succ m)
    (succ k)
    (lt_succ_mono n m p1)
    (lt_succ_mono m k p2)
}

fun even_implies_double(n: Nat, h: Eq Bool (even n) true_): Eq Nat n (mult two (half n)) = go n h and go(n: Nat, h0: Eq
  Bool
  (even n)
  true_): Eq Nat n (mult two (half n)) =
  Nat.ind
    ((m: Nat) => Eq Bool (even m) true_ -> Eq Nat m (mult two (half m)))
    ((hz: Eq Bool (even zero) true_) => trans_e
      Nat
      zero
      (mult two zero)
      (mult two (half zero))
      (sym_e
        Nat
        (mult two zero)
        zero
        (trans_e Nat (mult two zero) (plus zero zero) zero (mult_2 zero) (plus_zero zero)))
      (refl (mult two (half zero))))
    ((k: Nat) => (ih: Eq Bool (even k) true_ -> Eq Nat k (mult two (half k))) => (hsk: Eq
      Bool
      (even (succ k))
      true_) => Nat.ind
      ((j: Nat) => Eq Bool (even (succ j)) true_ -> Eq Nat (succ j) (mult two (half (succ j))))
      ((hsz: Eq Bool (even (succ zero)) true_) => False.rec
        ((_: False) => Eq Nat (succ zero) (mult two (half (succ zero))))
        (true_ne_false (cong_e Bool Bool parity_flip_b (even (succ zero)) true_ hsz)))
      ((m: Nat) => (ihm: Eq Bool (even (succ m)) true_ -> Eq Nat (succ m) (mult two (half (succ m)))) => (hssm: Eq
        Bool
        (even (succ (succ m)))
        true_) => {
        val even_m_true: Eq Bool (even m) true_ = trans_e
          Bool
          (even m)
          (even (succ (succ m)))
          true_
          (sym_e Bool (even (succ (succ m))) (even m) (even_succ_succ_eq_even m))
          hssm;
        val rec_m: Eq Nat m (mult two (half m)) = go m even_m_true;
        trans_e
          Nat
          (succ (succ m))
          (succ (succ (mult two (half m))))
          (mult two (half (succ (succ m))))
          (cong_e Nat Nat ((x: Nat) => succ (succ x)) m (mult two (half m)) rec_m)
          (sym_e
            Nat
            (mult two (half (succ (succ m))))
            (succ (succ (mult two (half m))))
            (mult_two_succ (half m)))
        })
      k
      hsk)
    n
    h0
// --- lt_succ_t_mult_two_t: succ t < 2*(succ t) -----------------------------

val lt_succ_t_mult_two_t: (t: Nat) -> Lt (succ t) (mult two (succ t)) =
  Nat.ind
    ((t: Nat) => Lt (succ t) (mult two (succ t)))
    (lt_succ (succ zero))
    ((u: Nat) => (ih: Lt (succ u) (mult two (succ u))) => {
      val h_lt_succ_ss: Lt (succ (succ u)) (succ (mult two (succ u))) = lt_succ_mono
        (succ u)
        (mult two (succ u))
        ih;
      val h_lt_ss_ssmu: Lt (succ (succ u)) (succ (succ (mult two (succ u)))) = lt_succ_right
        (succ (succ u))
        (succ (mult two (succ u)))
        h_lt_succ_ss;
      Eq.rec
        Nat
        ((a: Nat) => (b: Nat) => (p: Eq Nat a b) => Lt (succ (succ u)) a -> Lt (succ (succ u)) b)
        (succ (succ (mult two (succ u))))
        (mult two (succ (succ u)))
        ((z: Nat) => (h: Lt (succ (succ u)) z) => h)
        (sym_e
          Nat
          (mult two (succ (succ u)))
          (succ (succ (mult two (succ u))))
          (mult_two_succ (succ u)))
        h_lt_ss_ssmu
      })
// --- lt_t_succ_k: if succ k = 2*t then t < succ k --------------------------

fun lt_t_succ_k(t: Nat, k: Nat, h: Eq Nat (succ k) (mult two t)): Lt t (succ k) =
  Nat.ind
    ((t: Nat) => (k: Nat) -> Eq Nat (succ k) (mult two t) -> Lt t (succ k))
    ((k: Nat) => (h_zero: Eq Nat (succ k) (mult two zero)) => False.rec
      ((_: False) => Lt zero (succ k))
      (succ_ne_zero k (trans_e Nat (succ k) (mult two zero) zero h_zero (mult_zero two))))
    ((u: Nat) => (ih: (k: Nat) -> Eq Nat (succ k) (mult two u) -> Lt u (succ k)) => (k: Nat) => (h_succ_u: Eq
      Nat
      (succ k)
      (mult two (succ u))) => Eq.rec
      Nat
      ((a: Nat) => (b: Nat) => (p: Eq Nat a b) => Lt (succ u) a -> Lt (succ u) b)
      (mult two (succ u))
      (succ k)
      ((z: Nat) => (h_l: Lt (succ u) z) => h_l)
      (sym_e Nat (succ k) (mult two (succ u)) h_succ_u)
      (lt_succ_t_mult_two_t u))
    t
    k
    h
// --- Strong induction on Nat via Lt ----------------------------------------
// --- sqrt2: √2 is irrational -------------------------------------------------

val sqrt2: (n: Nat) -> (m: Nat) -> Eq Nat (square n) (mult two (square m)) -> Eq Nat n zero =
  (n: Nat) => (m: Nat) => (h: Eq Nat (square n) (mult two (square m))) => strong_ind
    ((x: Nat) => (m: Nat) -> Eq Nat (square x) (mult two (square m)) -> Eq Nat x zero)
    ((x: Nat) => (ih: (k: Nat)
    -> Lt k x -> (m: Nat) -> Eq Nat (square k) (mult two (square m)) -> Eq Nat k zero) => (m: Nat) => (h_x: Eq
      Nat
      (square x)
      (mult two (square m))) => {
      val h_even: Eq Bool (even x) true_ = sqrt2_parity x m h_x;
      val h_double: Eq Nat x (mult two (half x)) = even_implies_double x h_even;
