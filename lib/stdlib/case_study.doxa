// Case study: foundations for proving sqrt(2) is irrational.
// Defines evenness, square, and basic parity lemmas.
// The full proof requires induction and rewriting tactics
// that will be added in a future phase.
import "bool.doxa"

import "nat.doxa"

import "proofs.doxa"
// even(n) = true_ iff n is even

fun even(n: Nat) : Bool = match n {
  case zero => true_
  case succ n_ => match even n_ {
    case true_ => false_
    case false_ => true_
  }
}
// Small concrete parity facts

val even_0 : Eq Bool (even zero) true_ = refl true_

val even_1 : Eq Bool (even (succ zero)) false_ = refl false_

val even_2 : Eq Bool (even (succ (succ zero))) true_ = refl true_

val even_3 : Eq Bool (even (succ (succ (succ zero)))) false_ = refl false_
// twice n = n + n

fun twice(n: Nat) : Nat = plus n n
// square n = n * n

fun square(n: Nat) : Nat = mult n n
// evenness of squares for small n

val even_sq_0 : Eq Bool (even (square zero)) true_ = refl true_

val even_sq_1 : Eq Bool (even (square (succ zero))) false_ = refl false_

val even_sq_2 : Eq Bool (even (square (succ (succ zero)))) true_ = refl true_

val even_sq_3 : Eq Bool (even (square (succ (succ (succ zero))))) false_ = refl false_
// A number is divisible by 2 if it is even

fun divisibleBy2(n: Nat) : Prop = Eq Bool (even n) true_
// The key property: if n is not even, then n^2 is not even
// This can be proved by induction on n (using the even function's
// alternating behavior). For now we verify the base cases.
// Nat aliases for small constants — surface syntax has no decimal literals.

val two : Nat = succ (succ zero)

val four : Nat = succ (succ (succ (succ zero)))
// --- Parity infrastructure ------------------------------------------------

fun parity_flip_b(b: Bool) : Bool = match b {
  case true_ => false_
  case false_ => true_
}

val parity_flip_invol : (b: Bool) -> Eq Bool (parity_flip_b (parity_flip_b b)) b = Bool.ind ((b: Bool) => Eq Bool (parity_flip_b (parity_flip_b b)) b) (refl true_) (refl false_)

val even_succ_succ_eq_even : (n: Nat) -> Eq Bool (even (succ (succ n))) (even n) = Nat.ind ((k: Nat) => Eq Bool (even (succ (succ k))) (even k)) (refl true_) ((k: Nat) => (ih: Eq Bool (even (succ (succ k))) (even k)) => trans_e Bool (even (succ (succ (succ k)))) (parity_flip_b (even (succ (succ k)))) (even (succ k)) (refl (parity_flip_b (even (succ (succ k))))) (cong_e Bool Bool parity_flip_b (even (succ (succ k))) (even k) ih))
// even_double: plus n n is always even

val even_double : (n: Nat) -> Eq Bool (even (plus n n)) true_ = Nat.ind ((k: Nat) => Eq Bool (even (plus k k)) true_) (refl true_) ((k: Nat) => (ih: Eq Bool (even (plus k k)) true_) => trans_e Bool (even (plus (succ k) (succ k))) (even (succ (succ (plus k k)))) true_ (cong_e Nat Bool even (plus (succ k) (succ k)) (succ (succ (plus k k))) (cong ((x: Nat) => succ x) (plus_succ k k))) (trans_e Bool (even (succ (succ (plus k k)))) (even (plus k k)) true_ (even_succ_succ_eq_even (plus k k)) ih))

fun parity_comb(p: Bool, q: Bool) : Bool = match p {
  case true_ => q
  case false_ => match q {
    case true_ => false_
    case false_ => true_
  }
}

fun parity_flip_parity_comb_lemma(p: Bool, q: Bool) : Eq Bool (parity_flip_b (parity_comb p q)) (parity_comb (parity_flip_b p) q) = Bool.ind ((p: Bool) => (q: Bool) -> Eq Bool (parity_flip_b (parity_comb p q)) (parity_comb (parity_flip_b p) q)) ((q: Bool) => refl (parity_flip_b q)) ((q: Bool) => parity_flip_invol q) p q

val even_plus_parity : (a: Nat) -> (b: Nat) -> Eq Bool (even (plus a b)) (parity_comb (even a) (even b)) = (a: Nat) => Nat.ind ((k: Nat) => (b: Nat) -> Eq Bool (even (plus k b)) (parity_comb (even k) (even b))) ((b: Nat) => refl (even b)) ((k: Nat) => (ih: (b: Nat) -> Eq Bool (even (plus k b)) (parity_comb (even k) (even b))) => (b: Nat) => trans_e Bool (even (plus (succ k) b)) (parity_flip_b (even (plus k b))) (parity_comb (parity_flip_b (even k)) (even b)) (refl (parity_flip_b (even (plus k b)))) (trans_e Bool (parity_flip_b (even (plus k b))) (parity_flip_b (parity_comb (even k) (even b))) (parity_comb (parity_flip_b (even k)) (even b)) (cong_e Bool Bool parity_flip_b (even (plus k b)) (parity_comb (even k) (even b)) (ih b)) (parity_flip_parity_comb_lemma (even k) (even b)))) a
// square_succ_algebra: (k+1)^2 = succ (k + k + k^2)

val square_succ_algebra : (k: Nat) -> Eq Nat (square (succ k)) (succ (plus (plus k k) (square k))) = (k: Nat) => trans_e Nat (square (succ k)) (mult (succ k) (succ k)) (succ (plus (plus k k) (square k))) (refl (mult (succ k) (succ k))) (trans_e Nat (mult (succ k) (succ k)) (plus (succ k) (mult (succ k) k)) (succ (plus (plus k k) (square k))) (mult_succ_right (succ k) k) (trans_e Nat (plus (succ k) (mult (succ k) k)) (plus (succ k) (mult k (succ k))) (succ (plus (plus k k) (square k))) (cong_e Nat Nat ((z: Nat) => plus (succ k) z) (mult (succ k) k) (mult k (succ k)) (mult_comm (succ k) k)) (trans_e Nat (plus (succ k) (mult k (succ k))) (succ (plus k (mult k (succ k)))) (succ (plus (plus k k) (square k))) (refl (succ (plus k (mult k (succ k))))) (cong ((x: Nat) => succ x) (trans_e Nat (plus k (mult k (succ k))) (plus k (plus k (mult k k))) (plus (plus k k) (square k)) (cong_e Nat Nat ((z: Nat) => plus k z) (mult k (succ k)) (plus k (mult k k)) (mult_succ_right k k)) (sym_e Nat (plus (plus k k) (mult k k)) (plus k (plus k (mult k k))) (plus_assoc k k (mult k k))))))))

fun parity_comb_true(x: Bool) : Eq Bool (parity_comb true_ x) x = Bool.ind ((x: Bool) => Eq Bool (parity_comb true_ x) x) (refl true_) (refl false_) x

val even_plus_double : (n: Nat) -> (k: Nat) -> Eq Bool (even (plus (plus k k) n)) (even n) = (n: Nat) => (k: Nat) => trans_e Bool (even (plus (plus k k) n)) (parity_comb (even (plus k k)) (even n)) (even n) (even_plus_parity (plus k k) n) (trans_e Bool (parity_comb (even (plus k k)) (even n)) (parity_comb true_ (even n)) (even n) (cong_e Bool Bool ((x: Bool) => parity_comb x (even n)) (even (plus k k)) true_ (even_double k)) (parity_comb_true (even n)))

val even_square_eq : (k: Nat) -> Eq Bool (even (square k)) (even k) = Nat.ind ((k: Nat) => Eq Bool (even (square k)) (even k)) (refl true_) ((k: Nat) => (ih: Eq Bool (even (square k)) (even k)) => trans_e Bool (even (square (succ k))) (parity_flip_b (even (square k))) (even (succ k)) (trans_e Bool (even (square (succ k))) (even (succ (plus (plus k k) (square k)))) (parity_flip_b (even (square k))) (cong_e Nat Bool even (square (succ k)) (succ (plus (plus k k) (square k))) (square_succ_algebra k)) (trans_e Bool (even (succ (plus (plus k k) (square k)))) (parity_flip_b (even (plus (plus k k) (square k)))) (parity_flip_b (even (square k))) (refl (parity_flip_b (even (plus (plus k k) (square k))))) (cong_e Bool Bool parity_flip_b (even (plus (plus k k) (square k))) (even (square k)) (even_plus_double (square k) k)))) (cong_e Bool Bool parity_flip_b (even (square k)) (even k) ih))

val even_square_even : (n: Nat) -> Eq Bool (even n) true_ -> Eq Bool (even (square n)) true_ = (n: Nat) => (h: Eq Bool (even n) true_) => trans_e Bool (even (square n)) (even n) true_ (even_square_eq n) h

val even_square_implies_even : (n: Nat) -> Eq Bool (even (square n)) true_ -> Eq Bool (even n) true_ = (n: Nat) => (h: Eq Bool (even (square n)) true_) => trans_e Bool (even n) (even (square n)) true_ (sym_e Bool (even (square n)) (even n) (even_square_eq n)) h

val sqrt2_parity : (n: Nat) -> (m: Nat) -> Eq Nat (square n) (mult two (square m)) -> Eq Bool (even n) true_ = (n: Nat) => (m: Nat) => (h_eq: Eq Nat (square n) (mult two (square m))) => trans_e Bool (even n) (even (square n)) true_ (sym_e Bool (even (square n)) (even n) (even_square_eq n)) (trans_e Bool (even (square n)) (even (mult two (square m))) true_ (cong_e Nat Bool even (square n) (mult two (square m)) h_eq) (trans_e Bool (even (mult two (square m))) (even (plus (square m) (square m))) true_ (cong_e Nat Bool even (mult two (square m)) (plus (square m) (square m)) (mult_2 (square m))) (even_double (square m))))
// --- Lt and well-founded recursion ----------------------------------------

data Lt : Nat -> Nat -> Prop {
  lt_succ : (n: Nat) -> Lt n (succ n);
  lt_trans : (n: Nat) -> (m: Nat) -> (k: Nat) -> Lt n m -> Lt m k -> Lt n k;
}
// nat_wf: every Nat is accessible under Lt (well-foundedness).

fun nat_wf(n: Nat) : Acc Nat ((x: Nat) => (y: Nat) => Lt x y) n = match n {
  case zero => acc_intro ((x: Nat) => (y: Nat) => Lt x y) zero ((y: Nat) => (h: Lt y zero) => False.rec ((_: False) => Acc Nat ((x: Nat) => (y: Nat) => Lt x y) y) (Lt.rec ((a: Nat) => (b: Nat) => (_: Lt a b) => Eq Nat b zero -> False) y zero ((n: Nat) => (eq: Eq Nat (succ n) zero) => succ_ne_zero n eq) ((n: Nat) => (m: Nat) => (k: Nat) => (_: Lt n m) => (_: Lt m k) => (ih1: Eq Nat m zero -> False) => (ih2: Eq Nat k zero -> False) => (eq: Eq Nat k zero) => ih2 eq) h (refl zero)))
  case succ k => acc_intro ((x: Nat) => (y: Nat) => Lt x y) (succ k) ((y: Nat) => (h: Lt y (succ k)) => nat_wf_help k y h)
} and nat_wf_help(k: Nat, y: Nat, h: Lt y (succ k)) : Acc Nat ((x: Nat) => (y: Nat) => Lt x y) y {struct h} = match h {
  case lt_succ y_ => nat_wf y_
  case lt_trans y_ m _ p1 p2 => match nat_wf_help k m p2 {
    case acc_intro _ _ f => f y_ p1
  }
}
// --- Algebraic lemmas ----------------------------------------------------

fun half(n: Nat) : Nat = match n {
  case zero => zero
  case succ n_ => match n_ {
    case zero => zero
    case succ n__ => succ (half n__)
  }
}

val lt_succ_right : (n: Nat) -> (m: Nat) -> Lt n m -> Lt n (succ m) = (n: Nat) => (m: Nat) => (h: Lt n m) => lt_trans n m (succ m) h (lt_succ m)
// --- Algebraic lemmas for the sqrt2 proof --------------------------------
// mult_4_eq: mult 4 n = mult 2 (mult 2 n)

val mult_4_eq : (n: Nat) -> Eq Nat (mult four n) (mult two (mult two n)) = (n: Nat) => mult_assoc two two n
// --- Remaining lemmas (to be completed) ----------------------------------
//
// lt_half_succ: (k: Nat) -> Lt (succ k) (mult two (succ k))
//   Proof via lt_succ and transitivity bridging mult 2 (succ k)
//   and succ (succ (plus k k)).
//
// even_implies_double: (n: Nat) -> Eq Bool (even n) true_ ->
//   Eq Nat n (mult two (half n))
//   Proof by induction on n.
//
// mult_2_inj: (a: Nat) -> (b: Nat) ->
//   Eq Nat (mult two a) (mult two b) -> Eq Nat a b
//   Proof by induction on a with plus cancellation.
//
// square_double: (n: Nat) ->
//   Eq Nat (square (mult two n)) (mult four (square n))
//   Proof by algebra using mult_comm, mult_assoc, mult_plus.
//
// --- mult_two_succ: mult two (succ n) = succ (succ (mult two n)) ------------

val mult_two_succ : (n: Nat) -> Eq Nat (mult two (succ n)) (succ (succ (mult two n))) = (n: Nat) =>
  trans_e Nat (mult two (succ n))
    (plus (succ n) (succ n))
    (succ (succ (mult two n)))
    (mult_2 (succ n))
    (trans_e Nat (plus (succ n) (succ n))
      (succ (plus (succ n) n))
      (succ (succ (mult two n)))
      (plus_succ (succ n) n)
      (trans_e Nat (succ (plus (succ n) n))
        (succ (plus n (succ n)))
        (succ (succ (mult two n)))
        (cong ((x: Nat) => succ x) (plus_comm (succ n) n))
        (trans_e Nat (succ (plus n (succ n)))
          (succ (succ (plus n n)))
          (succ (succ (mult two n)))
          (cong ((x: Nat) => succ x) (plus_succ n n))
          (cong ((x: Nat) => succ x) (cong ((x: Nat) => succ x) (sym_e Nat (mult two n) (plus n n) (mult_2 n)))))))

// --- Theorem: n^2 = 2*m^2 implies n = 0 ---------------------------------
//
// Proved by structural induction on n (avoids the nat_wf mutual-block
// issue). From sqrt2_parity we get even n = true_. Case analysis on n
// shows n must be zero, or the parity algebra forces a contradiction.
// Requires even_implies_double, mult_2_inj, square_double, mult_4_eq.
