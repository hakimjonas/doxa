import "bool.doxa"
import "eq.doxa"
import "nat.doxa"
import "proofs.doxa"

data Int : Type {
  pos : Nat -> Int;
  neg : Nat -> Int;
}

fun intNeg(a: Int) : Int = match a {
  case pos n => match n {
    case zero => pos zero
    case succ n_ => neg n_
  }
  case neg n => pos (succ n)
}

val intNeg_neg : (a: Int) -> Eq Int (intNeg (intNeg a)) a = Int.ind ((x: Int) => Eq Int (intNeg (intNeg x)) x) ((n: Nat) => Nat.ind ((k: Nat) => Eq Int (intNeg (intNeg (pos k))) (pos k)) (refl (pos zero)) ((k: Nat) => (_: Eq Int (intNeg (intNeg (pos k))) (pos k)) => refl (pos (succ k))) n) ((n: Nat) => refl (neg n))
