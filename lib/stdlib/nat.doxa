// Natural numbers and basic arithmetic.
//
// Written in implicit style: no explicit type passing, pattern
// unification solves the type arguments.
import "bool.doxa"

data Nat : Type {
  zero : Nat;
  succ : Nat -> Nat;
}

fun plus(m: Nat, n: Nat) : Nat = match m {
  case zero => n
  case succ m_ => succ (plus m_ n)
}

fun mult(m: Nat, n: Nat) : Nat = match m {
  case zero => zero
  case succ m_ => plus n (mult m_ n)
}// `pow exp base`: exp^base. Note the arg order, `exp` is the
// decreasing argument, and the decreasing arg must be the first
// explicit value parameter. Without per-argument `{struct}`
// annotations (Coq's shape), users match on the first arg or
// eta-wrap the call.

fun pow(exp: Nat, base: Nat) : Nat = match exp {
  case zero => succ zero
  case succ e_ => mult base (pow e_ base)
}// Non-strict "less-or-equal": leq m n = true_ iff m ≤ n.

fun leq(m: Nat, n: Nat) : Bool = match m {
  case zero => true_
  case succ m_ => match n {
    case zero => false_
    case succ n_ => leq m_ n_
  }
}// Truncated subtraction: sub m n = m - n, or 0 if m < n.

fun sub(m: Nat, n: Nat) : Nat = match m {
  case zero => zero
  case succ m_ => match n {
    case zero => succ m_
    case succ n_ => sub m_ n_
  }
}// Strict less-than: lt m n = true_ iff m < n.

fun lt(m: Nat, n: Nat) : Bool = match n {
  case zero => false_
  case succ n_ => leq m n_
}// Modulo via iterated subtraction: mod_acc k m n keeps subtracting n
// from m up to k times.  Structurally recursive on k (first arg).

fun mod_acc(k: Nat, m: Nat, n: Nat) : Nat = match k {
  case zero => m
  case succ k_ => match lt m n {
    case true_ => m
    case false_ => mod_acc k_ (sub m n) n
  }
}// mod m n: compute m % n by iterating up to m times (worst case).

val mod : (m: Nat) -> (n: Nat) -> Nat = (m: Nat) => (n: Nat) => mod_acc m m n
// Greatest common divisor via Euclid's algorithm.  Structurally
// recursive on the first argument (k is the iteration bound).

fun gcd_acc(k: Nat, m: Nat, n: Nat) : Nat = match k {
  case zero => m
  case succ k_ => match n {
    case zero => m
    case succ n_ => gcd_acc k_ n (mod m n)
  }
}

val gcd : (m: Nat) -> (n: Nat) -> Nat = (m: Nat) => (n: Nat) => gcd_acc m m n
// Integer division: div m n = floor(m / n), 0 if n = 0.
// Uses iterated subtraction, structurally recursive on k.

fun div_acc(k: Nat, m: Nat, n: Nat) : Nat = match k {
  case zero => zero
  case succ k_ => match lt m n {
    case true_ => zero
    case false_ => succ (div_acc k_ (sub m n) n)
  }
}

val div : (m: Nat) -> (n: Nat) -> Nat = (m: Nat) => (n: Nat) => match n {
  case zero => zero
  case succ n_ => div_acc m m n
}// Least common multiple: lcm m n = m * n / gcd m n

val lcm : (m: Nat) -> (n: Nat) -> Nat = (m: Nat) => (n: Nat) => div (mult m n) (gcd m n)
// Coprime: gcd m n == 1

val coprime : (m: Nat) -> (n: Nat) -> Bool = (m: Nat) => (n: Nat) => leq (gcd m n) (succ zero)
// Divisibility: does d divide n?  True when d > 0 and n % d == 0.

val divides : (d: Nat) -> (n: Nat) -> Bool = (d: Nat) => (n: Nat) => match d {
  case zero => false_
  case succ d_ => leq (mod n (succ d_)) zero
}// Prime: n >= 2 and has no divisor d where 2 <= d < n.

fun prime_acc(k: Nat, n: Nat) : Bool = match k {
  case zero => true_
  case succ k_ => match lt (succ (succ k_)) n {
    case true_ => match divides (succ (succ k_)) n {
      case true_ => false_
      case false_ => prime_acc k_ n
    }
    case false_ => true_
  }
}

val prime : (n: Nat) -> Bool = (n: Nat) => prime_acc n n
