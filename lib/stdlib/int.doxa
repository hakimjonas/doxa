// Integers: Int = Pos Nat | Neg Nat where Pos n = n, Neg n = -(n+1).
// Zero is Pos zero, avoiding double representation of zero.
import "bool.doxa"

import "eq.doxa"

import "nat.doxa"

import "proofs.doxa"

data Int: Type {
  pos: Nat -> Int;
  neg: Nat -> Int;
}
// Helper for intPlus with mixed signs: pos n + neg m = n - (m+1)

fun intPlusHelp(n: Nat, m: Nat): Int = match n {
  case zero => neg m
  case succ n_ => match m {
    case zero => pos n_
    case succ m_ => intPlusHelp n_ m_
  }
}

fun intPlus(a: Int, b: Int): Int = match a {
  case pos n => match b {
    case pos m => pos (plus n m)
    case neg m => intPlusHelp n m
  }
  case neg n => match b {
    case pos m => intPlusHelp m n
    case neg m => neg (succ (plus n m))
  }
}

fun intNeg(a: Int): Int = match a {
  case pos n => match n {
    case zero => pos zero
    case succ n_ => neg n_
  }
  case neg n => pos (succ n)
}

fun intSub(a: Int, b: Int): Int = intPlus a (intNeg b)

fun intMult(a: Int, b: Int): Int = match a {
  case pos n => match b {
    case pos m => pos (mult n m)
    case neg m => intNeg (pos (mult n (succ m)))
  }
  case neg n => match b {
    case pos m => intNeg (pos (mult (succ n) m))
    case neg m => pos (succ (plus (plus (mult n m) n) m))
  }
}

fun intLeq(a: Int, b: Int): Bool = match a {
  case pos n => match b {
    case pos m => leq n m
    case neg _ => false_
  }
  case neg n => match b {
    case pos _ => true_
    case neg m => leq m n
  }
}

fun intAbs(a: Int): Nat = match a {
  case pos n => n
  case neg n => succ n
}

fun intSign(a: Int): Bool = match a {
  case pos _ => true_
  case neg _ => false_
}
// --- Integer division and modulo (Euclidean) ------------------------------
//
// For a divisor b with b != 0, `intDiv a b` and `intMod a b` satisfy
// `a = b * q + r` and `0 <= r < |b|`. For b = 0, `intDiv a 0 = pos zero`
// and `intMod a 0 = a`, matching the Nat conventions. The definitions
// reduce to Nat.div and Nat.mod on the magnitudes and adjust the quotient
// when the remainder is nonzero.

fun intDivNegQ(u: Nat, v: Nat): Nat = match v {
  case zero => u
  case succ _ => succ u
}

fun intModNegR(B: Nat, v: Nat): Nat = match v {
  case zero => zero
  case succ _ => sub B v
}

fun intDiv(a: Int, b: Int): Int = match b {
  case pos m => match m {
    case zero => pos zero
    case succ m_ => match a {
      case pos n => pos (div n (succ m_))
      case neg n => intNeg (pos (intDivNegQ (div (succ n) (succ m_)) (mod (succ n) (succ m_))))
    }
  }
  case neg m => match a {
    case pos n => intNeg (pos (div n (succ m)))
    case neg n => pos (intDivNegQ (div (succ n) (succ m)) (mod (succ n) (succ m)))
  }
}

fun intMod(a: Int, b: Int): Int = match b {
  case pos m => match m {
    case zero => a
    case succ m_ => match a {
      case pos n => pos (mod n (succ m_))
      case neg n => pos (intModNegR (succ m_) (mod (succ n) (succ m_)))
    }
  }
  case neg m => match a {
    case pos n => pos (mod n (succ m))
    case neg n => pos (intModNegR (succ m) (mod (succ n) (succ m)))
  }
}
// --- Lemmas ---
// intPlus_comm: a + b = b + a

val intPlus_comm: (a: Int) -> (b: Int) -> Eq Int (intPlus a b) (intPlus b a) =
  Int.ind
    ((x: Int) => (y: Int) -> Eq Int (intPlus x y) (intPlus y x))
    ((n: Nat) => (y: Int) => Int.ind
      ((z: Int) => Eq Int (intPlus (pos n) z) (intPlus z (pos n)))
      ((m: Nat) => cong_e Nat Int ((k: Nat) => pos k) (plus n m) (plus m n) (plus_comm n m))
      ((m: Nat) => refl (intPlusHelp n m))
      y)
    ((n: Nat) => (y: Int) => Int.ind
      ((z: Int) => Eq Int (intPlus (neg n) z) (intPlus z (neg n)))
      ((m: Nat) => refl (intPlusHelp m n))
      ((m: Nat) => cong_e Nat Int ((k: Nat) => neg (succ k)) (plus n m) (plus m n) (plus_comm n m))
      y)
// intNeg_neg: neg (neg a) = a

val intNeg_neg: (a: Int) -> Eq Int (intNeg (intNeg a)) a =
  Int.ind
    ((x: Int) => Eq Int (intNeg (intNeg x)) x)
    ((n: Nat) => Nat.ind
      ((k: Nat) => Eq Int (intNeg (intNeg (pos k))) (pos k))
      (refl (pos zero))
      ((k: Nat) => (_: Eq Int (intNeg (intNeg (pos k))) (pos k)) => refl (pos (succ k)))
      n)
    ((n: Nat) => refl (neg n))
// intSign_pos: sign of positive is true

fun intSign_pos(n: Nat): Eq Bool (intSign (pos n)) true_ = refl true_
// intSign_neg: sign of negative is false

fun intSign_neg(n: Nat): Eq Bool (intSign (neg n)) false_ = refl false_
// intAbs_pos: abs of positive is n

fun intAbs_pos(n: Nat): Eq Nat (intAbs (pos n)) n = refl n
// intAbs_neg: abs of negative is succ n

fun intAbs_neg(n: Nat): Eq Nat (intAbs (neg n)) (succ n) = refl (succ n)

val intNeg_pos_zero: Eq Int (intNeg (pos zero)) (pos zero) = refl (pos zero)

val intMult_neg_intNeg: (m: Nat)
-> (u: Nat) -> Eq Int (intMult (neg m) (intNeg (pos u))) (pos (mult (succ m) u)) =
  (m: Nat) => (u: Nat) => Nat.ind
    ((k: Nat) => Eq Int (intMult (neg m) (intNeg (pos k))) (pos (mult (succ m) k)))
    (trans_e
      Int
      (intNeg (pos (mult (succ m) zero)))
      (intNeg (pos zero))
      (pos (mult (succ m) zero))
      (cong_e Nat Int ((t: Nat) => intNeg (pos t)) (mult (succ m) zero) zero (mult_zero (succ m)))
      (trans_e
        Int
        (intNeg (pos zero))
        (pos zero)
        (pos (mult (succ m) zero))
        intNeg_pos_zero
        (sym_e
          Int
          (pos (mult (succ m) zero))
          (pos zero)
          (cong_e Nat Int ((t: Nat) => pos t) (mult (succ m) zero) zero (mult_zero (succ m))))))
    ((k: Nat) => (ih: Eq Int (intMult (neg m) (intNeg (pos k))) (pos (mult (succ m) k))) => {
      val a: Nat = plus (mult m k) m;
      val l: Nat = succ (plus a k);
      val t1: Nat = plus a (succ k);
      val t2: Nat = plus (mult m k) (plus m (succ k));
      val t3: Nat = plus (plus m (succ k)) (mult m k);
      val t4: Nat = plus (plus (succ k) m) (mult m k);
      val t5: Nat = plus (succ k) (plus m (mult m k));
      val e1: Eq Nat l t1 = sym_e Nat t1 l (plus_succ a k);
      val e2: Eq Nat t1 t2 = plus_assoc (mult m k) m (succ k);
      val e3: Eq Nat t2 t3 = plus_comm (mult m k) (plus m (succ k));
      val e4: Eq Nat t3 t4 = cong_e
        Nat
        Nat
        ((t: Nat) => plus t (mult m k))
        (plus m (succ k))
        (plus (succ k) m)
        (plus_comm m (succ k));
      val e5: Eq Nat t4 t5 = plus_assoc (succ k) m (mult m k);
      val e6: Eq Nat t5 (mult (succ m) (succ k)) = sym_e
        Nat
        (mult (succ m) (succ k))
        t5
        (cong_e
          Nat
          Nat
          ((t: Nat) => plus (succ k) t)
          (mult m (succ k))
          (plus m (mult m k))
          (mult_succ_right m k));
      val p: Eq Nat l (mult (succ m) (succ k)) = trans_e
        Nat
        l
        t1
        (mult (succ m) (succ k))
        e1
        (trans_e
          Nat
          t1
          t2
          (mult (succ m) (succ k))
          e2
          (trans_e
            Nat
            t2
            t3
            (mult (succ m) (succ k))
            e3
            (trans_e
              Nat
              t3
              t4
              (mult (succ m) (succ k))
              e4
              (trans_e Nat t4 t5 (mult (succ m) (succ k)) e5 e6))));
      cong_e Nat Int ((t: Nat) => pos t) l (mult (succ m) (succ k)) p
      })
    u

val intDivMod_pos_pos: (n: Nat)
-> (m: Nat)
  -> Eq
      Int
      (intPlus
        (intMult (pos (succ m)) (intDiv (pos n) (pos (succ m))))
        (intMod (pos n) (pos (succ m))))
      (pos n) =
  (n: Nat) => (m: Nat) => cong_e
    Nat
    Int
    ((k: Nat) => pos k)
    (plus (mult (succ m) (div n (succ m))) (mod n (succ m)))
    n
    (trans_e
      Nat
      (plus (mult (succ m) (div n (succ m))) (mod n (succ m)))
      (plus (mult (div n (succ m)) (succ m)) (mod n (succ m)))
      n
      (cong_e
        Nat
        Nat
        ((t: Nat) => plus t (mod n (succ m)))
        (mult (succ m) (div n (succ m)))
        (mult (div n (succ m)) (succ m))
        (mult_comm (succ m) (div n (succ m))))
      (div_add_mod n (succ m) (lt_zero_succ m)))

val intDivMod_pos_neg: (n: Nat)
-> (m: Nat)
  -> Eq Int (intPlus (intMult (neg m) (intDiv (pos n) (neg m))) (intMod (pos n) (neg m))) (pos n) =
  (n: Nat) => (m: Nat) => {
    val B: Nat = succ m;
    val u: Nat = div n B;
    val v: Nat = mod n B;
    val e1: Eq Int (intMult (neg m) (intDiv (pos n) (neg m))) (pos (mult B u)) = intMult_neg_intNeg
      m
      u;
    val chain: Eq Nat (plus (mult B u) v) n = trans_e
      Nat
      (plus (mult B u) v)
      (plus (mult u B) v)
      n
      (cong_e Nat Nat ((t: Nat) => plus t v) (mult B u) (mult u B) (mult_comm B u))
      (div_add_mod n B (lt_zero_succ m));
    val e2: Eq Int (intPlus (pos (mult B u)) (intMod (pos n) (neg m))) (pos n) = cong_e
      Nat
      Int
      ((k: Nat) => pos k)
      (plus (mult B u) v)
      n
      chain;
    trans_e
      Int
      (intPlus (intMult (neg m) (intDiv (pos n) (neg m))) (intMod (pos n) (neg m)))
      (intPlus (pos (mult B u)) (intMod (pos n) (neg m)))
      (pos n)
      (cong_e
        Int
        Int
        ((t: Int) => intPlus t (intMod (pos n) (neg m)))
        (intMult (neg m) (intDiv (pos n) (neg m)))
        (pos (mult B u))
        e1)
      e2
    }

val intDivMod_pos: (n: Nat)
-> (b: Int) -> Eq Int (intPlus (intMult b (intDiv (pos n) b)) (intMod (pos n) b)) (pos n) =
  (n: Nat) => (b: Int) => Int.ind
    ((y: Int) => Eq Int (intPlus (intMult y (intDiv (pos n) y)) (intMod (pos n) y)) (pos n))
    ((m: Nat) => Nat.ind
      ((k: Nat) => Eq
        Int
        (intPlus (intMult (pos k) (intDiv (pos n) (pos k))) (intMod (pos n) (pos k)))
        (pos n))
      (refl (pos n))
      ((k: Nat) => (ih: Eq
        Int
        (intPlus (intMult (pos k) (intDiv (pos n) (pos k))) (intMod (pos n) (pos k)))
        (pos n)) => intDivMod_pos_pos n k)
      m)
    ((m: Nat) => intDivMod_pos_neg n m)
    b
